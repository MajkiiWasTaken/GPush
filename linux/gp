                dim '  CHECK upstream'
            elif (( ahead && behind )); then
                dim '  SKIP diverged'
            elif (( ahead )); then
                dim '  PUSH candidate (subject to protection)'
            elif (( behind )); then
                dim '  FAST-FORWARD candidate'
