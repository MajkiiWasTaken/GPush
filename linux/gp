version_numeric() { local v="${1#v}"; printf '%s' "${v%%-*}"; }
version_gt() { local a b; a="$(version_numeric "$1")"; b="$(version_numeric "$2")"; [[ "$a" == "$b" ]] && return 1; [[ "$(printf '%s\n%s\n' "$a" "$b" | sort -V | tail -n1)" == "$a" ]]; }
latest_release_json() { command -v curl >/dev/null 2>&1 || { err 'curl is required for GPush update.'; return 1; }; curl -fsSL -H "User-Agent: GPush/$SCRIPT_VERSION" -H 'Accept: application/vnd.github+json' 'https://api.github.com/repos/MajkiiWasTaken/GPush/releases/latest'; }
release_field() {
    local json_file="$1" key="$2" extra="${3:-}"
    command -v python3 >/dev/null 2>&1 || { err 'python3 is required to parse GitHub release metadata.'; return 1; }
    python3 - "$json_file" "$key" "$extra" <<'PY_RELEASE'
import json,sys
with open(sys.argv[1],encoding='utf-8') as f: d=json.load(f)
if sys.argv[2]=='tag': print(d.get('tag_name',''))
elif sys.argv[2]=='linux_asset':
    assets=d.get('assets',[])
    cand=[a for a in assets if 'linux' in a.get('name','').lower() and a.get('name','').lower().endswith(('.tar.gz','.zip'))]
    if cand: print(cand[0].get('name','')+'|'+cand[0].get('browser_download_url',''))
elif sys.argv[2]=='checksum':
    assets=d.get('assets',[])
    package=sys.argv[3] if len(sys.argv) > 3 else ''
    wanted=[package+'.sha256', package+'.sha256.txt', 'SHA256SUMS', 'SHA256SUMS.txt', 'sha256sums.txt']
    for wanted_name in wanted:
        for a in assets:
            if a.get('name','').lower()==wanted_name.lower():
                print(a.get('name','')+'|'+a.get('browser_download_url',''))
                raise SystemExit(0)
PY_RELEASE
}
backup_current_gp() {
    mkdir -p "$BACKUP_DIR"
    local current_path backup_path; current_path="$(command -v gp 2>/dev/null || true)"; [[ -n "$current_path" ]] || current_path="${BASH_SOURCE[0]}"
    backup_path="$BACKUP_DIR/v$SCRIPT_VERSION-$(date +%Y%m%d-%H%M%S)"; mkdir -p "$backup_path"; cp "$current_path" "$backup_path/gp"; chmod +x "$backup_path/gp"; printf '%s' "$backup_path"
}
handle_update() {
    if (( $# > 1 )); then err "Update accepts at most one action."; return 2; fi
    local action="${1:-install}"; case "$action" in check|install|rollback) ;; *) err "Unknown update action: $action"; dim 'Use: gp update [check|install|rollback]'; return 2;; esac
    banner
    if [[ "$action" == rollback ]]; then
        local newest current_path; newest="$(find "$BACKUP_DIR" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort -r | head -n1 || true)"; [[ -n "$newest" && -f "$newest/gp" ]] || { warn 'No GPush backup exists.'; return 0; }
        current_path="$(command -v gp 2>/dev/null || true)"; [[ -n "$current_path" ]] || current_path="$HOME/.local/bin/gp"; section 'GPush Rollback'; kv Current "$SCRIPT_VERSION"; kv Backup "$newest" "$C_GRAY"; confirm 'Restore newest GPush backup?' || return 0; install -m 0755 "$newest/gp" "$current_path" || return 1; ok 'Rollback completed.'; dim 'Run a new gp command to use the restored version.'; return 0
    fi
    local tmp json tag asset name url; tmp="$(mktemp -d)" || return 1; json="$tmp/release.json"; latest_release_json > "$json" || { rm -rf "$tmp"; return 1; }; tag="$(release_field "$json" tag)"; [[ -n "$tag" ]] || { err 'Could not read latest release version.'; rm -rf "$tmp"; return 1; }
    section 'GPush Update'; kv Installed "$SCRIPT_VERSION"; kv Latest "$tag"; kv Channel stable
    if ! version_gt "$tag" "$SCRIPT_VERSION"; then ok 'GPush is up to date.'; rm -rf "$tmp"; return 0; fi
    warn "Update available: $SCRIPT_VERSION -> $tag"; if [[ "$action" == check && "${WORKSPACE_OFFER_UPDATE:-false}" != true ]]; then dim "Run 'gp update' to install."; rm -rf "$tmp"; return 0; fi
    asset="$(release_field "$json" linux_asset)"; [[ -n "$asset" ]] || { err 'Latest release has no Linux package asset.'; rm -rf "$tmp"; return 1; }; name="${asset%%|*}"; url="${asset#*|}"; if [[ "$action" == check ]]; then confirm "Download and install $tag?" || { rm -rf "$tmp"; return 0; }; else confirm_default_yes "Download and install $tag?" || { rm -rf "$tmp"; return 0; }; fi
    visual_bar 0 4; printf ' Downloading\n'; info "[UPDATE] Downloading $name"; curl -fL -H "User-Agent: GPush/$SCRIPT_VERSION" "$url" -o "$tmp/$name" || { rm -rf "$tmp"; return 1; }
    visual_bar 1 4; printf ' Downloaded\n'
    local checksum checksum_url expected actual
    checksum="$(release_field "$json" checksum "$name" || true)"
    if [[ -n "$checksum" ]]; then
        checksum_url="${checksum#*|}"
        if curl -fsSL -H "User-Agent: GPush/$SCRIPT_VERSION" "$checksum_url" -o "$tmp/checksum.txt"; then
            expected="$(grep -F "$name" "$tmp/checksum.txt" 2>/dev/null | grep -Eo '[A-Fa-f0-9]{64}' | head -n1 || true)"
            if [[ -z "$expected" && ( "${checksum%%|*}" == "$name.sha256" || "${checksum%%|*}" == "$name.sha256.txt" ) ]]; then
                expected="$(grep -Eo '[A-Fa-f0-9]{64}' "$tmp/checksum.txt" | head -n1 || true)"
            fi
            if [[ -n "$expected" ]]; then
