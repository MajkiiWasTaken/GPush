        [[ -t 0 && -t 1 ]] || return 0
        dim '[C] Commit  [D] Diff  [B] Branches  [F] Fetch  [S] Sync  [G] GitHub  [Q/Esc] Back'
        workspace_key; action=$WORKSPACE_KEY
        case "${action,,}" in
            c) workspace_commit "$path"; workspace_pause;;
            d) workspace_diff "$path";;
            b) workspace_branches "$path";;
            f) overview_fetch "$path" && workspace_log fetch "$path"; workspace_pause;;
            s) if confirm 'Synchronize repository?'; then bulk_sync "$path" false '' && workspace_log sync "$path"; fi; workspace_pause;;
            g) workspace_github "$path"; workspace_pause;;
            q|esc) return 0;;
        esac
    done
}
workspace_settings() {
