        if (( selected >= ${#visible[@]} )); then
            selected=0
        fi
        height=$(tput lines 2>/dev/null || printf 24)
        width=$(tput cols 2>/dev/null || printf 80)
        [[ "$height" =~ ^[0-9]+$ ]] || height=24
        [[ "$width" =~ ^[0-9]+$ ]] || width=80
        width=$((width>110?110:width-1))
        ((width>=1)) || width=1
        content_width=$((width>6?width-4:1))
        repo_column=0
        if [[ "$title" == 'Select repository' || "$title" == Settings ]]; then
            for line in "${rows[@]}"; do
                repo_name=${line%%  |  *}
                if (( ${#repo_name} > repo_column )); then
                    repo_column=${#repo_name}
                fi
            done
            left_width=$((content_width*35/100))
            (( left_width >= 10 )) || left_width=10
            (( repo_column >= 10 )) || repo_column=10
            if (( repo_column > left_width )); then
                repo_column=$left_width
            fi
        fi
        reserved_rows=10
        if [[ "$multiple" == true ]]; then
            reserved_rows=$((reserved_rows+1))
        fi
        show_logo=false
        if [[ "$title" == *' / Main menu' ]] && ((width>=48 && height>=reserved_rows+8+${#rows[@]})); then
            show_logo=true
            reserved_rows=$((reserved_rows+8))
        fi
        limit=$((height-reserved_rows))
        ((limit>=1)) || limit=1
