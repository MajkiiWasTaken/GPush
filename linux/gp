workspace_log() { mkdir -p "$CONFIG_DIR"; printf '%s %s %s\n' "$(date -Iseconds)" "$1" "$2" >> "$CONFIG_DIR/history.log"; }
# Shared keyboard picker: navigation uses only the supplied in-memory rows.
workspace_key() {
    local suffix='' next='' terminal_mode answer=''
    terminal_mode=$(stty -g) || { WORKSPACE_KEY=esc; return; }
    stty intr undef
    if ! IFS= read -rsn1 WORKSPACE_KEY; then stty "$terminal_mode"; WORKSPACE_KEY=esc; return; fi
    if [[ "$WORKSPACE_KEY" == $'\003' ]]; then
        printf '\n'; warn 'Exit GPush? [Y/Enter/Ctrl+C] Yes  [N/Esc] Cancel'
        if IFS= read -rsn1 answer; then
            stty "$terminal_mode"
            case "$answer" in y|Y|''|$'\003') if [[ "$BASHPID" != "$$" ]]; then kill -TERM "$$"; fi; exit 130;; esac
        else
            stty "$terminal_mode"
        fi
        WORKSPACE_KEY=ignored; return
    fi
    stty "$terminal_mode"
    if [[ "$WORKSPACE_KEY" == $'\033' ]]; then
        IFS= read -rsn1 -t 0.15 suffix || true
        if [[ "$suffix" == '[' || "$suffix" == O ]]; then
            while IFS= read -rsn1 -t 0.15 next; do
                suffix+=$next
                [[ "$next" == [@-~] ]] && break
            done
        fi
        case "$suffix" in '['*A|OA) WORKSPACE_KEY=up;; '['*B|OB) WORKSPACE_KEY=down;; '') WORKSPACE_KEY=esc;; *) WORKSPACE_KEY=ignored;; esac
    elif [[ -z "$WORKSPACE_KEY" ]]; then WORKSPACE_KEY=enter; fi
}
