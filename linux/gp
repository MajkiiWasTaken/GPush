                dim '  No action'
            fi
        fi
        if [[ "$state" == 'Up to date' && "$dirty" == 0 ]]; then
            clean=$((clean+1))
        fi
        : "$path"
    done
    if [[ "$filter" == overview || "$filter" == health ]]; then
        printf '\nClean and synchronized: '
        visual_bar "$clean" "${#CACHED_REPOS[@]}"
        printf '\n'
    fi
}
# Overview uses Bash's dynamically scoped local arrays owned by visual_command.
overview_fetch() {
    local path="$1" remote
    remote=$(git -C "$path" config --get "branch.$(git -C "$path" symbolic-ref --quiet --short HEAD 2>/dev/null).remote" 2>/dev/null || (cd "$path" && current_remote)) || {
        warn "No remote: $path"
        return 1
    }
    [[ -n "$remote" && "$remote" != . ]] || {
        warn "No supported remote: $path"
        return 1
    }
    git -C "$path" fetch --prune "$remote" >/dev/null || return 1
