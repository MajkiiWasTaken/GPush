        workspace_block_bar 0 24; printf '    0%%'
    fi
    for ((i=0;i<total;i+=4)); do
        jobs=()
        for ((j=i;j<total && j<i+4;j++)); do
            (
                if [[ "$fetch" == true ]] && ! overview_fetch "${overview_paths[j]}" true > /dev/null 2>&1; then
                    printf '%s\0' "${overview_paths[j]##*/}" - - - - - 'Fetch failed' "${overview_paths[j]}"
                else
