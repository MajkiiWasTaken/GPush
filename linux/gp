    backup_path="$(backup_current_gp)" || { rm -rf "$tmp"; return 1; }; dim "Backup: $backup_path"; current_path="$(command -v gp 2>/dev/null || true)"; [[ -n "$current_path" ]] || current_path="$HOME/.local/bin/gp"; mkdir -p "$(dirname "$current_path")"; install -m 0755 "$new_gp" "$current_path" || { rm -rf "$tmp"; return 1; }; ok 'GPush updated successfully.'; kv Previous "$SCRIPT_VERSION"; kv Current "$package_version" "$C_GREEN"; rm -rf "$tmp"
}
levenshtein() {
    local a="${1,,}" b="${2,,}"
    local alen=${#a} blen=${#b}
    local -a prev=() curr=()
    local i j cost del ins rep

    for ((j=0; j<=blen; j++)); do prev[j]=$j; done

    for ((i=1; i<=alen; i++)); do
        curr[0]=$i
        for ((j=1; j<=blen; j++)); do
            if [[ "${a:i-1:1}" == "${b:j-1:1}" ]]; then cost=0; else cost=1; fi
            del=$(( prev[j] + 1 ))
            ins=$(( curr[j-1] + 1 ))
            rep=$(( prev[j-1] + cost ))
            (( del < ins )) && curr[j]=$del || curr[j]=$ins
            (( rep < curr[j] )) && curr[j]=$rep
        done
        prev=("${curr[@]}")
    done

    printf '%s' "${prev[blen]}"
}

command_suggestion() {
    local value="${1,,}"
    case "$value" in
        tags) printf '%s' 'gp tag list [project]'; return 0 ;;
        branches) printf '%s' 'gp branch list [project]'; return 0 ;;
        remotes) printf '%s' 'gp remote list [project]'; return 0 ;;
        aliases) printf '%s' 'gp alias list'; return 0 ;;
        completition|competion) printf '%s' 'gp completion install'; return 0 ;;
    esac

    local -a commands=(repo branch tag remote stash cache config alias favorite favorites fav all project clone recent update completion help version add remove set reset)
    local best='' best_distance=999 distance candidate max_distance
    for candidate in "${commands[@]}"; do
        distance="$(levenshtein "$value" "$candidate")"
        if (( distance < best_distance )); then best_distance=$distance; best="$candidate"; fi
    done

    if (( ${#value} <= 4 )); then max_distance=1; else max_distance=2; fi
    (( best_distance <= max_distance )) || return 1

    if [[ "$best" == completion ]]; then printf '%s' 'gp completion install'; else printf 'gp %s ...' "$best"; fi
}

known_repository_token() {
    local query resolved repository name alias_name alias_path
    query="$1"
    resolved="$(alias_resolve "$query")"

    if [[ -d "$resolved" && -e "$resolved/.git" ]]; then return 0; fi

    if [[ -f "$ALIASES_FILE" ]]; then
        while IFS='|' read -r alias_name alias_path; do
            [[ "${alias_name,,}" == "${query,,}" ]] && return 0
        done < "$ALIASES_FILE"
    fi

    load_cache
    if [[ ${#CACHED_REPOS[@]} -eq 0 ]]; then
        scan_repos
