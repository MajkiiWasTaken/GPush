# Shared keyboard picker: navigation uses only the supplied in-memory rows.
workspace_key() {
    local suffix='' next_key='' terminal_mode answer=''
    terminal_mode=$(stty -g) || {
        WORKSPACE_KEY=esc
        return
    }
    stty intr undef
    if [[ ${1:-} == resize ]]; then
        if ! IFS= read -rsn1 -t 0.25 WORKSPACE_KEY; then
            stty "$terminal_mode"
            WORKSPACE_KEY=ignored
            return
        fi
    elif ! IFS= read -rsn1 WORKSPACE_KEY; then
        stty "$terminal_mode"
        WORKSPACE_KEY=esc
        return
    fi
    if [[ "$WORKSPACE_KEY" == $'\003' ]]; then
        printf '\n'; warn 'Exit GPush?'
        printf '%s[Y, Enter, Ctrl+C] - Yes%s    |   %s[N, ESC] - No%s\n' "$C_GREEN" "$C_RESET" "$C_RED" "$C_RESET"
        while IFS= read -rsn1 answer; do
            case "$answer" in
                y|Y|''|$'\003') stty "$terminal_mode"
                if [[ "$BASHPID" != "$$" ]]; then
                    kill -TERM "$$"
                fi
                exit 130
                ;;
                n|N|$'\033') break;;
            esac
        done
        stty "$terminal_mode"
        WORKSPACE_KEY=redraw; return
    fi
    stty "$terminal_mode"
    if [[ "$WORKSPACE_KEY" == $'\033' ]]; then
        IFS= read -rsn1 -t 0.15 suffix || true
        if [[ "$suffix" == '[' || "$suffix" == O ]]; then
            while IFS= read -rsn1 -t 0.15 next_key; do
                suffix+=$next_key
                [[ "$next_key" == [@-~] ]] && break
            done
        fi
        case "$suffix" in
            '['*A|OA)
                WORKSPACE_KEY=up
            ;;
            '['*B|OB)
                WORKSPACE_KEY=down
            ;;
            '['*C|OC)
                WORKSPACE_KEY=right
            ;;
            '['*D|OD)
                WORKSPACE_KEY=left
            ;;
            '')
                WORKSPACE_KEY=esc
            ;;
            *)
                WORKSPACE_KEY=ignored
            ;;
        esac
    elif [[ -z "$WORKSPACE_KEY" ]]; then
        WORKSPACE_KEY=enter
    fi
}
workspace_pick() {
    local title="$1" multiple="$2"; shift 2
    local -a rows=("$@") marks=()
    local selected=0 i start limit query='' key height width line desc bar content_width left_width screen_title reserved_rows show_logo previous_width=0 previous_height=0
    local accent='' highlight='' muted="$C_GRAY" first_frame=true marked=0 repo_column=0 repo_name repo_path
    local -a visible=() descriptions=(
        'Browse cached repository status' 'Commit, push and manage projects' 'Sync or fetch multiple repositories'
        'Find, add and refresh projects' 'Commits and development activity' 'Inspect synchronization health'
        'Review recent GPush operations' 'Configure remotes and safety rules' 'Check, install or roll back updates'
        'View classic command syntax' 'Return to your terminal'
