for i in range(0,len(a),8):
 r=dict(zip(keys,[v.decode("utf-8",errors="replace") for v in a[i:i+8]]));
 for k in ("behind","ahead","dirtyCount"): r[k]=int(r[k]) if r[k].isdigit() else None
