normalize_config_key() {
    case "${1,,}" in
        search-root|search-roots) printf '%s' 'search-root'
        ;;
        protected-branch|protected-branches) printf '%s' 'protected-branch'
        ;;
        ignored-directory|ignored-directories|ignore-directory|ignore) printf '%s' 'ignored-directory'
        ;;
        default-remote|remote) printf '%s' 'default-remote'
        ;;
        large-file-threshold|large-file-mb|large-file) printf '%s' 'large-file-threshold'
        ;;
        *) return 1 ;;
    esac
}

config_edit_usage() {
    dim 'Use:'
    dim '  gp add <key> <value>'
    dim '  gp remove <search-root|protected-branch|ignored-directory> <value>'
    dim '  gp set <default-remote|large-file-threshold> <value>'
    dim '  gp reset <key>'
    dim '  Keys: search-root, protected-branch, ignored-directory, default-remote, large-file-threshold'
    dim '  Full form: gp config add|remove|set|reset ...'
}

config_path_equal() {
    local left="${1/#\~/$HOME}"
    local right="${2/#\~/$HOME}"
    left="${left%/}"
    right="${right%/}"
    [[ "${left,,}" == "${right,,}" ]]
}

array_contains_ci() {
    local wanted="${1,,}"
    shift || true
    local item
    for item in "$@"; do
        [[ "${item,,}" == "$wanted" ]] && return 0
    done
    return 1
}

save_config_settings() {
    ensure_dirs
    local tmp="$CONFIG_FILE.tmp"
    : > "$tmp" || return 1

    printf '# GPush 4.x Linux configuration\n' >> "$tmp"
    printf '# This file is managed by gp config add/remove/set/reset.\n\n' >> "$tmp"

    local item
    for item in "${SEARCH_ROOTS[@]}"; do
        printf 'search_root=%s\n' "$item" >> "$tmp"
    done
    for item in "${PROTECTED_BRANCHES[@]}"; do
        printf 'protected_branch=%s\n' "$item" >> "$tmp"
    done
    for item in "${IGNORED_DIRS[@]}"; do
        printf 'ignored_directory=%s\n' "$item" >> "$tmp"
    done

    printf 'default_remote=%s\n' "$DEFAULT_REMOTE" >> "$tmp"
    printf 'large_file_mb=%s\n' "$LARGE_FILE_MB" >> "$tmp"
    mv "$tmp" "$CONFIG_FILE"
}

handle_config_edit() {
    local action="${1,,}"
    local raw_key="${2:-}"
    local value="${3:-}"
    local key

    key="$(normalize_config_key "$raw_key" 2>/dev/null || true)"
    if [[ -z "$key" ]]; then
        err "Unknown configuration key: $raw_key"
        config_edit_usage
        return 2
    fi

    case "$action" in
        add)
            [[ -n "$value" ]] || {
                err "Configuration 'add' requires a value."
                return 2
            }
            if [[ "$key" == default-remote || "$key" == large-file-threshold ]]; then
                action="set"
            fi
            ;;
        remove)
            case "$key" in
                search-root|protected-branch|ignored-directory)
                ;;
                *)
                    err "Configuration key '$key' cannot remove an individual value."
                    dim "Use: gp reset $key"
                    return 2
                ;;
            esac
            [[ -n "$value" ]] || {
                err "Configuration 'remove' requires a value."
                return 2
            }
            ;;
        set)
            case "$key" in
                default-remote|large-file-threshold)
                ;;
                *)
                    err "Configuration key '$key' does not support 'set'."
                    dim "Use add/remove for list settings."
                    return 2
                ;;
            esac
            [[ -n "$value" ]] || {
                err "Configuration 'set' requires a value."
                return 2
            }
            ;;
        reset) ;;
        *) err "Unknown config action: $action"
        config_edit_usage
        return 2
        ;;
    esac

    local -a next=()
    local item found=false

    case "$key" in
        search-root)
            case "$action" in
                add)
                    for item in "${SEARCH_ROOTS[@]}"; do
                        config_path_equal "$item" "$value" && {
                            warn "Search root is already configured: $value"
                            return 0
                        }
                    done
                    SEARCH_ROOTS+=("${value/#\~/$HOME}")
                    ;;
                remove)
                    for item in "${SEARCH_ROOTS[@]}"; do
                        if config_path_equal "$item" "$value"; then
                            found=true
                        else
                            next+=("$item")
                        fi
                    done
                    [[ "$found" == true ]] || {
                        err "Search root was not found: $value"
                        return 1
                    }
                    (( ${#next[@]} > 0 )) || {
                        err 'Cannot remove the last search root.'
                        dim 'Add another search root first.'
                        return 2
                    }
                    SEARCH_ROOTS=("${next[@]}")
                    ;;
                reset) SEARCH_ROOTS=("${DEFAULT_SEARCH_ROOTS[@]}")
                ;;
            esac
            ;;
        protected-branch)
            case "$action" in
                add)
                    array_contains_ci "$value" "${PROTECTED_BRANCHES[@]}" && {
                        warn "Protected branch is already configured: $value"
                        return 0
                    }
                    PROTECTED_BRANCHES+=("$value")
                    ;;
                remove)
                    next=(); found=false
                    for item in "${PROTECTED_BRANCHES[@]}"; do
                        if [[ "${item,,}" == "${value,,}" ]]; then
                            found=true
                        else
                            next+=("$item")
                        fi
                    done
                    [[ "$found" == true ]] || {
                        err "Protected branch was not found: $value"
                        return 1
                    }
                    PROTECTED_BRANCHES=("${next[@]}")
                    ;;
                reset) PROTECTED_BRANCHES=("${DEFAULT_PROTECTED_BRANCHES[@]}")
                ;;
            esac
            ;;
        ignored-directory)
            case "$action" in
                add)
                    array_contains_ci "$value" "${IGNORED_DIRS[@]}" && {
                        warn "Ignored directory is already configured: $value"
                        return 0
                    }
                    IGNORED_DIRS+=("$value")
                    ;;
                remove)
                    next=(); found=false
                    for item in "${IGNORED_DIRS[@]}"; do
                        if [[ "${item,,}" == "${value,,}" ]]; then
                            found=true
                        else
                            next+=("$item")
                        fi
                    done
                    [[ "$found" == true ]] || {
                        err "Ignored directory was not found: $value"
                        return 1
                    }
                    IGNORED_DIRS=("${next[@]}")
                    ;;
                reset) IGNORED_DIRS=("${DEFAULT_IGNORED_DIRS[@]}")
                ;;
            esac
            ;;
        default-remote)
            if [[ "$action" == set ]]; then
                [[ "$value" != *[[:space:]]* ]] || {
                    err 'Remote name cannot contain whitespace.'
                    return 2
                }
                DEFAULT_REMOTE="$value"
            else
                DEFAULT_REMOTE='origin'
            fi
            ;;
        large-file-threshold)
            if [[ "$action" == set ]]; then
                if ! [[ "$value" =~ ^[0-9]+$ ]] || (( value <= 0 )); then
                    err 'Large-file threshold must be a positive integer in MB.'
                    return 2
                fi
                LARGE_FILE_MB="$value"
            else
                LARGE_FILE_MB="$DEFAULT_LARGE_FILE_MB"
            fi
            ;;
    esac

    save_config_settings || return 1
    load_config

    banner
    section 'Configuration updated'
    kv Action "$action"
    kv Key "$key"
    [[ -n "$value" && "$action" != reset ]] && kv Value "$value"
    kv Config "$CONFIG_FILE" "$C_GRAY"
}

show_config() {
    banner
    section "Configuration"
    kv Path "$CONFIG_FILE" "$C_GRAY"
    kv Remote "$DEFAULT_REMOTE"
    kv "Large files" "$LARGE_FILE_MB MB"
    section "Search roots"
    printf '  %s\n' "${SEARCH_ROOTS[@]}"
    section "Protected branches"
    printf '  %s\n' "${PROTECTED_BRANCHES[@]}"
    section "Ignored directories"
    printf '  %s\n' "${IGNORED_DIRS[@]}"
}

run_doctor() {
    banner
    section "Doctor"

    if command -v git >/dev/null 2>&1; then
        ok "  [OK] Git"
    else
        err "  [FAIL] Git"
    fi

    if [[ -d "$CONFIG_DIR" ]]; then
        ok "  [OK] Config directory"
    else
        warn "  [WARN] Config directory"
    fi

    local existing_roots=0
    local root

    for root in "${SEARCH_ROOTS[@]}"; do
        if [[ -d "$root" ]]; then
            ((existing_roots += 1))
        fi
    done

    if [[ $existing_roots -gt 0 ]]; then
        ok "  [OK] Search roots: $existing_roots"
    else
        err "  [FAIL] No search roots exist"
    fi
}

handle_config() {
    local action="${1:-show}"
    shift || true

    case "$action" in
        show)
            [[ $# -eq 0 ]] || {
                err "Command 'gp config show' does not accept arguments."
                return 2
            }
            show_config
            ;;
        path)
            [[ $# -eq 0 ]] || {
                err "Command 'gp config path' does not accept arguments."
                return 2
            }
            printf '%s\n' "$CONFIG_FILE"
            ;;
        doctor)
            [[ $# -eq 0 ]] || {
                err "Command 'gp config doctor' does not accept arguments."
                return 2
            }
            run_doctor
            ;;
        add|remove|set)
            [[ $# -eq 2 ]] || {
                err "Command 'gp config $action' requires a key and a value."
                config_edit_usage
                return 2
            }
            handle_config_edit "$action" "$1" "$2"
            ;;
        reset)
            [[ $# -eq 1 ]] || {
                err "Command 'gp config reset' requires exactly one key."
                config_edit_usage
                return 2
            }
            handle_config_edit reset "$1"
            ;;
        *)
            err "Unknown config command: $action"
            dim 'Use: gp config show|path|doctor|add|remove|set|reset ...'
            return 2
            ;;
    esac
}


handle_cache() {
    local action="${1:-list}"
    shift || true

    case "$action" in
        list)
            get_repos
            banner
            section "Repositories"

            local repository
            for repository in "${REPOS[@]}"; do
                printf '  %-28s %s%s%s\n' \
                    "$(repo_name "$repository")" \
                    "$C_GRAY" "$repository" "$C_RESET"
            done
            ;;
        refresh)
            scan_repos
            save_cache "${FOUND_REPOS[@]}"
            ok "Found ${#FOUND_REPOS[@]} repositories."
            ;;
        add)
            add_cache "${1:-.}"
            ;;
        *)
            err "Unknown cache command: $action"
            return 2
            ;;
    esac
}

handle_recent() {
    banner
    section "Recent repositories"

    if [[ -f "$RECENT_FILE" ]]; then
        cut -d'|' -f2- "$RECENT_FILE"
    else
        dim "  No recent repositories yet."
    fi
}

handle_clone() {
    local clone_url="${1:-}"
    local destination="${2:-}"

    if [[ -z "$clone_url" ]]; then
        err "Clone requires URL."
        return 2
    fi

    if [[ -z "$destination" ]]; then
        destination="${SEARCH_ROOTS[0]}/$(basename "${clone_url%.git}")"
    fi

    destination="${destination/#\~/$HOME}"

    git clone "$clone_url" "$destination" || return 1
    add_cache "$destination" || return 1
    remember_recent "$destination"
}

handle_alias() {
    local action="${1:-list}"
    shift || true
    ensure_dirs

    case "$action" in
        list)
            banner
            section "Aliases"

            if [[ -s "$ALIASES_FILE" ]]; then
                if command -v column >/dev/null 2>&1; then
                    column -t -s'|' "$ALIASES_FILE"
                else
                    cat "$ALIASES_FILE"
                fi
            else
                dim "  No aliases configured."
            fi
            ;;
        set)
            local alias_name="${1:-}"
            local project="${2:-}"

            if [[ -z "$alias_name" || -z "$project" ]]; then
                err "Use: gp alias set <alias> <project>"
                return 2
            fi

            select_repo "$project" || return 1

            if [[ -f "$ALIASES_FILE" ]]; then
                awk -F'|' -v alias_name="$alias_name" \
                    'tolower($1) != tolower(alias_name)' "$ALIASES_FILE" > "$ALIASES_FILE.tmp"
            else
                : > "$ALIASES_FILE.tmp"
            fi

            printf '%s|%s\n' "$alias_name" "$SELECTED" >> "$ALIASES_FILE.tmp"
            mv "$ALIASES_FILE.tmp" "$ALIASES_FILE"
            ok "Alias '$alias_name' set."
            ;;
        remove)
            local alias_name="${1:-}"

            if [[ ! -f "$ALIASES_FILE" ]]; then
                return 0
            fi

            awk -F'|' -v alias_name="$alias_name" \
                'tolower($1) != tolower(alias_name)' "$ALIASES_FILE" > "$ALIASES_FILE.tmp"
            mv "$ALIASES_FILE.tmp" "$ALIASES_FILE"
            ;;
        *)
            err "Unknown alias command: $action"
            return 2
            ;;
    esac
}

handle_favorite() {
    local action="${1:-list}"
    shift || true
    ensure_dirs

    case "$action" in
        list)
            banner
            section "Favorite repositories"

            if [[ -s "$FAVORITES_FILE" ]]; then
                local favorite_path
                while IFS= read -r favorite_path; do
                    [[ -n "$favorite_path" ]] || continue
                    printf '  %-28s%s%s%s\n' \
                        "$(repo_name "$favorite_path")" \
                        "$C_GRAY" "$favorite_path" "$C_RESET"
                done < "$FAVORITES_FILE"
            else
                dim "  No favorite repositories."
                dim "  Add one with: gp favorite add <project>"
            fi

            printf '\n'
            dim "  Add:     gp favorite add <project>"
            dim "  Remove:  gp favorite remove <project>"
            dim "  Shortcut: gp fav ..."
            ;;
        add)
            select_repo "${1:-}" || return 1

            {
                if [[ -f "$FAVORITES_FILE" ]]; then
                    cat "$FAVORITES_FILE"
                fi
                printf '%s\n' "$SELECTED"
            } | sort -u > "$FAVORITES_FILE.tmp"

            mv "$FAVORITES_FILE.tmp" "$FAVORITES_FILE"
            ok "Added to favorites."
            ;;
        remove)
            select_repo "${1:-}" || return 1

            if [[ -f "$FAVORITES_FILE" ]]; then
                grep -Fvx "$SELECTED" "$FAVORITES_FILE" > "$FAVORITES_FILE.tmp" || true
                mv "$FAVORITES_FILE.tmp" "$FAVORITES_FILE"
            fi
            ;;
        *)
            err "Unknown favorite command: $action"
            return 2
            ;;
    esac
}

# Bulk operations use the cache only and run each repository in isolation.
bulk_sync() (
    local repository="$1" allow="$2" message="$3" push_only="${4:-false}" fetched_remote="${5:-}" fetched_ok="${6:-}"
    cd "$repository" || return 1
    local branch remote upstream target counts ahead=0 behind=0 dirty marker path name
    branch="$(git symbolic-ref --quiet --short HEAD)" || {
        warn "SKIP detached: $repository"
        return 1
    }
    remote="$(git config --get "branch.$branch.remote" || current_remote)" || return 1
    [[ "$remote" != . && -n "$remote" ]] || return 1
    if [[ "$fetched_remote" == "$remote" ]]; then
        [[ "$fetched_ok" == 0 ]] || {
            warn "FAIL fetch: $repository"
            return 1
        }
    else
        git fetch --prune "$remote" || return 1
    fi
    for marker in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD rebase-merge rebase-apply sequencer BISECT_START; do
        path="$(git rev-parse --git-path "$marker")" || return 1
        [[ ! -e "$path" ]] || {
            warn "SKIP Git operation: $repository"
            return 1
        }
    done
    dirty="$(git status --porcelain --untracked-files=all)" || return 1
    upstream="$(git rev-parse --symbolic-full-name '@{u}' 2>/dev/null || true)"
    target="$(git config --get "branch.$branch.merge" || true)"
    if [[ -z "$upstream" ]]; then
        if [[ -n "$target" ]]; then
            warn "SKIP missing upstream: $repository"
            return 1
        fi
        target="refs/heads/$branch"
        if git show-ref --verify --quiet "refs/remotes/$remote/$branch"; then
            upstream="refs/remotes/$remote/$branch"
        fi
    fi
    [[ "$target" == refs/heads/* ]] || return 1
    if [[ -n "$upstream" ]]; then
        counts="$(git rev-list --left-right --count "HEAD...$upstream")" || return 1
        read -r ahead behind <<< "$counts"
    fi
    if (( ahead > 0 && behind > 0 )); then
        warn "SKIP diverged: $repository"
        return 1
    fi
    if [[ "$push_only" == true ]] && (( behind > 0 )); then
        warn "SKIP behind: $repository"
        return 1
    fi
    if [[ "$push_only" != true && -n "$dirty" && ( -z "$message" || "$behind" -gt 0 ) ]]; then
        warn "SKIP dirty: $repository"; return 1
    fi
    if [[ ( "$push_only" != true && -n "$dirty" ) || "$ahead" -gt 0 || -z "$upstream" ]]; then
        if [[ "$allow" != true ]] && {
            protected_branch "$branch" || protected_branch "${target#refs/heads/}"
        }; then
            warn "SKIP protected: $repository"; return 1
        fi
    fi
    if [[ "$push_only" != true && -n "$dirty" ]]; then
        local changed
        changed="$(mktemp)" || return 1
        trap 'rm -f -- "$changed"' EXIT
        {
            git diff --name-only -z --diff-filter=ACMRTUXB && git diff --cached --name-only -z --diff-filter=ACMRTUXB && git ls-files --others --exclude-standard -z
        } > "$changed" || return 1
        while IFS= read -r -d '' path; do
            name="${path##*/}"; name="${name,,}"
            case "$name" in
                .env.example|.env.sample|.env.template) ;;
                .env|.env.*|*.pem|*.key|*.pfx|*.p12|id_rsa|id_ed25519|id_ecdsa|id_dsa|secrets*.json|secrets*.yml|secrets*.yaml|credentials*.json|credentials*.yml|credentials*.yaml|service-account*.json)
                    warn "SKIP risky file: $path"; return 1 ;;
            esac
            if [[ -f "$path" ]] && (( $(wc -c < "$path") >= LARGE_FILE_MB * 1048576 )); then
                warn "SKIP large file: $path"; return 1
            fi
        done < "$changed"
        git add -A && git commit -m "$message" || return 1
        dirty="$(git status --porcelain --untracked-files=all)" || return 1
        [[ -z "$dirty" ]] || return 1
        ahead=1
    fi
    if (( behind > 0 )); then
        git merge --ff-only "$upstream" || return 1
        ok "SYNCED $repository"
    elif (( ahead > 0 )) || [[ -z "$upstream" ]]; then
        if git rev-parse --verify '@{u}' >/dev/null 2>&1; then
            git push "$remote" "HEAD:$target" || return 1
        else
            git push -u "$remote" "HEAD:$target" || return 1
        fi
        ok "PUSHED $repository"
    else
        ok "OK $repository"
    fi
)

bulk_dashboard_row() (
    local repository="$1" action="$2" branch="-" commit="-" behind="-" ahead="-" worktree="unknown" state="Unknown" result="" remote="" upstream="" counts="" dirty="" failed=0
    cd "$repository" || return 1
    branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || printf '(detached)')"
    commit="$(git log -1 --format=%s 2>/dev/null || printf '-')"
    if dirty="$(git status --porcelain --untracked-files=all)"; then
        if [[ -z "$dirty" ]]; then
            worktree=clean
        else
            worktree="dirty ($(printf '%s\n' "$dirty" | wc -l))"
        fi
    else failed=1; fi
    remote="$(git config --get "branch.$branch.remote" || current_remote || true)"
    if [[ "$remote" == . ]]; then
        state="Local upstream"
        failed=1
    elif [[ -z "$remote" ]]; then
        state="No remote"
        failed=1
    elif [[ "$action" == fetch ]] && ! git fetch --quiet --prune "$remote"; then
        state="Fetch failed"
        failed=1
    elif [[ "$branch" == '(detached)' ]]; then
        state="Detached HEAD"
        failed=1
    else
        upstream="$(git rev-parse --symbolic-full-name '@{u}' 2>/dev/null || true)"
        if [[ -z "$upstream" ]]; then
            if git config --get "branch.$branch.merge" >/dev/null; then
                state="Missing upstream"
                failed=1
            elif git show-ref --verify --quiet "refs/remotes/$remote/$branch"; then
                upstream="refs/remotes/$remote/$branch"
            else state="New remote branch"; fi
        fi
        if [[ -n "$upstream" ]]; then
            if counts="$(git rev-list --left-right --count "HEAD...$upstream")"; then
                read -r ahead behind <<< "$counts"
                if (( ahead > 0 && behind > 0 )); then
                    state=Diverged
                    failed=1
                elif (( ahead > 0 )); then state=Ahead
                elif (( behind > 0 )); then state=Behind
                else state="Up to date"; fi
            else failed=1; fi
        fi
    fi
    if [[ "$action" == fetch ]]; then
        result="OK fetched"
        (( failed == 0 )) || result="Attention"
    fi
    bulk_table_line "${repository##*/}" "$branch" "$commit" "$behind" "$ahead" "$worktree" "$state" "$result"
    return "$failed"
)

# Shared compact table: never rely on terminal wrapping for columns.
bulk_table_line() {
    local width=${bulk_width:-100} name_width branch_width commit_width line
    name_width=$((width/3))
    ((name_width<=24)) || name_width=24
    branch_width=$((width/6))
    ((branch_width<=18)) || branch_width=18
    if ((width>=100)); then
        commit_width=$((width-name_width-branch_width-48))
        printf -v line '%-*.*s %-*.*s %-*.*s %4s | %-4s %-10.10s %-10.10s %s' "$name_width" "$name_width" "$1" "$branch_width" "$branch_width" "$2" "$commit_width" "$commit_width" "$3" "$4" "$5" "$6" "$7" "$8"
    elif ((width>=55)); then
        printf -v line '%-*.*s %-*.*s %4s | %-4s %s' "$name_width" "$name_width" "$1" "$branch_width" "$branch_width" "$2" "$4" "$5" "${8:-$6}"
    else
        printf -v line '%-*.*s %s' "$name_width" "$name_width" "$1" "${8:-$7}"
    fi
    printf '%.*s\n' "$width" "${line//[[:cntrl:]]/?}"
}

handle_all() (
    local action=sync allow_protected=false message="" refresh=false
    if [[ $# -gt 0 && "$1" != -* ]]; then
        action="$1"
        shift
    fi
    case "$action" in
        status|fetch|sync|push)
        ;;
        *)
            err "Unknown all command: $action"
            return 2
        ;;
    esac
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --allow-protected) allow_protected=true ;;
            --cached) ;;
            --refresh) refresh=true ;;
            --) shift
            message="${message:+$message }$*"
            break
            ;;
            -*) err "Unknown all option: $1"
            return 2
            ;;
            *) if [[ "$action" != push ]]; then
                err "Unexpected argument: $1"
                return 2
            fi
               message="${message:+$message }$1" ;;
        esac
        shift
    done
    if [[ "$action" == push && -z "${message//[[:space:]]/}" ]]; then
        err 'Use: gp all push "Commit message"'
        return 2
    fi
    if [[ "$refresh" == true ]]; then
        scan_repos; save_cache "${FOUND_REPOS[@]}"
    fi
    load_cache
    local -a repositories=("${CACHED_REPOS[@]}")
    if (( ${#repositories[@]} == 0 )); then
        err 'No usable cache. Run gp cache refresh.'
        return 1
    fi
    banner; section "All cached repositories"
    if [[ "$action" == push ]]; then
        confirm "Commit and synchronize ${#repositories[@]} repositories?" || return 0
    fi
    local repository failures=0 processed=0 started=$SECONDS bulk_width=100 tmp i j rc result
    local -a bulk_jobs=()
    if [[ -t 1 ]]; then
        bulk_width=$(tput cols 2>/dev/null || printf 100)
    fi
    [[ "$bulk_width" =~ ^[0-9]+$ ]] || bulk_width=100
    bulk_width=$((bulk_width>1?bulk_width-1:1))
    tmp=$(mktemp -d) || return 1
    local worker_pid=''
    trap 'for worker_pid in "${bulk_jobs[@]}"; do kill "$worker_pid" 2>/dev/null || true; done; rm -rf -- "$tmp"' EXIT
    trap 'exit 130' INT
    # Limit parallelism; keep writes sequential to avoid shared worktree/index races.
    local bar_width=$((bulk_width>70?24:bulk_width>35?12:4))
    if [[ -t 1 ]]; then
        printf '\r\033[2K%s%s%s ' "$C_CYAN" "$action" "$C_RESET"
        workspace_block_bar 0 "$bar_width"
        printf '   0%%'
    fi
    local batch=4
    if [[ "$action" == sync || "$action" == push ]]; then
        batch=1
        local -a fetched=()
        local fetch_done=0
        for ((i=0;i<${#repositories[@]};i+=4)); do
            bulk_jobs=()
            for ((j=i;j<i+4 && j<${#repositories[@]};j++)); do
                (
                    cd "${repositories[j]}" || exit 1
                    local branch remote fetch_rc=0
                    branch=$(git symbolic-ref --quiet --short HEAD) || exit 1
                    remote=$(git config --get "branch.$branch.remote" || current_remote) || exit 1
                    [[ -n "$remote" && "$remote" != . ]] || exit 1
                    git fetch --prune "$remote" > "$tmp/fetch-$j.log" 2>&1 || fetch_rc=$?
                    printf '%s\0%s\0' "$remote" "$fetch_rc" > "$tmp/fetch-$j"
                ) &
                bulk_jobs+=("$!")
            done
            for j in "${bulk_jobs[@]}"; do
                wait "$j" || true
                fetch_done=$((fetch_done+1))
                if [[ -t 1 ]]; then
                    printf '\r\033[2K%sFetching%s ' "$C_CYAN" "$C_RESET"
                    workspace_block_bar "$((fetch_done*bar_width/${#repositories[@]}))" "$bar_width"
                    printf ' %3d%%' "$((fetch_done*100/${#repositories[@]}))"
                fi
            done
            bulk_jobs=()
        done
        if [[ -t 1 ]]; then
            printf '\r\033[2K%sApplying local changes%s ' "$C_CYAN" "$C_RESET"
            workspace_block_bar 0 "$bar_width"
            printf '   0%%'
        fi
    fi
    for ((i=0;i<${#repositories[@]};i+=batch)); do
        bulk_jobs=()
        for ((j=i;j<i+batch && j<${#repositories[@]};j++)); do
            repository=${repositories[j]}
            if [[ "$action" == status || "$action" == fetch ]]; then
                (bulk_dashboard_row "$repository" "$action") > "$tmp/$j" 2>&1 &
                bulk_jobs+=("$!")
            else
                result=OK
                fetched=()
                if [[ -f "$tmp/fetch-$j" ]]; then
                    mapfile -d '' -t fetched < "$tmp/fetch-$j"
                fi
                C_RESET='' C_CYAN='' C_GREEN='' C_YELLOW='' C_RED='' C_GRAY='' bulk_sync "$repository" "$allow_protected" "$message" false "${fetched[0]:-}" "${fetched[1]:-}" > "$tmp/$j" 2>&1 || {
                    failures=$((failures+1))
                    result=ATTENTION
                }
                printf '%s %s %s %s\n' "$(date -Iseconds)" "$action" "$result" "$repository" >> "$CONFIG_DIR/history.log" || true
                processed=$((processed+1))
            fi
        done
        for j in "${bulk_jobs[@]}"; do
            rc=0; wait "$j" || rc=$?
            ((rc==0)) || failures=$((failures+1))
            processed=$((processed+1))
        done
        bulk_jobs=()
        if [[ -t 1 ]]; then
            printf '\r\033[2K%s%s%s ' "$C_CYAN" "$action" "$C_RESET"
            workspace_block_bar "$((processed*bar_width/${#repositories[@]}))" "$bar_width"
            printf ' %3d%% (%ss)' "$((processed*100/${#repositories[@]}))" "$((SECONDS-started))"
        fi
    done
    if [[ -t 1 ]]; then printf '\r\033[2K'; fi
    if [[ "$action" == status || "$action" == fetch ]]; then
        bulk_table_line Repository Branch 'Last commit' Behind Ahead Worktree Sync Result
    fi
    for ((i=0;i<${#repositories[@]};i++)); do
        while IFS= read -r result; do
            printf '%.*s\n' "$bulk_width" "$result"
        done < "$tmp/$i"
    done
    rm -rf -- "$tmp"
    kv Repositories "${#repositories[@]}"
    kv Attention "$failures"
    (( failures == 0 ))
)

handle_repo() {
    local action="${1:-status}"
    shift || true

    select_repo "${1:-}" || return 1
    remember_recent "$SELECTED"

    local remote_name

    case "$action" in
        status)
            banner
            repo_status "$SELECTED"
            ;;
        diff)
            cd "$SELECTED" || return 1
            banner
            section "Diff summary"
            git diff --stat
            git diff --cached --stat
            ;;
        log)
            cd "$SELECTED" || return 1
            banner
            section "Recent commits"
            git log --graph --decorate --oneline --all -20
            ;;
        open)
            if command -v xdg-open >/dev/null 2>&1; then
                xdg-open "$SELECTED" >/dev/null 2>&1 &
                disown || true
            else
                err "xdg-open was not found."
                return 1
            fi
            ;;
        fetch)
            cd "$SELECTED" || return 1
            remote_name="$(current_remote)" || return 1
            git fetch --prune "$remote_name"
            ;;
        pull)
            cd "$SELECTED" || return 1

            if [[ -n "$(git status --porcelain)" ]]; then
                err "Working tree must be clean."
                return 1
            fi

            git pull --rebase
            ;;
        sync)
            safe_sync "$SELECTED" false
            ;;
        *)
            err "Unknown repo command: $action"
            return 2
            ;;
    esac
}

handle_branch() {
    local action="${1:-list}"
    shift || true

    local project="${1:-}"
    local branch_name="${2:-}"

    select_repo "$project" || return 1
    cd "$SELECTED" || return 1

    case "$action" in
        list)
            git branch -vv
            git branch -r
            ;;
        new)
            [[ -n "$branch_name" ]] || return 2
            git switch -c "$branch_name"
            ;;
        switch)
            [[ -n "$branch_name" ]] || return 2
            git switch "$branch_name"
            ;;
        delete)
            [[ -n "$branch_name" ]] || return 2

            if protected_branch "$branch_name"; then
                err "Protected branch."
                return 1
            fi

            git branch -d "$branch_name"
            ;;
        prune)
            prune_local_branches
            ;;
        *)
            err "Unknown branch command: $action"
            return 2
            ;;
    esac
}

prune_local_branches() {
    local remote_name
    remote_name="$(current_remote 2>/dev/null || true)"

    if [[ -n "$remote_name" ]]; then
        git fetch --prune "$remote_name" || return 1
    fi

    local current_branch
    current_branch="$(git branch --show-current)"

    local -a gone_branches=()
    local -a safe_branches=()

    mapfile -t gone_branches < <(
        git for-each-ref \
            --format='%(refname:short)|%(upstream:track)' \
            refs/heads |
            awk -F'|' '$2 ~ /\[gone\]/{print $1}'
    )

    local branch_name
    for branch_name in "${gone_branches[@]}"; do
        if [[ "$branch_name" == "$current_branch" ]]; then
            continue
        fi

        if protected_branch "$branch_name"; then
            continue
        fi

        if git merge-base --is-ancestor "$branch_name" HEAD >/dev/null 2>&1; then
            safe_branches+=("$branch_name")
        fi
    done

    if [[ ${#safe_branches[@]} -eq 0 ]]; then
        ok "No safe stale branches."
        return 0
    fi

    printf '  %s\n' "${safe_branches[@]}"

    if ! confirm "Delete these ${#safe_branches[@]} branch(es)?"; then
        return 0
    fi

    for branch_name in "${safe_branches[@]}"; do
        git branch -d "$branch_name"
    done
}

handle_remote() {
    local action="${1:-list}"
    shift || true

    local project="${1:-}"
    local remote_name="${2:-}"
    local remote_url="${3:-}"

    select_repo "$project" || return 1
    cd "$SELECTED" || return 1

    case "$action" in
        list)
            git remote -v
            ;;
        add)
            [[ -n "$remote_name" && -n "$remote_url" ]] || return 2
            git remote add "$remote_name" "$remote_url"
            ;;
        set-url)
            [[ -n "$remote_name" && -n "$remote_url" ]] || return 2

            if confirm "Change remote '$remote_name' URL?"; then
                git remote set-url "$remote_name" "$remote_url"
            fi
            ;;
        remove)
            [[ -n "$remote_name" ]] || return 2

            if confirm "Remove remote '$remote_name'?"; then
                git remote remove "$remote_name"
            fi
            ;;
        *)
            err "Unknown remote command: $action"
            return 2
            ;;
    esac
}

handle_stash() {
    local action="${1:-list}"
    shift || true

    select_repo "${1:-}" || return 1
    cd "$SELECTED" || return 1

    case "$action" in
        push)
            git stash push --include-untracked
            ;;
        list)
            git stash list
            ;;
        pop)
            git stash pop
            ;;
        *)
            err "Unknown stash command: $action"
            return 2
            ;;
    esac
}

handle_tag() {
    local action="${1:-list}"
    shift || true

    local project="${1:-}"
    local tag_name="${2:-}"

    if [[ $# -ge 2 ]]; then
        shift 2
    else
        set --
    fi

    local tag_message="$*"

    select_repo "$project" || return 1
    cd "$SELECTED" || return 1

    local remote_name
    local upstream
    local ahead
    local behind

    case "$action" in
        list)
            git for-each-ref \
                --sort=-creatordate \
                --format='%(refname:short)  %(creatordate:short)  %(subject)' \
                refs/tags
            ;;
        create)
            [[ -n "$tag_name" ]] || return 2

            if [[ -z "$tag_message" ]]; then
                tag_message="Release $tag_name"
            fi

            git tag -a "$tag_name" -m "$tag_message"
            ;;
        push)
            [[ -n "$tag_name" ]] || return 2
            remote_name="$(current_remote)" || return 1
            git push "$remote_name" "refs/tags/$tag_name"
            ;;
        delete)
            [[ -n "$tag_name" ]] || return 2
            git tag -d "$tag_name"
            ;;
        release)
            [[ -n "$tag_name" ]] || return 2

            if [[ -n "$(git status --porcelain)" ]]; then
                err "Release requires clean working tree."
                return 1
            fi

            remote_name="$(current_remote)" || return 1
            git fetch --prune "$remote_name" || return 1

            upstream="$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)"
            if [[ -z "$upstream" ]]; then
                err "Release requires upstream."
                return 1
            fi

            read -r ahead behind <<< "$(git rev-list --left-right --count "HEAD...$upstream")"
            if [[ "$ahead" != "0" || "$behind" != "0" ]]; then
                err "Branch is not exactly synchronized."
                return 1
            fi

            if git show-ref --tags --verify --quiet "refs/tags/$tag_name"; then
                err "Tag already exists."
                return 1
            fi

            if [[ -z "$tag_message" ]]; then
                tag_message="Release $tag_name"
            fi

            if ! confirm "Create and push release tag '$tag_name'?"; then
                return 0
            fi

            if ! git tag -a "$tag_name" -m "$tag_message"; then
                return 1
            fi

            if ! git push "$remote_name" "refs/tags/$tag_name"; then
                git tag -d "$tag_name" >/dev/null 2>&1 || true
                return 1
            fi
            ;;
        *)
            err "Unknown tag command: $action"
            return 2
            ;;
    esac
}


# -----------------------------------------------------------------------------
# Project tools
# -----------------------------------------------------------------------------
project_detect() {
    local path="$1"
    PROJECT_TYPES=()
    PROJECT_MANIFESTS=()
    [[ -f "$path/Cargo.toml" ]] && {
        PROJECT_TYPES+=("Rust")
        PROJECT_MANIFESTS+=("Cargo.toml")
    }
    local first_sln="" first_csproj=""
    first_sln="$(find "$path" -maxdepth 1 -type f -name '*.sln' -print -quit 2>/dev/null || true)"
    first_csproj="$(find "$path" -maxdepth 1 -type f -name '*.csproj' -print -quit 2>/dev/null || true)"
    if [[ -n "$first_sln" || -n "$first_csproj" ]]; then
        PROJECT_TYPES+=(".NET")
        if [[ -n "$first_sln" ]]; then
            PROJECT_MANIFESTS+=("$(basename "$first_sln")")
        else
            PROJECT_MANIFESTS+=("$(basename "$first_csproj")")
        fi
    fi
    [[ -f "$path/package.json" ]] && {
        PROJECT_TYPES+=("Node")
        PROJECT_MANIFESTS+=("package.json")
    }
    if [[ -f "$path/pyproject.toml" ]]; then
        PROJECT_TYPES+=("Python")
        PROJECT_MANIFESTS+=("pyproject.toml")
    elif [[ -f "$path/requirements.txt" ]]; then
        PROJECT_TYPES+=("Python")
        PROJECT_MANIFESTS+=("requirements.txt")
    fi
    [[ -f "$path/CMakeLists.txt" ]] && {
        PROJECT_TYPES+=("C/C++")
        PROJECT_MANIFESTS+=("CMakeLists.txt")
    }
    [[ ${#PROJECT_TYPES[@]} -eq 0 ]] && PROJECT_TYPES+=("Generic")
}
node_runner() {
    local path="$1"
    [[ -f "$path/pnpm-lock.yaml" ]] && {
        printf 'pnpm'
        return
    }
    [[ -f "$path/yarn.lock" ]] && {
        printf 'yarn'
        return
    }
    printf 'npm'
}
node_has_script() {
    local path="$1" name="$2"
    if command -v python3 >/dev/null 2>&1; then
        python3 - "$path/package.json" "$name" <<'PY_NODE' >/dev/null 2>&1
import json,sys
try:
    with open(sys.argv[1],encoding='utf-8') as f: p=json.load(f)
    raise SystemExit(0 if sys.argv[2] in p.get('scripts',{}) else 1)
except Exception:
    raise SystemExit(1)
PY_NODE
        return $?
    fi
    grep -Eq '"'"$name"'"[[:space:]]*:' "$path/package.json" 2>/dev/null
}
project_python() {
    local path="$1"
    [[ -x "$path/.venv/bin/python" ]] && {
        printf '%s' "$path/.venv/bin/python"
        return
    }
    command -v python3 >/dev/null 2>&1 && {
        printf 'python3'
        return
    }
    command -v python >/dev/null 2>&1 && {
        printf 'python'
        return
    }
    return 1
}
handle_project() {
    local action="${1:-info}"; shift || true
    local project="${1:-}"
    case "$action" in
        info|build|test|run|open|shell)
        ;;
        *)
            err "Unknown project action: $action"
            dim 'Use: gp project info|build|test|run|open|shell [project]'
            return 2
        ;;
    esac
    [[ $# -le 1 ]] || {
        err 'Project command accepts at most one project.'
        return 2
    }
    select_repo "$project" || return 1
    remember_recent "$SELECTED"
    project_detect "$SELECTED"
    local branch="-"
    branch="$(git -C "$SELECTED" branch --show-current 2>/dev/null || true)"
    [[ -n "$branch" ]] || branch='-'
    banner; section 'Project'
    kv Name "$(repo_name "$SELECTED")"
    kv Path "$SELECTED" "$C_GRAY"
    kv Type "$(IFS=' + '; echo "${PROJECT_TYPES[*]}")"
    if [[ ${#PROJECT_MANIFESTS[@]} -gt 0 ]]; then
        kv Manifest "$(IFS=', '; echo "${PROJECT_MANIFESTS[*]}")"
    else
        kv Manifest '-'
    fi
    kv 'Git branch' "$branch" "$C_MAGENTA"
    case "$action" in
        info) section 'Available'
        dim '  info    Detect project type and metadata.'
        dim '  build   Build using the detected toolchain.'
        dim '  test    Run project tests.'
        dim '  run     Run when a safe default can be detected.'
        dim '  open    Open project folder with xdg-open.'
        dim '  shell   Start an interactive shell in the project.'
        return 0
        ;;
        open) command -v xdg-open >/dev/null 2>&1 || {
            err 'xdg-open was not found.'
            return 1
        }
        xdg-open "$SELECTED" >/dev/null 2>&1 & disown || true
        ok 'Opened project folder.'
        return 0
        ;;
        shell) cd "$SELECTED" || return 1
        local shell_bin="${SHELL:-/bin/bash}"
        [[ -x "$shell_bin" ]] || shell_bin=/bin/bash
        exec "$shell_bin" -i
        ;;
    esac
    cd "$SELECTED" || return 1
    if printf '%s\n' "${PROJECT_TYPES[@]}" | grep -Fxq 'Rust'; then
        command -v cargo >/dev/null 2>&1 || {
            err 'cargo was not found.'
            return 127
        }
        case "$action" in
            build)
                cargo build
            ;;
            test)
                cargo test
            ;;
            run)
                cargo run
            ;;
        esac
        return $?
    fi
    if printf '%s\n' "${PROJECT_TYPES[@]}" | grep -Fxq '.NET'; then
        command -v dotnet >/dev/null 2>&1 || {
            err 'dotnet was not found.'
            return 127
        }
        local target=""
        target="$(find . -maxdepth 1 -type f \( -name '*.sln' -o -name '*.csproj' \) -print -quit | sed 's#^./##')"
        case "$action" in
            build)
                if [[ -n "$target" ]]; then
                    dotnet build "$target"
                else
                    dotnet build
                fi
                ;;
            test)
                if [[ -n "$target" ]]; then
                    dotnet test "$target"
                else
                    dotnet test
                fi
                ;;
            run)
                if [[ "$target" == *.csproj ]]; then
                    dotnet run --project "$target"
                else
                    dotnet run
                fi
                ;;
        esac
        return $?
    fi
    if printf '%s\n' "${PROJECT_TYPES[@]}" | grep -Fxq 'Node'; then
        local runner
        runner="$(node_runner "$SELECTED")"
        command -v "$runner" >/dev/null 2>&1 || {
            err "$runner was not found."
            return 127
        }
        case "$action" in
            build)
                node_has_script "$SELECTED" build || {
                    err "package.json does not define 'build'."
                    return 1
                }
                "$runner" run build
            ;;
            test)
                node_has_script "$SELECTED" test || {
                    err "package.json does not define 'test'."
                    return 1
                }
                "$runner" test
            ;;
            run)
                if node_has_script "$SELECTED" dev; then
                    "$runner" run dev
                elif node_has_script "$SELECTED" start; then
                    "$runner" start
                else
                    err "No 'dev' or 'start' script found."
                    return 1
                fi
            ;;
        esac
        return $?
    fi
    if printf '%s\n' "${PROJECT_TYPES[@]}" | grep -Fxq 'Python'; then
        local py
        py="$(project_python "$SELECTED")" || {
            err 'Python was not found.'
            return 127
        }
        case "$action" in
            build)
                if [[ -f pyproject.toml ]]; then
                    "$py" -m build
                else
                    "$py" -m compileall .
                fi
            ;;
            test)
                "$py" -m pytest
            ;;
            run)
                if [[ -f main.py ]]; then
                    "$py" main.py
                elif [[ -f app.py ]]; then
                    "$py" app.py
                else
                    err 'No main.py or app.py found.'
                    return 1
                fi
            ;;
        esac
        return $?
    fi
    if printf '%s\n' "${PROJECT_TYPES[@]}" | grep -Fxq 'C/C++'; then
        command -v cmake >/dev/null 2>&1 || {
            err 'cmake was not found.'
            return 127
        }
        case "$action" in
            build)
                cmake -S . -B build && cmake --build build
            ;;
            test)
                command -v ctest >/dev/null 2>&1 || {
                    err 'ctest was not found.'
                    return 127
                }
                ctest --test-dir build --output-on-failure
            ;;
            run)
                err 'A generic CMake project has no safe automatic run target.'
                return 1
            ;;
        esac
        return $?
    fi
    err "Action '$action' is not available for this project type."
    return 1
}
