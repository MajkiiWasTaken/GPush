    bulk_width=$((columns>1?columns-1:1))
    bulk_table_line Repository Branch 'Last commit' Behind Ahead Worktree Sync ''
    for ((n=0;n+7<${#fields[@]};n+=8)); do
        repository=${fields[n]}
        branch=${fields[n+1]}
        commit=${fields[n+2]}
        behind=${fields[n+3]}
        ahead=${fields[n+4]}
        dirty=${fields[n+5]}
        state=${fields[n+6]}
        path=${fields[n+7]}
        case "$filter" in
            --dirty)
                (( dirty > 0 )) || continue
            ;;
            --ahead)
                if [[ "$ahead" == - ]] || (( ahead <= 0 )); then
                    continue
                fi
            ;;
            --behind)
                if [[ "$behind" == - ]] || (( behind <= 0 )); then
                    continue
                fi
            ;;
        esac
        bulk_table_line "$repository" "$branch" "$commit" "$behind" "$ahead" "$dirty changed" "$state" ''
