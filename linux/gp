version_numeric() {
    local v="${1#v}"
    printf '%s' "${v%%-*}"
}
version_gt() {
    local a b
    a="$(version_numeric "$1")"
    b="$(version_numeric "$2")"
    [[ "$a" == "$b" ]] && return 1
    [[ "$(printf '%s\n%s\n' "$a" "$b" | sort -V | tail -n1)" == "$a" ]]
}
latest_release_json() {
    command -v curl >/dev/null 2>&1 || {
        err 'curl is required for GPush update.'
        return 1
    }
    curl -fsSL -H "User-Agent: GPush/$SCRIPT_VERSION" -H 'Accept: application/vnd.github+json' 'https://api.github.com/repos/MajkiiWasTaken/GPush/releases/latest'
}
release_field() {
    local json_file="$1" key="$2" extra="${3:-}"
    command -v python3 >/dev/null 2>&1 || {
        err 'python3 is required to parse GitHub release metadata.'
        return 1
    }
    python3 - "$json_file" "$key" "$extra" <<'PY_RELEASE'
import json,sys
with open(sys.argv[1],encoding='utf-8') as f: d=json.load(f)
if sys.argv[2]=='tag': print(d.get('tag_name',''))
elif sys.argv[2]=='linux_asset':
    assets=d.get('assets',[])
    cand=[a for a in assets if 'linux' in a.get('name','').lower() and a.get('name','').lower().endswith(('.tar.gz','.zip'))]
    if cand: print(cand[0].get('name','')+'|'+cand[0].get('browser_download_url',''))
elif sys.argv[2]=='size':
    for a in d.get('assets',[]):
        if a.get('name')==sys.argv[3]: print(a.get('size',0)); break
elif sys.argv[2]=='checksum':
    assets=d.get('assets',[])
    package=sys.argv[3] if len(sys.argv) > 3 else ''
    wanted=[package+'.sha256', package+'.sha256.txt', 'SHA256SUMS', 'SHA256SUMS.txt', 'sha256sums.txt']
    for wanted_name in wanted:
        for a in assets:
            if a.get('name','').lower()==wanted_name.lower():
                print(a.get('name','')+'|'+a.get('browser_download_url',''))
                raise SystemExit(0)
PY_RELEASE
}
backup_current_gp() {
    mkdir -p "$BACKUP_DIR"
    local current_path backup_path
    current_path="$(command -v gp 2>/dev/null || true)"
    [[ -n "$current_path" ]] || current_path="${BASH_SOURCE[0]}"
    backup_path="$BACKUP_DIR/v$SCRIPT_VERSION-$(date +%Y%m%d-%H%M%S)"
    mkdir -p "$backup_path"
    cp "$current_path" "$backup_path/gp"
    chmod +x "$backup_path/gp"
    printf '%s' "$backup_path"
}
update_stage() {
    if [[ -t 1 ]]; then
        printf '\r\033[2K%s%s%s' "$C_CYAN" "$1" "$C_RESET"
    else
        info "$1"
    fi
}
update_stage_clear() {
    if [[ -t 1 ]]; then
        printf '\r\033[2K'
    fi
}
download_update_package() {
    local url="$1" file="$2" size="$3" bytes=0 started=$SECONDS elapsed rate percent=0 pid previous_trap cancelled=false rc=0
    local separator='?'
    if [[ "$url" == *'?'* ]]; then
        separator='&'
    fi
    url+="${separator}gpush_nocache=$(date +%s)-$RANDOM"
    if [[ ! -t 1 ]]; then
        curl -fsSL --connect-timeout 30 --max-time 300 -H 'Cache-Control: no-cache, no-store' -H "User-Agent: GPush/$SCRIPT_VERSION" "$url" -o "$file"
        return $?
    fi
    previous_trap=$(trap -p INT)
    curl -fsSL --connect-timeout 30 --max-time 300 -H 'Cache-Control: no-cache, no-store' -H "User-Agent: GPush/$SCRIPT_VERSION" "$url" -o "$file" &
    pid=$!
    trap 'cancelled=true; kill -TERM "$pid" 2>/dev/null || true' INT
    while kill -0 "$pid" 2>/dev/null; do
        if [[ "$cancelled" == true ]]; then
            break
        fi
        if [[ -f "$file" ]]; then
            bytes=$(wc -c < "$file")
        fi
        elapsed=$((SECONDS-started))
        rate=$((bytes/(elapsed>0?elapsed:1)/1024))
        printf '\r\033[2K%sDownloading%s  ' "$C_CYAN" "$C_RESET"
        if [[ "$size" =~ ^[0-9]+$ ]] && ((size>0)); then
            percent=$((100*bytes/size))
            ((percent<=100)) || percent=100
            workspace_block_bar "$((percent*28/100))" 28
            printf '  %3d%%  %d/%d KiB  %d KiB/s' "$percent" "$((bytes/1024))" "$((size/1024))" "$rate"
        else
            printf '%d KiB  %d KiB/s' "$((bytes/1024))" "$rate"
        fi
        sleep 0.12
    done
    wait "$pid" || rc=$?
    if [[ -n "$previous_trap" ]]; then
        eval "$previous_trap"
    else
        trap - INT
    fi
    printf '\r\033[2K'
    if [[ "$cancelled" == true ]]; then
        return 130
    fi
    return "$rc"
}
handle_update() (
    if (( $# > 1 )); then
        err "Update accepts at most one action."
        return 2
    fi
    local action="${1:-install}"
    case "$action" in
        check|install|rollback)
        ;;
        *)
            err "Unknown update action: $action"
            dim 'Use: gp update [check|install|rollback]'
            return 2
        ;;
    esac
    banner
    if [[ "$action" == rollback ]]; then
        local newest current_path
        newest="$(find "$BACKUP_DIR" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort -r | head -n1 || true)"
        [[ -n "$newest" && -f "$newest/gp" ]] || {
            warn 'No GPush backup exists.'
            return 0
        }
        current_path="$(command -v gp 2>/dev/null || true)"
        [[ -n "$current_path" ]] || current_path="$HOME/.local/bin/gp"
        section 'GPush Rollback'
        kv Current "$SCRIPT_VERSION"
        kv Backup "$newest" "$C_GRAY"
        confirm 'Restore newest GPush backup?' || return 0
        install -m 0755 "$newest/gp" "$current_path" || return 1
        ok 'Rollback completed.'
        dim 'Run a new gp command to use the restored version.'
        return 0
    fi
    local tmp json tag asset name url size download_rc=0
    tmp="$(mktemp -d)" || return 1
    trap 'rm -rf -- "$tmp"' EXIT
    trap 'exit 130' INT
    json="$tmp/release.json"
    latest_release_json > "$json" || {
        rm -rf "$tmp"
        return 1
    }
    tag="$(release_field "$json" tag)"
    [[ -n "$tag" ]] || {
        err 'Could not read latest release version.'
        rm -rf "$tmp"
        return 1
    }
    section 'GPush Update'
    kv Installed "$SCRIPT_VERSION"
    kv Latest "$tag"
    kv Channel stable
    if ! version_gt "$tag" "$SCRIPT_VERSION"; then
        ok 'GPush is up to date.'
        rm -rf "$tmp"
        return 0
    fi
    warn "Update available: $SCRIPT_VERSION -> $tag"
    if [[ "$action" == check && "${WORKSPACE_OFFER_UPDATE:-false}" != true ]]; then
        dim "Run 'gp update' to install."
        rm -rf "$tmp"
        return 0
    fi
    asset="$(release_field "$json" linux_asset)"
    [[ -n "$asset" ]] || {
        err 'Latest release has no Linux package asset.'
        rm -rf "$tmp"
        return 1
    }
    name="${asset%%|*}"
    url="${asset#*|}"
    if [[ "$action" == check ]]; then
        confirm "Download and install $tag?" || {
            rm -rf "$tmp"
            return 0
        }
    else
        confirm_default_yes "Download and install $tag?" || {
            rm -rf "$tmp"
            return 0
        }
    fi
    size=$(release_field "$json" size "$name")
    download_update_package "$url" "$tmp/$name" "${size:-0}" || download_rc=$?
    if ((download_rc!=0)); then
        return "$download_rc"
    fi
    update_stage 'Verifying package integrity'
    local checksum checksum_url expected actual
    checksum="$(release_field "$json" checksum "$name" || true)"
    if [[ -n "$checksum" ]]; then
        checksum_url="${checksum#*|}"
        if curl -fsSL -H "User-Agent: GPush/$SCRIPT_VERSION" "$checksum_url" -o "$tmp/checksum.txt"; then
            expected="$(grep -F "$name" "$tmp/checksum.txt" 2>/dev/null | grep -Eo '[A-Fa-f0-9]{64}' | head -n1 || true)"
            if [[ -z "$expected" && ( "${checksum%%|*}" == "$name.sha256" || "${checksum%%|*}" == "$name.sha256.txt" ) ]]; then
                expected="$(grep -Eo '[A-Fa-f0-9]{64}' "$tmp/checksum.txt" | head -n1 || true)"
            fi
            if [[ -n "$expected" ]]; then
                if command -v sha256sum >/dev/null 2>&1; then
                    actual="$(sha256sum "$tmp/$name" | awk '{print $1}')"
                else
                    actual="$(shasum -a 256 "$tmp/$name" | awk '{print $1}')"
                fi
                [[ "${actual,,}" == "${expected,,}" ]] || {
                    update_stage_clear
                    err 'Downloaded package SHA-256 does not match published checksum.'
                    rm -rf "$tmp"
                    return 1
                }
                update_stage 'Package integrity verified'
            else
                update_stage_clear
                err 'No matching SHA-256 value; update cancelled.'
                rm -rf "$tmp"
                return 1
            fi
        else
            update_stage_clear
            err 'Checksum download failed; update cancelled.'
            rm -rf "$tmp"
            return 1
        fi
    else
        update_stage_clear
        err 'No SHA-256 asset published. Update cancelled.'
        return 1
    fi
    update_stage 'Preparing installation'
    mkdir -p "$tmp/extract"
    case "$name" in
        *.tar.gz)
            tar -xzf "$tmp/$name" -C "$tmp/extract" || {
                rm -rf "$tmp"
                return 1
            }
        ;;
        *.zip)
            command -v unzip >/dev/null 2>&1 || {
                err 'unzip is required for ZIP update packages.'
                rm -rf "$tmp"
                return 1
            }
            unzip -q "$tmp/$name" -d "$tmp/extract" || {
                rm -rf "$tmp"
                return 1
            }
        ;;
        *)
            err 'Unsupported Linux update package.'
            rm -rf "$tmp"
            return 1
        ;;
    esac
    local new_gp package_version backup_path current_path
    new_gp="$(find "$tmp/extract" -type f -name gp -print -quit)"
    [[ -n "$new_gp" ]] || {
        err 'Release package does not contain gp.'
        rm -rf "$tmp"
        return 1
    }
    package_version="$(sed -n 's/^SCRIPT_VERSION="\([^"]*\)"/\1/p' "$new_gp" | head -n1)"
    [[ "$(version_numeric "$package_version")" == "$(version_numeric "$tag")" ]] || {
        err "Package version '$package_version' does not match release '$tag'."
        rm -rf "$tmp"
        return 1
    }
    backup_path="$(backup_current_gp)" || {
        rm -rf "$tmp"
        return 1
    }
    update_stage 'Installing verified package'
    current_path="$(command -v gp 2>/dev/null || true)"
    [[ -n "$current_path" ]] || current_path="$HOME/.local/bin/gp"
    mkdir -p "$(dirname "$current_path")"
    install -m 0755 "$new_gp" "$current_path" || {
        rm -rf "$tmp"
        return 1
    }
    update_stage_clear
    ok 'GPush updated successfully. SHA-256 verified.'
    dim "Rollback backup: $backup_path"
    kv Previous "$SCRIPT_VERSION"
    kv Current "$package_version" "$C_GREEN"
    rm -rf "$tmp"
)
levenshtein() {
    local a="${1,,}" b="${2,,}"
    local alen=${#a} blen=${#b}
    local -a prev=() curr=()
    local i j cost del ins rep

    for ((j=0; j<=blen; j++)); do
        prev[j]=$j
    done

    for ((i=1; i<=alen; i++)); do
        curr[0]=$i
        for ((j=1; j<=blen; j++)); do
            if [[ "${a:i-1:1}" == "${b:j-1:1}" ]]; then
                cost=0
            else
                cost=1
            fi
            del=$(( prev[j] + 1 ))
            ins=$(( curr[j-1] + 1 ))
            rep=$(( prev[j-1] + cost ))
            (( del < ins )) && curr[j]=$del || curr[j]=$ins
            (( rep < curr[j] )) && curr[j]=$rep
        done
        prev=("${curr[@]}")
    done

    printf '%s' "${prev[blen]}"
}

command_suggestion() {
    local value="${1,,}"
    case "$value" in
        tags) printf '%s' 'gp tag list [project]'
        return 0
        ;;
        branches) printf '%s' 'gp branch list [project]'
        return 0
        ;;
        remotes) printf '%s' 'gp remote list [project]'
        return 0
        ;;
        aliases) printf '%s' 'gp alias list'
        return 0
        ;;
        completition|competion) printf '%s' 'gp completion install'
        return 0
        ;;
    esac

    local -a commands=(repo branch tag remote stash cache config alias favorite favorites fav all overview health stats history watch changes detail commit diff branches github menu settings activity project clone recent update completion help version add remove set reset)
    local best='' best_distance=999 distance candidate max_distance
    for candidate in "${commands[@]}"; do
        distance="$(levenshtein "$value" "$candidate")"
        if (( distance < best_distance )); then
            best_distance=$distance
            best="$candidate"
        fi
    done

    if (( ${#value} <= 4 )); then
        max_distance=1
    else
        max_distance=2
    fi
    (( best_distance <= max_distance )) || return 1

    if [[ "$best" == completion ]]; then
        printf '%s' 'gp completion install'
    else
        printf 'gp %s ...' "$best"
    fi
}

known_repository_token() {
    local query resolved repository name alias_name alias_path
    query="$1"
    resolved="$(alias_resolve "$query")"

    if [[ -d "$resolved" && -e "$resolved/.git" ]]; then
        return 0
    fi

    if [[ -f "$ALIASES_FILE" ]]; then
        while IFS='|' read -r alias_name alias_path; do
            [[ "${alias_name,,}" == "${query,,}" ]] && return 0
        done < "$ALIASES_FILE"
    fi

    load_cache
    if [[ ${#CACHED_REPOS[@]} -eq 0 ]]; then
        scan_repos
        CACHED_REPOS=("${FOUND_REPOS[@]}")
    fi

    for repository in "${CACHED_REPOS[@]}"; do
        name="$(repo_name "$repository")"
        if [[ "${name,,}" == "${query,,}" || "${name,,}" == "${query,,}"* || "${name,,}" == *"${query,,}"* || "${repository,,}" == *"${query,,}"* ]]; then
            return 0
        fi
    done
    return 1
}

completion_file_path() {
    printf '%s' "$CONFIG_DIR/completion.bash"
}

completion_profile_path() {
    printf '%s' "$HOME/.bashrc"
}

write_completion_file() {
    ensure_dirs
    local target
    target="$(completion_file_path)"

    cat > "$target" <<'EOF_COMPLETION'
# GPush Bash completion
# Generated by: gp completion install

_gpush_completion_repo_names() {
    local cache="${XDG_CACHE_HOME:-$HOME/.cache}/gpush/repos"
    local aliases="${XDG_CONFIG_HOME:-$HOME/.config}/gpush/aliases"
    local path name alias_name alias_path
    local -A seen=()

    if [[ -f "$cache" ]]; then
        while IFS= read -r path || [[ -n "$path" ]]; do
            [[ -n "$path" ]] || continue
            name="${path##*/}"
            if [[ -n "$name" && -z "${seen[$name]+x}" ]]; then
                seen[$name]=1
                printf '%s\n' "$name"
            fi
        done < "$cache"
    fi

    if [[ -f "$aliases" ]]; then
        while IFS='|' read -r alias_name alias_path; do
            [[ -n "$alias_name" ]] || continue
            if [[ -z "${seen[$alias_name]+x}" ]]; then
                seen[$alias_name]=1
                printf '%s\n' "$alias_name"
            fi
        done < "$aliases"
    fi
}

_gpush_completion_add_matches() {
    local cur="$1"
    shift || true
    local value
    for value in "$@"; do
        if [[ "${value,,}" == "${cur,,}"* ]]; then
            COMPREPLY+=("$value")
        fi
    done
}

_gpush_complete() {
    COMPREPLY=()
    local cur="${COMP_WORDS[COMP_CWORD]}"
    local command="${COMP_WORDS[1]:-}"
    local action="${COMP_WORDS[2]:-}"
    local -a repos=()
    mapfile -t repos < <(_gpush_completion_repo_names)

    local -a top=(repo branch tag remote stash cache config alias favorite fav favorites all overview health stats history watch changes detail commit diff branches github menu settings activity project clone recent update completion help version add remove set reset)
    local -a config_all=(search-root protected-branch ignored-directory default-remote large-file-threshold)
    local -a config_lists=(search-root protected-branch ignored-directory)
    local -a config_scalars=(default-remote large-file-threshold)

    if (( COMP_CWORD == 1 )); then
        _gpush_completion_add_matches "$cur" "${top[@]}" "${repos[@]}"
        return 0
    fi

    case "$command" in
        project)
            if (( COMP_CWORD == 2 )); then _gpush_completion_add_matches "$cur" info build test run open shell
            elif (( COMP_CWORD == 3 )); then _gpush_completion_add_matches "$cur" "${repos[@]}"; fi
            ;;
        repo)
            if (( COMP_CWORD == 2 )); then _gpush_completion_add_matches "$cur" status diff log open fetch pull sync
            elif (( COMP_CWORD == 3 )); then _gpush_completion_add_matches "$cur" "${repos[@]}"; fi
            ;;
        branch)
            if (( COMP_CWORD == 2 )); then _gpush_completion_add_matches "$cur" list new switch delete prune graph
            elif (( COMP_CWORD >= 3 )); then _gpush_completion_add_matches "$cur" "${repos[@]}"; fi
            ;;
        tag)
            if (( COMP_CWORD == 2 )); then _gpush_completion_add_matches "$cur" list create push delete release
            elif (( COMP_CWORD >= 3 )); then _gpush_completion_add_matches "$cur" "${repos[@]}"; fi
            ;;
        remote)
            if (( COMP_CWORD == 2 )); then _gpush_completion_add_matches "$cur" list add set-url remove
            elif (( COMP_CWORD >= 3 )); then _gpush_completion_add_matches "$cur" "${repos[@]}"; fi
            ;;
        stash)
            if (( COMP_CWORD == 2 )); then _gpush_completion_add_matches "$cur" push list pop
            elif (( COMP_CWORD >= 3 )); then _gpush_completion_add_matches "$cur" "${repos[@]}"; fi
            ;;
        cache)
            if (( COMP_CWORD == 2 )); then _gpush_completion_add_matches "$cur" list refresh add
            elif [[ "$action" == add && $COMP_CWORD -eq 3 ]]; then mapfile -t COMPREPLY < <(compgen -d -- "$cur"); fi
            ;;
        config)
            if (( COMP_CWORD == 2 )); then _gpush_completion_add_matches "$cur" show path doctor add remove set reset
            elif (( COMP_CWORD == 3 )); then
                case "$action" in
                    add) _gpush_completion_add_matches "$cur" "${config_all[@]}" ;;
                    remove) _gpush_completion_add_matches "$cur" "${config_lists[@]}" ;;
                    set) _gpush_completion_add_matches "$cur" "${config_scalars[@]}" ;;
                    reset) _gpush_completion_add_matches "$cur" "${config_all[@]}" ;;
                esac
            fi
            ;;
        add) (( COMP_CWORD == 2 )) && _gpush_completion_add_matches "$cur" "${config_all[@]}" ;;
        remove) (( COMP_CWORD == 2 )) && _gpush_completion_add_matches "$cur" "${config_lists[@]}" ;;
        set) (( COMP_CWORD == 2 )) && _gpush_completion_add_matches "$cur" "${config_scalars[@]}" ;;
        reset) (( COMP_CWORD == 2 )) && _gpush_completion_add_matches "$cur" "${config_all[@]}" ;;
        alias)
            if (( COMP_CWORD == 2 )); then _gpush_completion_add_matches "$cur" list set remove
            elif (( COMP_CWORD >= 3 )); then _gpush_completion_add_matches "$cur" "${repos[@]}"; fi
            ;;
        favorite|fav)
            if (( COMP_CWORD == 2 )); then _gpush_completion_add_matches "$cur" list add remove
            elif (( COMP_CWORD == 3 )); then _gpush_completion_add_matches "$cur" "${repos[@]}"; fi
            ;;
        all) if (( COMP_CWORD == 2 )); then _gpush_completion_add_matches "$cur" status fetch sync push dry-run; elif [[ "$action" == status ]]; then _gpush_completion_add_matches "$cur" --json --dirty --ahead --behind; fi ;;
        changes|detail|commit|diff|branches|github) _gpush_completion_add_matches "$cur" "${repos[@]}" ;;
        update) (( COMP_CWORD == 2 )) && _gpush_completion_add_matches "$cur" check install rollback ;;
        completion) (( COMP_CWORD == 2 )) && _gpush_completion_add_matches "$cur" install status uninstall ;;
        clone)
            if (( COMP_CWORD >= 3 )); then mapfile -t COMPREPLY < <(compgen -d -- "$cur"); fi
            ;;
    esac
}

complete -F _gpush_complete gp
EOF_COMPLETION
}

remove_completion_profile_block() {
    local profile="$1"
    [[ -f "$profile" ]] || return 0
    local tmp="$profile.gpush.tmp"
    awk '
        $0 == "# >>> GPush completion >>>" { skip=1; next }
        $0 == "# <<< GPush completion <<<" { skip=0; next }
        !skip { print }
    ' "$profile" > "$tmp" && mv "$tmp" "$profile"
}

handle_completion() {
    local action="${1:-status}"
    local file profile
    file="$(completion_file_path)"
    profile="$(completion_profile_path)"

    case "$action" in
        install)
            [[ $# -le 1 ]] || {
                err "Command 'gp completion install' does not accept additional arguments."
                return 2
            }
            write_completion_file || return 1
            touch "$profile" || return 1
            remove_completion_profile_block "$profile"
            {
                printf '\n# >>> GPush completion >>>\n'
                printf '[[ -f %q ]] && source %q\n' "$file" "$file"
                printf '# <<< GPush completion <<<\n'
            } >> "$profile"
            banner
            section 'Bash completion'
            ok 'GPush Bash completion installed.'
            kv Completion "$file" "$C_GRAY"
            kv Profile "$profile" "$C_GRAY"
            dim "Reload Bash or run: source '$file'"
            ;;
        status)
            [[ $# -le 1 ]] || {
                err "Command 'gp completion status' does not accept additional arguments."
                return 2
            }
            banner
            section 'Bash completion'
            if [[ -f "$file" ]] && [[ -f "$profile" ]] && grep -Fq '# >>> GPush completion >>>' "$profile"; then
                kv Health OK "$C_GREEN"
            else
                kv Health 'Needs attention' "$C_YELLOW"
            fi
            kv Completion "$file" "$C_GRAY"
            kv Profile "$profile" "$C_GRAY"
            kv Registered "$(if [[ -f "$profile" ]] && grep -Fq '# >>> GPush completion >>>' "$profile"; then printf Yes; else printf No; fi)"
            ;;
        uninstall)
            [[ $# -le 1 ]] || {
                err "Command 'gp completion uninstall' does not accept additional arguments."
                return 2
            }
            rm -f "$file"
            remove_completion_profile_block "$profile"
            banner
            section 'Bash completion'
            ok 'GPush Bash completion removed.'
            dim 'Open a new Bash session to clear the currently loaded completion function.'
            ;;
        *)
            local -a options=(install status uninstall)
            local best='' best_distance=999 candidate distance
            for candidate in "${options[@]}"; do
                distance="$(levenshtein "$action" "$candidate")"
                if (( distance < best_distance )); then
                    best_distance=$distance
                    best="$candidate"
                fi
            done
            err "Unknown completion command: $action"
            (( best_distance <= 2 )) && dim "Did you mean: gp completion $best"
            dim 'Use: gp completion install|status|uninstall'
            return 2
            ;;
    esac
}

# Visual commands use cached repositories and never modify Git history.
visual_snapshot() (
    local repository="$1" branch commit dirty counts ahead=- behind=- state=Unknown upstream remote
    cd "$repository" || return 1
    branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || printf detached)
    commit=$(git log -1 --format=%s 2>/dev/null || printf '-')
    dirty=$(git status --porcelain --untracked-files=all) || return 1
    upstream=$(git rev-parse --symbolic-full-name '@{u}' 2>/dev/null || true)
    if [[ -z "$upstream" ]]; then
        remote=$(git config --get "branch.$branch.remote" || current_remote || true)
        if [[ "$branch" == detached ]]; then
            state='Detached HEAD'
        elif [[ -z "$remote" ]]; then
            state='No remote'
        elif [[ "$remote" == . ]]; then
            state='Local upstream'
        elif git config --get "branch.$branch.merge" >/dev/null; then
            state='Missing upstream'
        elif git show-ref --verify --quiet "refs/remotes/$remote/$branch"; then
            upstream="refs/remotes/$remote/$branch"
        else state='New remote branch'; fi
    fi
    if [[ -n "$upstream" ]] && counts=$(git rev-list --left-right --count "HEAD...$upstream" 2>/dev/null); then
        read -r ahead behind <<< "$counts"
        if (( ahead && behind )); then
            state=Diverged
        elif (( ahead )); then
            state=Ahead
        elif (( behind )); then
            state=Behind
        else
            state='Up to date'
        fi
    fi
    printf '%s\0' "${repository##*/}" "$branch" "$commit" "$behind" "$ahead" "$(if [[ -n "$dirty" ]]; then printf '%s' "$(printf '%s\n' "$dirty" | wc -l)"; else printf 0; fi)" "$state" "$repository"
)
visual_rows() {
