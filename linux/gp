                ;;
            --tag-push)
                translated_args=(tag push)
                shift
                translated_args+=("$@")
                break
                ;;
            --tag-delete)
                translated_args=(tag delete)
                shift
                translated_args+=("$@")
                break
                ;;
            --release)
                translated_args=(tag release)
                shift
                translated_args+=("$@")
                break
                ;;
            --open)
                translated_args=(repo open)
                shift
                translated_args+=("$@")
                break
                ;;
            --clone)
                translated_args=(clone)
                shift
                translated_args+=("$@")
                break
                ;;
            --recent)
                translated_args=(recent)
                shift
                break
                ;;
            --aliases)
                translated_args=(alias list)
                shift
                break
                ;;
            --favorites)
                translated_args=(favorite list)
                shift
                break
                ;;
            --doctor)
                translated_args=(config doctor)
                shift
                break
                ;;
            --config)
                translated_args=(config show)
                shift
                break
                ;;
            --config-path)
                translated_args=(config path)
                shift
                break
                ;;
            --all)
                translated_args=(all)
                shift
                translated_args+=("$@")
                break
                ;;
            --dry-run)
                LEGACY_DRY=true
                shift
