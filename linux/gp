        all) (( COMP_CWORD == 2 )) && _gpush_completion_add_matches "$cur" status fetch sync ;;
        update) (( COMP_CWORD == 2 )) && _gpush_completion_add_matches "$cur" check install rollback ;;
        completion) (( COMP_CWORD == 2 )) && _gpush_completion_add_matches "$cur" install status uninstall ;;
        clone)
            if (( COMP_CWORD >= 3 )); then mapfile -t COMPREPLY < <(compgen -d -- "$cur"); fi
            ;;
    esac
}

complete -F _gpush_complete gp
EOF_COMPLETION
}

remove_completion_profile_block() {
    local profile="$1"
    [[ -f "$profile" ]] || return 0
    local tmp="$profile.gpush.tmp"
    awk '
        $0 == "# >>> GPush completion >>>" { skip=1; next }
        $0 == "# <<< GPush completion <<<" { skip=0; next }
        !skip { print }
    ' "$profile" > "$tmp" && mv "$tmp" "$profile"
}

handle_completion() {
    local action="${1:-status}"
    local file profile
    file="$(completion_file_path)"
    profile="$(completion_profile_path)"

    case "$action" in
        install)
            [[ $# -le 1 ]] || { err "Command 'gp completion install' does not accept additional arguments."; return 2; }
            write_completion_file || return 1
            touch "$profile" || return 1
            remove_completion_profile_block "$profile"
            {
                printf '\n# >>> GPush completion >>>\n'
                printf '[[ -f %q ]] && source %q\n' "$file" "$file"
                printf '# <<< GPush completion <<<\n'
            } >> "$profile"
            banner
            section 'Bash completion'
            ok 'GPush Bash completion installed.'
            kv Completion "$file" "$C_GRAY"
            kv Profile "$profile" "$C_GRAY"
            dim "Reload Bash or run: source '$file'"
            ;;
        status)
            [[ $# -le 1 ]] || { err "Command 'gp completion status' does not accept additional arguments."; return 2; }
            banner
            section 'Bash completion'
            if [[ -f "$file" ]] && [[ -f "$profile" ]] && grep -Fq '# >>> GPush completion >>>' "$profile"; then
                kv Health OK "$C_GREEN"
            else
                kv Health 'Needs attention' "$C_YELLOW"
            fi
            kv Completion "$file" "$C_GRAY"
            kv Profile "$profile" "$C_GRAY"
            kv Registered "$(if [[ -f "$profile" ]] && grep -Fq '# >>> GPush completion >>>' "$profile"; then printf Yes; else printf No; fi)"
            ;;
        uninstall)
            [[ $# -le 1 ]] || { err "Command 'gp completion uninstall' does not accept additional arguments."; return 2; }
            rm -f "$file"
            remove_completion_profile_block "$profile"
            banner
            section 'Bash completion'
            ok 'GPush Bash completion removed.'
            dim 'Open a new Bash session to clear the currently loaded completion function.'
            ;;
        *)
            local -a options=(install status uninstall)
            local best='' best_distance=999 candidate distance
            for candidate in "${options[@]}"; do
                distance="$(levenshtein "$action" "$candidate")"
                if (( distance < best_distance )); then best_distance=$distance; best="$candidate"; fi
            done
            err "Unknown completion command: $action"
            (( best_distance <= 2 )) && dim "Did you mean: gp completion $best"
            dim 'Use: gp completion install|status|uninstall'
            return 2
            ;;
    esac
}

main() {
    load_config

    if [[ $# -eq 0 ]]; then
        quick_select_repo || return 0
        remember_recent "$SELECTED"
        classic_commit "$SELECTED" "" false false
        return $?
    fi

    if [[ "$1" == -* ]]; then
        translate_legacy "$@"
        set -- "${TRANSLATED[@]}"
    fi

    local command_name="$1"
    shift || true

    case "$command_name" in
        help)
            show_help
            ;;
        version)
            printf 'GPush %s\n' "$SCRIPT_VERSION"
            ;;
        config)
            handle_config "$@"
            ;;
        cache)
            handle_cache "$@"
            ;;
        recent)
            handle_recent
            ;;
        project)
            handle_project "$@"
            ;;
        update)
            handle_update "$@"
            ;;
        completion)
            handle_completion "$@"
            ;;
        add|remove|set)
            [[ $# -eq 2 ]] || { err "Command 'gp $command_name' requires a configuration key and a value."; config_edit_usage; return 2; }
            handle_config_edit "$command_name" "$1" "$2"
            ;;
        reset)
            [[ $# -eq 1 ]] || { err "Command 'gp reset' requires exactly one configuration key."; config_edit_usage; return 2; }
            handle_config_edit reset "$1"
            ;;
        clone)
            handle_clone "$@"
            ;;
        alias)
            handle_alias "$@"
            ;;
        favorite|fav)
            handle_favorite "$@"
            ;;
        favorites)
            handle_favorite list
            ;;
        all)
            handle_all "$@"
            ;;
        repo)
            handle_repo "$@"
            ;;
        branch)
            handle_branch "$@"
            ;;
        remote)
            handle_remote "$@"
            ;;
        stash)
            handle_stash "$@"
            ;;
        tag)
            handle_tag "$@"
            ;;
        *)
            # Keep the classic shortcut: gp Project "message".
            # If the first token is not a known repository and looks like a
            # command typo, fail early with a useful suggestion.
            if ! known_repository_token "$command_name"; then
                local suggestion
                suggestion="$(command_suggestion "$command_name" 2>/dev/null || true)"
                if [[ -n "$suggestion" ]]; then
                    err "Unknown command: $command_name"
                    dim "Did you mean: $suggestion"
                    return 2
                fi
            fi

            select_repo "$command_name" || return 1
            remember_recent "$SELECTED"

            local classic_message="$*"
            classic_commit \
                "$SELECTED" \
                "$classic_message" \
                "${LEGACY_DRY:-false}" \
                "${LEGACY_NOPUSH:-false}"
            ;;
    esac
}

main "$@"
