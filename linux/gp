    local first_sln="" first_csproj=""
    first_sln="$(find "$path" -maxdepth 1 -type f -name '*.sln' -print -quit 2>/dev/null || true)"
    first_csproj="$(find "$path" -maxdepth 1 -type f -name '*.csproj' -print -quit 2>/dev/null || true)"
    if [[ -n "$first_sln" || -n "$first_csproj" ]]; then
        PROJECT_TYPES+=(".NET")
        if [[ -n "$first_sln" ]]; then PROJECT_MANIFESTS+=("$(basename "$first_sln")"); else PROJECT_MANIFESTS+=("$(basename "$first_csproj")"); fi
    fi
    [[ -f "$path/package.json" ]] && { PROJECT_TYPES+=("Node"); PROJECT_MANIFESTS+=("package.json"); }
    if [[ -f "$path/pyproject.toml" ]]; then PROJECT_TYPES+=("Python"); PROJECT_MANIFESTS+=("pyproject.toml")
    elif [[ -f "$path/requirements.txt" ]]; then PROJECT_TYPES+=("Python"); PROJECT_MANIFESTS+=("requirements.txt"); fi
