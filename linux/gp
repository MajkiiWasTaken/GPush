project_detect() {
    local path="$1"
    PROJECT_TYPES=()
    PROJECT_MANIFESTS=()
    [[ -f "$path/Cargo.toml" ]] && { PROJECT_TYPES+=("Rust"); PROJECT_MANIFESTS+=("Cargo.toml"); }
    local first_sln="" first_csproj=""
    first_sln="$(find "$path" -maxdepth 1 -type f -name '*.sln' -print -quit 2>/dev/null || true)"
    first_csproj="$(find "$path" -maxdepth 1 -type f -name '*.csproj' -print -quit 2>/dev/null || true)"
    if [[ -n "$first_sln" || -n "$first_csproj" ]]; then
        PROJECT_TYPES+=(".NET")
        if [[ -n "$first_sln" ]]; then PROJECT_MANIFESTS+=("$(basename "$first_sln")"); else PROJECT_MANIFESTS+=("$(basename "$first_csproj")"); fi
    fi
    [[ -f "$path/package.json" ]] && { PROJECT_TYPES+=("Node"); PROJECT_MANIFESTS+=("package.json"); }
    if [[ -f "$path/pyproject.toml" ]]; then PROJECT_TYPES+=("Python"); PROJECT_MANIFESTS+=("pyproject.toml")
    elif [[ -f "$path/requirements.txt" ]]; then PROJECT_TYPES+=("Python"); PROJECT_MANIFESTS+=("requirements.txt"); fi
    [[ -f "$path/CMakeLists.txt" ]] && { PROJECT_TYPES+=("C/C++"); PROJECT_MANIFESTS+=("CMakeLists.txt"); }
    [[ ${#PROJECT_TYPES[@]} -eq 0 ]] && PROJECT_TYPES+=("Generic")
}
node_runner() { local path="$1"; [[ -f "$path/pnpm-lock.yaml" ]] && { printf 'pnpm'; return; }; [[ -f "$path/yarn.lock" ]] && { printf 'yarn'; return; }; printf 'npm'; }
node_has_script() {
    local path="$1" name="$2"
    if command -v python3 >/dev/null 2>&1; then
        python3 - "$path/package.json" "$name" <<'PY_NODE' >/dev/null 2>&1
import json,sys
try:
    with open(sys.argv[1],encoding='utf-8') as f: p=json.load(f)
    raise SystemExit(0 if sys.argv[2] in p.get('scripts',{}) else 1)
except Exception:
    raise SystemExit(1)
PY_NODE
        return $?
    fi
    grep -Eq '"'"$name"'"[[:space:]]*:' "$path/package.json" 2>/dev/null
}
project_python() {
    local path="$1"
    [[ -x "$path/.venv/bin/python" ]] && { printf '%s' "$path/.venv/bin/python"; return; }
    command -v python3 >/dev/null 2>&1 && { printf 'python3'; return; }
    command -v python >/dev/null 2>&1 && { printf 'python'; return; }
    return 1
}
handle_project() {
    local action="${1:-info}"; shift || true
    local project="${1:-}"
    case "$action" in info|build|test|run|open|shell) ;; *) err "Unknown project action: $action"; dim 'Use: gp project info|build|test|run|open|shell [project]'; return 2;; esac
    [[ $# -le 1 ]] || { err 'Project command accepts at most one project.'; return 2; }
    select_repo "$project" || return 1
    remember_recent "$SELECTED"
    project_detect "$SELECTED"
    local branch="-"; branch="$(git -C "$SELECTED" branch --show-current 2>/dev/null || true)"; [[ -n "$branch" ]] || branch='-'
    banner; section 'Project'
    kv Name "$(repo_name "$SELECTED")"; kv Path "$SELECTED" "$C_GRAY"; kv Type "$(IFS=' + '; echo "${PROJECT_TYPES[*]}")"
    if [[ ${#PROJECT_MANIFESTS[@]} -gt 0 ]]; then kv Manifest "$(IFS=', '; echo "${PROJECT_MANIFESTS[*]}")"; else kv Manifest '-'; fi
    kv 'Git branch' "$branch" "$C_MAGENTA"
    case "$action" in
        info) section 'Available'; dim '  info    Detect project type and metadata.'; dim '  build   Build using the detected toolchain.'; dim '  test    Run project tests.'; dim '  run     Run when a safe default can be detected.'; dim '  open    Open project folder with xdg-open.'; dim '  shell   Start an interactive shell in the project.'; return 0;;
        open) command -v xdg-open >/dev/null 2>&1 || { err 'xdg-open was not found.'; return 1; }; xdg-open "$SELECTED" >/dev/null 2>&1 & disown || true; ok 'Opened project folder.'; return 0;;
        shell) cd "$SELECTED" || return 1; local shell_bin="${SHELL:-/bin/bash}"; [[ -x "$shell_bin" ]] || shell_bin=/bin/bash; exec "$shell_bin" -i;;
    esac
    cd "$SELECTED" || return 1
    if printf '%s\n' "${PROJECT_TYPES[@]}" | grep -Fxq 'Rust'; then command -v cargo >/dev/null 2>&1 || { err 'cargo was not found.'; return 127; }; case "$action" in build) cargo build;; test) cargo test;; run) cargo run;; esac; return $?; fi
    if printf '%s\n' "${PROJECT_TYPES[@]}" | grep -Fxq '.NET'; then
        command -v dotnet >/dev/null 2>&1 || { err 'dotnet was not found.'; return 127; }
        local target=""; target="$(find . -maxdepth 1 -type f \( -name '*.sln' -o -name '*.csproj' \) -print -quit | sed 's#^./##')"
        case "$action" in
            build)
                if [[ -n "$target" ]]; then dotnet build "$target"; else dotnet build; fi
                ;;
            test)
                if [[ -n "$target" ]]; then dotnet test "$target"; else dotnet test; fi
                ;;
            run)
                if [[ "$target" == *.csproj ]]; then dotnet run --project "$target"; else dotnet run; fi
                ;;
        esac
        return $?
    fi
    if printf '%s\n' "${PROJECT_TYPES[@]}" | grep -Fxq 'Node'; then
        local runner; runner="$(node_runner "$SELECTED")"; command -v "$runner" >/dev/null 2>&1 || { err "$runner was not found."; return 127; }
        case "$action" in build) node_has_script "$SELECTED" build || { err "package.json does not define 'build'."; return 1; }; "$runner" run build;; test) node_has_script "$SELECTED" test || { err "package.json does not define 'test'."; return 1; }; "$runner" test;; run) if node_has_script "$SELECTED" dev; then "$runner" run dev; elif node_has_script "$SELECTED" start; then "$runner" start; else err "No 'dev' or 'start' script found."; return 1; fi;; esac; return $?
    fi
    if printf '%s\n' "${PROJECT_TYPES[@]}" | grep -Fxq 'Python'; then
        local py; py="$(project_python "$SELECTED")" || { err 'Python was not found.'; return 127; }
        case "$action" in build) if [[ -f pyproject.toml ]]; then "$py" -m build; else "$py" -m compileall .; fi;; test) "$py" -m pytest;; run) if [[ -f main.py ]]; then "$py" main.py; elif [[ -f app.py ]]; then "$py" app.py; else err 'No main.py or app.py found.'; return 1; fi;; esac; return $?
    fi
    if printf '%s\n' "${PROJECT_TYPES[@]}" | grep -Fxq 'C/C++'; then command -v cmake >/dev/null 2>&1 || { err 'cmake was not found.'; return 127; }; case "$action" in build) cmake -S . -B build && cmake --build build;; test) command -v ctest >/dev/null 2>&1 || { err 'ctest was not found.'; return 127; }; ctest --test-dir build --output-on-failure;; run) err 'A generic CMake project has no safe automatic run target.'; return 1;; esac; return $?; fi
    err "Action '$action' is not available for this project type."; return 1
}
