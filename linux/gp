        case "$WORKSPACE_KEY" in
            esc) return 1;;
            up) if (( ${#visible[@]} )); then
                selected=$(( (selected+${#visible[@]}-1)%${#visible[@]} ))
            fi
            ;;
            down) if (( ${#visible[@]} )); then
                selected=$(( (selected+1)%${#visible[@]} ))
            fi
            ;;
            /) read -r -p 'Search (empty resets): ' query || return 1
            selected=0
            ;;
            ' ') if [[ "$multiple" == true ]]; then
                if (( ${#visible[@]} )); then
                    key=${visible[selected]}
                    marks[key]=$((1-${marks[key]:-0}))
                fi
            else
                query+=' '
                selected=0
            fi
            ;;
            a|A) if [[ "$multiple" == true ]]; then
                for key in "${visible[@]}"; do
                    marks[key]=1
                done
            else
                query+="$WORKSPACE_KEY"
                selected=0
            fi
            ;;
            x|X) if [[ "$multiple" == true ]]; then
                marks=()
            else
                query+="$WORKSPACE_KEY"
                selected=0
            fi
            ;;
            enter) if [[ "$multiple" == true ]]; then
                for i in "${!rows[@]}"; do
                    if [[ ${marks[i]:-0} == 1 ]]; then
                        WORKSPACE_SELECTION+=("$i")
                    fi
                done
            elif (( ${#visible[@]} )); then
                WORKSPACE_SELECTION=("${visible[selected]}")
            fi
            if (( ${#WORKSPACE_SELECTION[@]} == 0 && ${#visible[@]} > 0 )); then
                WORKSPACE_SELECTION=("${visible[selected]}")
            fi
            if (( ${#WORKSPACE_SELECTION[@]} )); then
                return 0
            fi
            ;;
            $'\177'|$'\b') query=${query%?}
            selected=0
            ;;
            *) if [[ "$multiple" != true && "$WORKSPACE_KEY" == [[:print:]] ]]; then
                query+="$WORKSPACE_KEY"
                selected=0
            fi
            ;;
        esac
    done
}
workspace_view_lines() {
    local title="$1"; shift
    local -a content=("$@")
    local offset=0 height page i last
    while true; do
        height=$(tput lines 2>/dev/null || printf 24)
        [[ "$height" =~ ^[0-9]+$ ]] || height=24
        page=$((height>8?height-8:1))
        last=$((offset+page))
        if (( last > ${#content[@]} )); then
            last=${#content[@]}
        fi
        printf '\033[H\033[2J'; section "$title"
        for ((i=offset;i<last;i++)); do
            printf '%s%s\n' "${content[i]}" "$C_RESET"
        done
        dim "Lines $((offset+1))-$last / ${#content[@]} | Up/Down: scroll | Esc: back"
        workspace_key
        case "$WORKSPACE_KEY" in
            esc) return 0;;
            up) if ((offset>0)); then
                offset=$((offset-1))
            fi
            ;;
            down) if ((offset+page<${#content[@]})); then
                offset=$((offset+1))
            fi
            ;;
        esac
    done
}
workspace_diff() (
    local path="$1" color=never file temp diff_text part rc flag name
    local -a files=() lines=() staged=() tracked=() untracked=() rows=()
    cd "$path" || return 1
    if [[ -n "$C_CYAN" ]]; then color=always; fi
    if [[ ! -t 0 || ! -t 1 ]]; then
        git --no-pager diff --no-ext-diff --no-textconv "--color=$color" --cached -- || return 1
        git --no-pager diff --no-ext-diff --no-textconv "--color=$color" -- || return 1
        git ls-files --others --exclude-standard
        return
    fi
    temp=$(mktemp) || return 1
    trap 'rm -f -- "$temp"' EXIT
    git diff --cached --no-renames --name-only -z -- > "$temp" || return 1
    mapfile -d '' -t staged < "$temp"
    git diff --no-renames --name-only -z -- > "$temp" || return 1
    mapfile -d '' -t tracked < "$temp"
    git ls-files --others --exclude-standard -z > "$temp" || return 1
    mapfile -d '' -t untracked < "$temp"
    if (( ${#staged[@]} + ${#tracked[@]} + ${#untracked[@]} == 0 )); then
        ok 'No changes.'
        workspace_pause
        return 0
    fi
    mapfile -d '' -t files < <(printf '%s\0' "${staged[@]}" "${tracked[@]}" "${untracked[@]}" | sort -zu)
    for file in "${files[@]}"; do
        flag=''
        for name in "${staged[@]}"; do
            if [[ "$file" == "$name" ]]; then
                flag=S
                break
            fi
        done
        for name in "${tracked[@]}"; do
            if [[ "$file" == "$name" ]]; then
                flag+=M
                break
            fi
        done
        for name in "${untracked[@]}"; do
            if [[ "$file" == "$name" ]]; then
                flag='?'
                break
            fi
        done
        rows+=("[$flag] $file")
    done
    while workspace_pick "Diff / ${path##*/}" false "${rows[@]}"; do
        file=${files[WORKSPACE_SELECTION[0]]}
        diff_text=''
        flag=''
        for name in "${untracked[@]}"; do
            if [[ "$file" == "$name" ]]; then
                flag='?'
                break
            fi
        done
        if [[ "$flag" == '?' ]]; then
            rc=0
            diff_text=$(git --no-pager diff --no-index --no-ext-diff --no-textconv "--color=$color" -- /dev/null "./$file") || rc=$?
            if ((rc > 1)); then
                err 'Cannot read untracked file.'
                workspace_pause
                continue
            fi
        else
            part=$(git --literal-pathspecs --no-pager diff --no-ext-diff --no-textconv "--color=$color" --cached -- "$file") || {
                err 'Cannot read staged diff.'
                workspace_pause
                continue
            }
            if [[ -n "$part" ]]; then
                diff_text=$'--- Staged changes ---\n'"$part"$'\n'
            fi
            part=$(git --literal-pathspecs --no-pager diff --no-ext-diff --no-textconv "--color=$color" -- "$file") || {
                err 'Cannot read working tree diff.'
                workspace_pause
                continue
            }
            if [[ -n "$part" ]]; then
                diff_text+=$'--- Working tree changes ---\n'"$part"
            fi
        fi
        mapfile -t lines <<< "${diff_text:-No changes remain in this file. Reopen the diff to refresh.}"
        workspace_view_lines "Diff / ${file//[[:cntrl:]]/?}" "${lines[@]}"
    done
)
workspace_commit() (
    local path="$1" message index file name marker marker_path index_before index_now temp allow=false
    local -a files=() chosen=() untracked=() new_files=() staged=() tracked=() rows=()
    local flag
    cd "$path" || return 1
    [[ -t 0 && -t 1 ]] || {
        err 'Interactive terminal required.'
        return 2
    }
    for marker in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD rebase-merge rebase-apply sequencer BISECT_START; do
        marker_path=$(git rev-parse --git-path "$marker") || return 1
        [[ ! -e "$marker_path" ]] || {
            err 'Git operation in progress.'
            return 1
        }
    done
    git symbolic-ref --quiet HEAD >/dev/null || return 1
    index_before=$(git write-tree) || return 1
    temp=$(mktemp) || return 1
    trap 'rm -f -- "$temp"' EXIT
    {
        git diff --no-renames --name-only -z && git diff --cached --no-renames --name-only -z && git ls-files --others --exclude-standard -z
    } > "$temp" || return 1
    mapfile -d '' -t files < <(sort -zu "$temp")
    git ls-files --others --exclude-standard -z > "$temp" || return 1
    mapfile -d '' -t untracked < "$temp"
    git diff --cached --no-renames --name-only -z -- > "$temp" || return 1
    mapfile -d '' -t staged < "$temp"
    git diff --no-renames --name-only -z -- > "$temp" || return 1
    mapfile -d '' -t tracked < "$temp"
    (( ${#files[@]} > 0 )) || {
        ok 'No changes.'
        return 0
    }
    for file in "${files[@]}"; do
        flag=''
        for name in "${staged[@]}"; do
            if [[ "$file" == "$name" ]]; then
                flag=S
                break
            fi
        done
        for name in "${tracked[@]}"; do
            if [[ "$file" == "$name" ]]; then
                flag+=M
                break
            fi
        done
        for name in "${untracked[@]}"; do
            if [[ "$file" == "$name" ]]; then
                flag='?'
                break
            fi
        done
        rows+=("[$flag] $file")
    done
    workspace_pick "Commit manager / ${path##*/}" true "${rows[@]}" || return 0
    for index in "${WORKSPACE_SELECTION[@]}"; do
        chosen+=("${files[index]}")
    done
    for file in "${chosen[@]}"; do
        name=${file##*/}; name=${name,,}
        case "$name" in
            .env.example|.env.sample|.env.template)
            ;;
            .env|.env.*|*.pem|*.key|*.pfx|*.p12|id_rsa|id_ed25519|id_ecdsa|id_dsa|secrets*|credentials*|service-account*.json)
                err "Risky file: $file"
                return 1
            ;;
        esac
        if [[ -f "$file" ]] && (( $(wc -c < "$file") >= LARGE_FILE_MB * 1048576 )); then
            err "Large file: $file"
            return 1
        fi
    done
    section "Selected files (${#chosen[@]})"
    for file in "${chosen[@]}"; do
        printf '  %s\n' "${file//[[:cntrl:]]/?}"
    done
    read -r -p 'Commit message: ' message || return 0
    [[ -n "${message//[[:space:]]/}" ]] || return 0
    confirm 'Commit selected working-tree versions? Other staged files stay staged.' || return 0
    index_now=$(git write-tree) || return 1
    if [[ "$index_now" != "$index_before" ]]; then
        err 'Staging area changed. Restart commit manager.'
        return 1
    fi
    for file in "${chosen[@]}"; do
        for name in "${untracked[@]}"; do
            if [[ "$file" == "$name" ]]; then
                new_files+=("$file")
                break
            fi
        done
    done
    if (( ${#new_files[@]} )); then
        git --literal-pathspecs add -- "${new_files[@]}" || return 1
    fi
    git --literal-pathspecs commit --only -m "$message" -- "${chosen[@]}" || return 1
    workspace_log commit "$path"
    if confirm 'Push committed changes now (leave other files untouched)?'; then
        if confirm 'Allow pushing to protected branches? (main/master/release)'; then
            allow=true
        fi
        bulk_sync "$path" "$allow" '' true || return 1
        workspace_log push "$path"
    fi
)
workspace_branches() (
    local path="$1" action branch
    local -a branches=()
    while true; do
        section "Branches / ${path##*/}"
        git -C "$path" branch -vv || return 1
        [[ -t 0 && -t 1 ]] || return 0
        dim '[N] New  [S] Switch  [D] Delete merged  [G] Graph  [Q/Esc] Back'
        workspace_key; action=$WORKSPACE_KEY
        case "${action,,}" in
            n|s|d) if [[ "${action,,}" == n ]]; then
                read -r -p 'Branch name: ' branch || return 0
            else
                mapfile -t branches < <(git -C "$path" for-each-ref --format='%(refname:short)' refs/heads)
                workspace_pick 'Select local branch' false "${branches[@]}" || continue
                branch=${branches[WORKSPACE_SELECTION[0]]}
                fi
                git check-ref-format --branch "$branch" >/dev/null 2>&1 || {
                    err 'Invalid branch name.'
                    continue
                }
                [[ "$branch" != -* ]] || continue
                case "${action,,}" in
                    n) if confirm "Create $branch?"; then
                        git -C "$path" switch -c "$branch" && workspace_log branch-new "$path"
                    fi
                    ;;
                    s) if confirm "Switch to $branch?"; then
                        git -C "$path" switch "$branch" && workspace_log branch-switch "$path"
                    fi
                    ;;
                    d) if protected_branch "$branch"; then
                        warn 'Protected branch.'
                    elif confirm "Delete merged branch $branch?"; then
                        git -C "$path" branch -d -- "$branch" && workspace_log branch-delete "$path"
                    fi
                    ;;
                esac;;
            g) git -C "$path" --no-pager log --graph --all --decorate --oneline -n 40
            workspace_pause
            ;;
            q|esc) return 0;;
        esac
    done
)
workspace_github() (
    cd "$1" || return 1
    command -v gh >/dev/null || {
        err 'Install GitHub CLI (gh) and run gh auth login.'
        return 1
    }
    gh repo view || return 1
    gh issue list --limit 5
    gh pr list --limit 5
    gh release list --limit 5
    gh run list --limit 5
)
workspace_detail() {
    local path="$1" action
    while true; do
        if [[ -t 0 && -t 1 ]]; then
            printf '\033[H\033[2J'
        fi
        section "Repository detail / ${path##*/}"
        printf '%s\n' "$path"
        git -C "$path" status --short --branch
        git -C "$path" --no-pager log -5 --format='%h  %s  (%ar)'
        [[ -t 0 && -t 1 ]] || return 0
        dim '[C] Commit  [D] Diff  [B] Branches  [F] Fetch  [S] Sync  [G] GitHub  [Q/Esc] Back'
        workspace_key; action=$WORKSPACE_KEY
        case "${action,,}" in
            c) workspace_run_operation workspace_commit "$path"
            workspace_pause
            ;;
            d) workspace_diff "$path";;
            b) workspace_branches "$path";;
            f) workspace_run_operation overview_fetch "$path" && workspace_log fetch "$path"
            workspace_pause
            ;;
            s) if confirm 'Synchronize repository?'; then
                workspace_run_operation bulk_sync "$path" false '' && workspace_log sync "$path"
            fi
            workspace_pause
            ;;
            g) workspace_run_operation workspace_github "$path"
            workspace_pause
            ;;
            q|esc) return 0;;
        esac
    done
}
workspace_settings() {
    if [[ ! -t 0 || ! -t 1 ]]; then
        handle_config show
        return
    fi
    local key value action
    local -a keys=(default-remote large-file-threshold search-root protected-branch ignored-directory) labels=()
    while true; do
        labels=("Default Git remote  |  $DEFAULT_REMOTE" "Large file warning  |  $LARGE_FILE_MB MB" "Search directories  |  ${#SEARCH_ROOTS[@]} configured" "Protected branches  |  ${#PROTECTED_BRANCHES[@]} configured" "Ignored directories  |  ${#IGNORED_DIRS[@]} configured")
        workspace_pick 'Settings' false "${labels[@]}" || return 0
        workspace_clear_screen
        key=${keys[WORKSPACE_SELECTION[0]]}
        handle_config show
        case "$key" in
            default-remote|large-file-threshold) action='set'
            ;;
            *) read -r -p 'Action [add/remove/reset]: ' action || return 0
            case "$action" in
                add|remove|reset)
                ;;
                *)
                    continue
                ;;
            esac
            ;;
        esac
        value=''
        if [[ "$action" != reset ]]; then
            read -r -p 'Value (empty cancels): ' value || return 0
            [[ -n "$value" ]] || continue
        fi
        if confirm 'Save configuration?'; then
            handle_config_edit "$action" "$key" "$value"
        fi
        workspace_pause
    done
}
workspace_activity() {
    section 'Workspace activity / latest 30 operations'
    if [[ ! -f "$CONFIG_DIR/history.log" ]]; then
        dim 'No operations recorded yet.'
        return
    fi
    local stamp action rest
    while read -r stamp action rest; do
        printf '%s%s%s  %s%-14s%s %s\n' "$C_GRAY" "$stamp" "$C_RESET" "$C_CYAN" "$action" "$C_RESET" "$rest"
    done < <(tail -n 30 "$CONFIG_DIR/history.log")
}
# Main workspace: no Git or network operations while navigating menus.
workspace_choose_repo() {
    load_cache
    local -a paths=() labels=() others=()
    local path
    for path in "${CACHED_REPOS[@]}"; do
        if [[ -f "$FAVORITES_FILE" ]] && grep -Fxq -- "$path" "$FAVORITES_FILE"; then
            paths+=("$path")
        else
            others+=("$path")
        fi
    done
    paths+=("${others[@]}")
    if (( ${#paths[@]} == 0 )); then
        warn 'No cached repositories. Open Repository cache > Refresh first.'
        workspace_pause; return 1
    fi
    for path in "${paths[@]}"; do
        if [[ -f "$FAVORITES_FILE" ]] && grep -Fxq -- "$path" "$FAVORITES_FILE"; then
            labels+=("★ ${path##*/}  |  $path")
        else
            labels+=("${path##*/}  |  $path")
        fi
    done
    workspace_pick 'Select repository' false "${labels[@]}" || return 1
    MENU_REPO=${paths[WORKSPACE_SELECTION[0]]}
}
workspace_menu_repo_tools() {
    local path="$1" action name url message
    local -a labels=('Commit all changes (classic workflow)' 'List tags' 'Create annotated tag' 'Push tag' 'List remotes' 'Add remote' 'Change remote URL' 'Remove remote' 'List stashes' 'Stash changes' 'Restore latest stash' 'Project info' 'Build project' 'Test project' 'Run project' 'Open project shell' 'Back')
    while workspace_pick "Repository tools / ${path##*/}" false "${labels[@]}"; do
        action=${WORKSPACE_SELECTION[0]}
        workspace_clear_screen
        case "$action" in
            0) read -r -p 'Commit message (empty cancels): ' message || return 0
            if [[ -n "$message" ]] && confirm 'Commit all changes and push using classic workflow?'; then
                workspace_run_operation classic_commit "$path" "$message" false false
            fi
            ;;
            1) (handle_tag list "$path");;
            2|3) read -r -p 'Tag name (empty cancels): ' name || return 0
            [[ -n "$name" && "$name" != -* ]] || continue
                 if [[ "$action" == 2 ]]; then
                     read -r -p 'Tag message: ' message || return 0
                     if confirm "Create tag $name?"; then
                         (handle_tag create "$path" "$name" "$message")
                     fi
                 elif confirm "Push tag $name?"; then
                     (handle_tag push "$path" "$name")
                 fi
                 ;;
            4) (handle_remote list "$path");;
            5|6|7) read -r -p 'Remote name (empty cancels): ' name || return 0
            [[ -n "$name" && "$name" != -* ]] || continue
                   if [[ "$action" == 7 ]]; then
                       (handle_remote remove "$path" "$name")
                   else
                       read -r -p 'Remote URL (empty cancels): ' url || return 0
                       [[ -n "$url" && "$url" != -* ]] || continue
                        if [[ "$action" == 5 ]]; then
                            if confirm "Add remote $name?"; then
                                (handle_remote add "$path" "$name" "$url")
                            fi
                        else
                            (handle_remote set-url "$path" "$name" "$url")
                        fi
                   fi;;
            8) (handle_stash list "$path");;
            9) if confirm 'Stash tracked and untracked changes?'; then
                (handle_stash push "$path")
            fi
            ;;
            10) if confirm 'Apply and remove latest stash?'; then
                (handle_stash pop "$path")
            fi
            ;;
            11) (handle_project info "$path");;
            12) if confirm 'Build this project?'; then
                workspace_run_operation handle_project build "$path"
            fi
            ;;
            13) if confirm 'Run project tests?'; then
                workspace_run_operation handle_project test "$path"
            fi
            ;;
            14) if confirm 'Run this project?'; then
                workspace_run_operation handle_project run "$path"
            fi
            ;;
            15) (handle_project shell "$path");;
            16) return 0;;
        esac
        workspace_pause
    done
    return 0
}
workspace_menu_repo() {
    local path="$1" action
    local -a labels=('Commit selected files' 'Sync / push existing commits' 'Fetch remote references' 'Status and recent commits' 'Browse diff' 'Manage branches' 'Commit graph' 'GitHub information' 'Open repository folder' 'More repository tools' 'Push committed changes only' 'Back')
    while workspace_pick "Repository / ${path##*/}" false "${labels[@]}"; do
        action=${WORKSPACE_SELECTION[0]}
        workspace_clear_screen
        case "$action" in
            0) workspace_run_operation workspace_commit "$path"
            ;;
            1) if confirm 'Synchronize this repository?'; then
                   local allow=false
                   if confirm 'Allow pushing to protected branches as well?'; then
                       allow=true
                   fi
                   workspace_run_operation bulk_sync "$path" "$allow" '' && workspace_log sync "$path"
               fi;;
            2) workspace_run_operation overview_fetch "$path" && workspace_log fetch "$path"
            ;;
            3) workspace_detail "$path"; continue;;
            4) workspace_diff "$path"; continue;;
            5) workspace_branches "$path"; continue;;
            6) git -C "$path" --no-pager log --graph --all --decorate --oneline -n 40
            ;;
            7) workspace_run_operation workspace_github "$path"
            ;;
            8) (handle_repo open "$path");;
            9) workspace_menu_repo_tools "$path"
            continue
            ;;
            10) if confirm 'Push existing commits without changing working tree?'; then
                    local push_allow=false
                    if confirm 'Allow pushing to protected branches?'; then
                        push_allow=true
                    fi
                    workspace_run_operation bulk_sync "$path" "$push_allow" '' true && workspace_log push "$path"
                fi;;
            11) return 0;;
        esac
        workspace_pause
    done
    return 0
}
workspace_menu_bulk() {
    local -a labels=('Repository status (local)' 'Fetch all repositories' 'Synchronize all repositories' 'Commit and synchronize all repositories' 'Preview synchronization (dry-run)' 'Back')
    local action message
    local -a allow=()
    while workspace_pick 'Bulk operations' false "${labels[@]}"; do
        action=${WORKSPACE_SELECTION[0]}
        workspace_clear_screen
        case "$action" in
            0) visual_command overview; continue;;
            1) if confirm 'Fetch all cached repositories?'; then
                workspace_run_operation handle_all fetch
            fi
            ;;
            2|3)
                message=''; allow=()
                if [[ "$action" == 3 ]]; then
                    read -r -p 'Commit message (empty cancels): ' message || return 0
                    [[ -n "$message" ]] || continue
                fi
                if ! confirm 'Operate on all cached repositories?'; then
                    continue
                fi
                if confirm 'Allow pushing to protected branches as well?'; then
                    allow=(--allow-protected)
                fi
                if [[ "$action" == 3 ]]; then
                    workspace_run_operation handle_all push "${allow[@]}" -- "$message"
                else
                    workspace_run_operation handle_all sync "${allow[@]}"
                fi
                ;;
            4) visual_status dry-run;;
            5) return 0;;
        esac
        workspace_pause
    done
    return 0
}
workspace_favorites() {
    local -a paths=() labels=()
    local path choice
    while true; do
        load_cache
        paths=("${CACHED_REPOS[@]}")
        labels=()
        for path in "${paths[@]}"; do
            if [[ -f "$FAVORITES_FILE" ]] && grep -Fxq -- "$path" "$FAVORITES_FILE"; then
                labels+=("[★] ${path##*/}")
            else
                labels+=("[ ] ${path##*/}")
            fi
        done
        labels+=('Back')
        workspace_pick 'Favorites / Enter toggles, saved immediately' false "${labels[@]}" || return
        choice=${WORKSPACE_SELECTION[0]}
        ((choice<${#paths[@]})) || return 0
        path=${paths[choice]}; ensure_dirs
        if [[ -f "$FAVORITES_FILE" ]] && grep -Fxq -- "$path" "$FAVORITES_FILE"; then
            grep -Fxv -- "$path" "$FAVORITES_FILE" > "$FAVORITES_FILE.tmp" || true
        else
            {
                if [[ -f "$FAVORITES_FILE" ]]; then
                    cat "$FAVORITES_FILE"
                fi
                printf '%s\n' "$path"
            } | sort -u > "$FAVORITES_FILE.tmp"
        fi
        mv -f -- "$FAVORITES_FILE.tmp" "$FAVORITES_FILE"
    done
}
workspace_search_roots() {
    local -a candidates=() labels=() paths=()
    local path choice
    load_cache
    candidates=("$HOME/Projects" "$HOME/Documents/Project" "$HOME/source/repos" "$HOME/dev" "$HOME/code")
    for path in "${CACHED_REPOS[@]}"; do
        candidates+=("${path%/*}")
    done
    while IFS= read -r path; do
        [[ -d "$path" && "$path" != / && "$path" != "$HOME" ]] || continue
        local root covered=false
        for root in "${SEARCH_ROOTS[@]}"; do
            if [[ "$path" == "$root" || "$path" == "$root/"* ]]; then
                covered=true
            fi
        done
        [[ "$covered" == false ]] || continue
        paths+=("$path")
        labels+=("Add suggested root  |  $path")
    done < <(printf '%s\n' "${candidates[@]}" | sort -u)
    labels+=('Enter custom directory' 'Back')
    workspace_pick 'Search roots / suggestions' false "${labels[@]}" || return
    choice=${WORKSPACE_SELECTION[0]}
    if ((choice==${#paths[@]}+1)); then
        return
    fi
    if ((choice==${#paths[@]})); then
        read -r -p 'Directory: ' path || return
    else
        path=${paths[choice]}
    fi
    [[ -d "$path" ]] || {
        warn 'Directory not found.'
        return 1
    }
    if confirm "Add search root $path?"; then
        handle_config_edit add search-root "$path"
    fi
}
workspace_menu_cache() {
    local -a labels=('List repositories' 'Refresh cache (scan search roots)' 'Add repository path' 'Recent repositories' 'Favorites' 'Clone repository' 'Search roots' 'Back')
    local path
    while workspace_pick 'Repository cache' false "${labels[@]}"; do
        workspace_clear_screen
        case "${WORKSPACE_SELECTION[0]}" in
            0) handle_cache list;;
            1) if confirm 'Scan configured search roots?'; then
                workspace_run_operation handle_cache refresh
            fi
            ;;
            2) read -r -p 'Repository path (empty cancels): ' path || return 0
            if [[ -n "$path" ]]; then
                handle_cache add "$path"
            fi
            ;;
            3) handle_recent;;
            4) workspace_favorites; continue;;
            5) read -r -p 'Clone URL (empty cancels): ' path || return 0
            if [[ -n "$path" && "$path" != -* ]] && confirm 'Clone repository?'; then
                workspace_run_operation handle_clone "$path"
            fi
            ;;
            6) workspace_search_roots;;
            7) return 0;;
        esac
        workspace_pause
    done
    return 0
}
workspace_menu_update() {
    local -a labels=('Check for updates' 'Install update' 'Restore previous version' 'Back')
    while workspace_pick 'Software update' false "${labels[@]}"; do
        workspace_clear_screen
        case "${WORKSPACE_SELECTION[0]}" in
            0) WORKSPACE_OFFER_UPDATE=true workspace_run_operation handle_update check
            ;;
            1) workspace_run_operation handle_update install
            ;;
            2) workspace_run_operation handle_update rollback
            ;;
            3) return 0;;
        esac
        workspace_pause
    done
    return 0
}
workspace_menu() {
    local -a labels=('Workspace overview' 'Repositories / commit and push' 'Bulk operations' 'Repository cache' 'Development statistics' 'Workspace health' 'Activity history' 'Settings' 'Software update' 'Help / CLI commands' 'Exit')
    if [[ ! -t 0 || ! -t 1 ]]; then
        show_help
        return 0
    fi
    while workspace_pick "GPush $SCRIPT_VERSION / Main menu" false "${labels[@]}"; do
        workspace_clear_screen
        case "${WORKSPACE_SELECTION[0]}" in
            0) visual_command overview;;
            1) if workspace_choose_repo; then
                workspace_menu_repo "$MENU_REPO"
            fi
            ;;
            2) workspace_menu_bulk;;
            3) workspace_menu_cache;;
            4) workspace_stats_screen;;
            5) workspace_health_screen;;
            6) workspace_activity; workspace_pause;;
            7) workspace_settings;;
            8) workspace_menu_update;;
            9) show_help; workspace_pause;;
            10) return 0;;
        esac
    done
    return 0
}

# One history walk per repository; commit markers and numstat share the same stream.
# Activity cache lives only in this GPush process; R forces a fresh history scan.
declare -A GP_STATS_RAW=() GP_STATS_VALID=()
workspace_stats() {
    local period="${1:-30}" show_all="${2:-false}" refresh="${3:-false}" repository line day a d count total=0 added=0 removed=0 max=1 i date_key stamp hidden=0 unavailable=0 name filled width=28 name_width=24 cols=80 heat_days cache_key cache_hit=true
    local tmp='' previous_trap cancelled=false completed=0 pid j batch_end rc fingerprint raw_file git_identity
    local -A stats_files=()
    local -A stats_days=()
    local -a stats_counts=() stats_names=() stats_order=() stats_paths=() stats_pids=() stats_pending=()
    case "$period" in
        7|30|90|365)
        ;;
        *)
            err 'Use gp stats [7|30|90|365].'
            return 2
        ;;
    esac
    : "$refresh"
    load_cache
    stats_paths=("${CACHED_REPOS[@]}")
    ensure_dirs; mkdir -p "$CACHE_DIR/activity"
    git_identity=$(git config --global --get user.name 2>/dev/null || printf unknown)
    for repository in "${stats_paths[@]}"; do
        cache_key="$period|$repository"
        fingerprint=$(git -C "$repository" rev-parse --verify HEAD 2>/dev/null || printf empty)
        raw_file="$CACHE_DIR/activity/$(printf '%s\n' "$repository" "$fingerprint" "$period" "$(date +%F)" | git hash-object --stdin)"
        stats_files[$repository]=$raw_file
        if [[ -f "$raw_file" ]]; then
            GP_STATS_RAW[$cache_key]=$(<"$raw_file")
            GP_STATS_VALID[$cache_key]=0
        elif [[ "$fingerprint" == empty ]]; then
            GP_STATS_RAW[$cache_key]=''
            GP_STATS_VALID[$cache_key]=0
        else
            stats_pending+=("$repository")
            cache_hit=false
        fi
    done
    if (( ${#stats_pending[@]} )); then
        tmp=$(mktemp -d) || return 1
        previous_trap=$(trap -p INT)
        trap 'cancelled=true; for pid in "${stats_pids[@]}"; do kill -TERM "$pid" 2>/dev/null || true; done' INT
        if [[ -t 1 ]]; then
            printf '\r\033[2K%sLoading activity%s  ' "$C_CYAN" "$C_RESET"
            workspace_block_bar 0 24; printf '    0%%'
        fi
        # Bound disk/process pressure: no more than four concurrent history walks.
        for ((i=0;i<${#stats_pending[@]};i+=4)); do
            stats_pids=()
            batch_end=$((i+4))
            if ((batch_end>${#stats_pending[@]})); then
                batch_end=${#stats_pending[@]}
            fi
            for ((j=i;j<batch_end;j++)); do
                if [[ "$cancelled" == true ]]; then
                    break
                fi
                git -C "${stats_pending[j]}" log --no-color --since="$period days ago" --format='@GP:%as' --numstat HEAD > "$tmp/$j" 2> "$tmp/$j.err" &
                stats_pids+=("$!")
            done
            for j in "${!stats_pids[@]}"; do
                pid=${stats_pids[j]}
                rc=0
                wait "$pid" || rc=$?
                if [[ "$cancelled" == true ]]; then
                    break
                fi
                cache_key="$period|${stats_pending[i+j]}"
                GP_STATS_RAW[$cache_key]=$(<"$tmp/$((i+j))")
                GP_STATS_VALID[$cache_key]=$rc
                if ((rc==0)); then
                    cp -- "$tmp/$((i+j))" "${stats_files[${stats_pending[i+j]}]}.tmp.$$" && mv -f -- "${stats_files[${stats_pending[i+j]}]}.tmp.$$" "${stats_files[${stats_pending[i+j]}]}"
                fi
                completed=$((completed+1))
                if [[ -t 1 ]]; then
                    printf '\r\033[2K%sLoading activity%s  ' "$C_CYAN" "$C_RESET"
                    workspace_block_bar "$((completed*24/${#stats_pending[@]}))" 24
                    printf '  %3d%%' "$((completed*100/${#stats_pending[@]}))"
                fi
            done
            if [[ "$cancelled" == true ]]; then
                for pid in "${stats_pids[@]}"; do
                    kill -TERM "$pid" 2>/dev/null || true
                    wait "$pid" 2>/dev/null || true
                done
                break
            fi
        done
        if [[ -n "$previous_trap" ]]; then
            eval "$previous_trap"
        else
            trap - INT
        fi
        rm -rf -- "$tmp"
        if [[ -t 1 ]]; then printf '\r\033[2K'; fi
        if [[ "$cancelled" == true ]]; then
            warn 'Operation cancelled by user.'
            return 130
        fi
    fi
    if [[ -t 1 ]]; then
        cols=$(tput cols 2>/dev/null || printf 80)
        [[ "$cols" =~ ^[0-9]+$ ]] || cols=80
        name_width=$((cols/3))
        ((name_width<=24)) || name_width=24
        ((name_width>=10)) || name_width=10
        width=$((cols-name_width-16))
        ((width<=28)) || width=28
        ((width>=4)) || width=4
    fi
    for repository in "${stats_paths[@]}"; do
        cache_key="$period|$repository"; count=0
        if [[ ${GP_STATS_VALID[$cache_key]:-1} != 0 ]]; then
            unavailable=$((unavailable+1))
            continue
        fi
        while IFS= read -r line; do
            if [[ "$line" =~ ^@GP:([0-9]{4}-[0-9]{2}-[0-9]{2})$ ]]; then
                day=${BASH_REMATCH[1]}
                count=$((count+1))
                stats_days[$day]=$(( ${stats_days[$day]:-0}+1 ))
            elif [[ "$line" =~ ^([0-9]+)$'\t'([0-9]+)$'\t' ]]; then
                a=${BASH_REMATCH[1]}
                d=${BASH_REMATCH[2]}
                added=$((added+a))
                removed=$((removed+d))
            fi
        done <<< "${GP_STATS_RAW[$cache_key]}"
        stats_names+=("${repository##*/}")
        stats_counts+=("$count")
        total=$((total+count))
        if (( count>max )); then
            max=$count
        fi
    done
    info "  GPUSH  /  $SCRIPT_VERSION"
    section "Development activity / $period days"
    dim "  Workspace: $git_identity | All authors (local HEAD histories)"
    printf '  %sCommits%s  %s    %s+%s%s added    %s-%s%s removed\n\n' "$C_CYAN" "$C_RESET" "$total" "$C_GREEN" "$added" "$C_RESET" "$C_RED" "$removed" "$C_RESET"
    printf '  %-*s  %-*s  %s\n' "$name_width" Repository "$width" Activity Commits
    if (( ${#stats_counts[@]} )); then
        mapfile -t stats_order < <(for i in "${!stats_counts[@]}"; do printf '%s %s\n' "${stats_counts[i]}" "$i"; done | sort -k1,1nr -k2,2n)
    fi
    for line in "${stats_order[@]}"; do
        i=${line#* }
        count=${stats_counts[i]}
        name=${stats_names[i]//[[:cntrl:]]/?}
        if (( count==0 )) && [[ "$show_all" != true ]]; then
            hidden=$((hidden+1))
            continue
        fi
        filled=$((count*width/max))
        if (( count>0 && filled==0 )); then
            filled=1
        fi
        printf '  %-*.*s  ' "$name_width" "$name_width" "$name"
        workspace_block_bar "$filled" "$width"
        printf '  %5d\n' "$count"
    done
    if ((hidden>0)); then
        dim "  $hidden inactive repositories hidden"
    fi
    if ((unavailable>0)); then
        warn "  $unavailable repositories could not be inspected."
    fi
    heat_days=$((period<30?period:30))
    if ((heat_days>(cols-3)/3)); then
        heat_days=$(((cols-3)/3))
    fi
    printf '\n  Daily activity (oldest first; last %d days)\n  ' "$heat_days"
    for ((i=heat_days-1;i>=0;i--)); do
        date_key=$(date -d "$i days ago" +%F)
        stamp=${stats_days[$date_key]:-0}
        if [[ -n "$C_GREEN" && -t 1 ]]; then
            if ((stamp==0)); then
                printf '\033[48;5;236m  '
            elif ((stamp<3)); then
                printf '\033[48;5;22m  '
            elif ((stamp<6)); then
                printf '\033[48;5;28m  '
            else
                printf '\033[48;5;40m  '
            fi
            printf '%s ' "$C_RESET"
        else printf '%d ' "$((stamp>9?9:stamp))"; fi
    done
    printf '\n'
    dim '  Low activity -> high activity'
    if [[ "$cache_hit" == true ]]; then
        dim '  Cached local statistics (matching HEAD and calendar date)'
    fi
    return 0
}
workspace_stats_screen() {
    local -a periods=(7 30 90 365)
    local selected=1 show_all=false refresh=false rc=0
    while true; do
        rc=0
        workspace_clear_screen
        workspace_stats "${periods[selected]}" "$show_all" "$refresh" || rc=$?
        refresh=false
        if ((rc==130)); then
            workspace_pause
            return 0
        fi
        dim '  Left/Right  Range    A  Show/hide inactive    R  Refresh    Esc  Back'
        workspace_key
        case "$WORKSPACE_KEY" in
            esc) return 0;;
            left) selected=$(( (selected+3)%4 ));;
            right) selected=$(( (selected+1)%4 ));;
            a|A) if [[ "$show_all" == true ]]; then
                show_all=false
            else
                show_all=true
            fi
            ;;
            r|R) refresh=true;;
            *) continue;;
        esac
    done
}
workspace_block_bar() {
    local filled="$1" width="$2" bar rest
    printf -v bar '%*s' "$filled" ''
    printf -v rest '%*s' "$((width-filled))" ''
    if [[ -n "$C_CYAN" && -t 1 ]]; then
        printf '\033[46m%s\033[48;5;236m%s%s' "$bar" "$rest" "$C_RESET"
    elif [[ "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" == *[Uu][Tt][Ff]* ]]; then
        printf '%s%s' "${bar// /█}" "${rest// /░}"
    else
        printf '%s%s' "${bar// /=}" "${rest// /.}"
    fi
}

visual_command() {
    local action="$1"; shift
    case "$action" in
        overview)
            if [[ ! -t 0 || ! -t 1 ]]; then
                visual_status overview
                return $?
            fi
            local key selected=0 path
            local -a overview_fields=() overview_paths=()
            load_cache
            overview_paths=("${CACHED_REPOS[@]}")
            if (( ${#overview_paths[@]} == 0 )); then
                warn 'Run gp cache refresh first.'
                return 1
            fi
            workspace_clear_screen
            overview_cache_read || overview_load false || return
            while true; do
                overview_frame
                path=${overview_paths[selected]}
                workspace_key; key=$WORKSPACE_KEY
                case "$key" in
                    q|Q|esc) return 0;;
                    up) selected=$(( (selected+${#overview_paths[@]}-1)%${#overview_paths[@]} ))
                    ;;
                    down) selected=$(( (selected+1)%${#overview_paths[@]} ))
                    ;;
                    enter) workspace_menu_repo "$path"
                    overview_refresh_one "$selected"
                    overview_cache_write
                    ;;
                    r|R) overview_load false || true;;
                    a|A) if confirm 'Fetch all cached repositories?'; then
                        overview_load true || true
                    fi
                    ;;
                    f|F) if workspace_run_operation overview_fetch "$path"; then
                        overview_refresh_one "$selected"
                        overview_cache_write
                    else
                        local fetch_rc=$?
                        overview_refresh_one "$selected"
                        if ((fetch_rc==130)); then
                            overview_fields[selected*8+6]="Fetch cancelled"
                        else
                            overview_fields[selected*8+6]="Fetch failed"
                        fi
                        workspace_pause
                    fi;;
                    s|S) if confirm 'Synchronize selected repository (no commit)?'; then
                        local sync_allow=false
                        if confirm 'Allow pushing to protected branches as well?'; then
                            sync_allow=true
                        fi
                        workspace_run_operation bulk_sync "$path" "$sync_allow" ''
                        overview_refresh_one "$selected"
                        overview_cache_write
                        workspace_pause
                    fi;;
                esac
            done ;;
        detail|commit|diff|branches|github) select_repo "${1:-}" || return 1
        "workspace_$action" "$SELECTED"
        ;;
        menu) workspace_menu ;;
        settings) workspace_settings ;;
        activity) workspace_activity ;;
        health) if [[ -t 0 && -t 1 ]]; then
            workspace_health_screen
        else
            visual_status health
        fi
        ;;
        watch) local interval="${1:-10}"
        [[ "$interval" =~ ^[1-9][0-9]*$ ]] || return 2
        [[ -t 1 ]] || {
            visual_status overview
            return
        }
        while true; do
            printf '\033[H\033[2J'
            visual_status overview
            sleep "$interval"
        done
        ;;
        history) if [[ -f "$CONFIG_DIR/history.log" ]]; then
            tail -n 30 "$CONFIG_DIR/history.log"
        else
            dim "No bulk operations recorded yet."
        fi
        ;;
        graph|changes) select_repo "${1:-}" || return 1
            if [[ "$action" == graph ]]; then
                git -C "$SELECTED" log --graph --all --decorate --oneline -n 40 "--color=$(if [[ -n "$C_CYAN" ]]; then printf auto; else printf never; fi)"
            else
                git -C "$SELECTED" status --short
                git -C "$SELECTED" diff --stat HEAD
            fi
            ;;
        stats) workspace_stats "${1:-30}" ;;
    esac
}

main() {
    load_config
    if [[ "${1:-}" == --no-color ]]; then
        shift
        C_RESET='' C_CYAN='' C_GREEN='' C_YELLOW='' C_RED='' C_MAGENTA='' C_GRAY='' C_WHITE=''
    fi
    case "${1:-}" in
        overview|health|watch|stats|history|changes|detail|commit|diff|branches|github|menu|settings|activity) local visual="$1"
        shift
        visual_command "$visual" "$@"
        return $?
        ;;
        branch) if [[ "${2:-}" == graph ]]; then
            shift 2
            visual_command graph "$@"
            return $?
        fi
        ;;
        all) if [[ "${2:-}" == dry-run && $# == 2 ]]; then
            visual_status dry-run
            return $?
        fi
             if [[ "${2:-}" == status && "${3:-}" =~ ^--(json|dirty|ahead|behind)$ && $# == 3 ]]; then
                 visual_status "$3"
                 return $?
             fi
             ;;
    esac

    if [[ $# -eq 0 ]]; then
        workspace_menu
        return $?
    fi

    if [[ "$1" == -* ]]; then
        translate_legacy "$@"
        set -- "${TRANSLATED[@]}"
    fi

    local command_name="$1"
    shift || true

    case "$command_name" in
        help)
            show_help
            ;;
        version)
            printf 'GPush %s\n' "$SCRIPT_VERSION"
            ;;
        config)
            handle_config "$@"
            ;;
        cache)
            handle_cache "$@"
            ;;
        recent)
            handle_recent
            ;;
        project)
            handle_project "$@"
            ;;
        update)
            handle_update "$@"
            ;;
        completion)
            handle_completion "$@"
            ;;
        add|remove|set)
            [[ $# -eq 2 ]] || {
                err "Command 'gp $command_name' requires a configuration key and a value."
                config_edit_usage
                return 2
            }
            handle_config_edit "$command_name" "$1" "$2"
            ;;
        reset)
            [[ $# -eq 1 ]] || {
                err "Command 'gp reset' requires exactly one configuration key."
                config_edit_usage
                return 2
            }
            handle_config_edit reset "$1"
            ;;
        clone)
            handle_clone "$@"
            ;;
        alias)
            handle_alias "$@"
            ;;
        favorite|fav)
            handle_favorite "$@"
            ;;
        favorites)
            handle_favorite list
            ;;
        all)
            handle_all "$@"
            ;;
        repo)
            handle_repo "$@"
            ;;
        branch)
            handle_branch "$@"
            ;;
        remote)
            handle_remote "$@"
            ;;
        stash)
            handle_stash "$@"
            ;;
        tag)
            handle_tag "$@"
            ;;
        *)
            # Keep the classic shortcut: gp Project "message".
            # If the first token is not a known repository and looks like a
            # command typo, fail early with a useful suggestion.
            if ! known_repository_token "$command_name"; then
                local suggestion
                suggestion="$(command_suggestion "$command_name" 2>/dev/null || true)"
                if [[ -n "$suggestion" ]]; then
                    err "Unknown command: $command_name"
                    dim "Did you mean: $suggestion"
                    return 2
                fi
            fi

            select_repo "$command_name" || return 1
            remember_recent "$SELECTED"

            local classic_message="$*"
            classic_commit \
                "$SELECTED" \
                "$classic_message" \
                "${LEGACY_DRY:-false}" \
                "${LEGACY_NOPUSH:-false}"
            ;;
    esac
}

main "$@"
