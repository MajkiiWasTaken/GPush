    screen_title="$title"
    if [[ "$title" == *' / Main menu' ]]; then screen_title='Interactive workspace'; fi
    WORKSPACE_SELECTION=()
    (( ${#rows[@]} )) || return 1
    if [[ -n "$C_CYAN" ]]; then accent=$'\033[1;36m'; highlight=$'\033[30;46m'; fi
    while true; do
        visible=()
        for i in "${!rows[@]}"; do
            if [[ "${rows[i],,}" == *"${query,,}"* ]]; then visible+=("$i"); fi
        done
        if (( selected >= ${#visible[@]} )); then selected=0; fi
        height=$(tput lines 2>/dev/null || printf 24)
        width=$(tput cols 2>/dev/null || printf 80)
        [[ "$height" =~ ^[0-9]+$ ]] || height=24
        [[ "$width" =~ ^[0-9]+$ ]] || width=80
        width=$((width>110?110:width-1)); ((width>=1)) || width=1
        content_width=$((width>6?width-4:1))
        limit=$((height>12?height-12:1))
        repo_column=0
        if [[ "$title" == 'Select repository' ]]; then
            for line in "${rows[@]}"; do
                repo_name=${line%%  |  *}
                if (( ${#repo_name} > repo_column )); then repo_column=${#repo_name}; fi
            done
            left_width=$((content_width*35/100)); (( left_width >= 10 )) || left_width=10
            (( repo_column >= 10 )) || repo_column=10
            if (( repo_column > left_width )); then repo_column=$left_width; fi
        fi
        start=$((selected / limit * limit))
        printf -v bar '%*s' "$width" ''; bar=${bar// /─}
        if [[ "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" != *[Uu][Tt][Ff]* ]]; then bar=${bar//─/-}; fi
        if [[ "$first_frame" == true ]]; then printf '\033[H\033[2J'; first_frame=false; else printf '\033[H'; fi
        printf '\033[2K%s%.*s%s\n' "$accent" "$width" "  GPUSH  /  $SCRIPT_VERSION" "$C_RESET"
        printf '\033[2K%.*s\n' "$width" "  ${screen_title//[[:cntrl:]]/?}"
        printf '\033[2K%s%s%s\n' "$muted" "$bar" "$C_RESET"
        printf '\033[2K%s%.*s%s\n' "$muted" "$width" "  FILTER  ${query:-type to search}    |    ${#visible[@]} / ${#rows[@]}" "$C_RESET"
        if (( repo_column > 0 )); then
            printf -v line '    %-*s  |  Path' "$repo_column" Repository
            printf '\033[2K%s%.*s%s\n' "$muted" "$width" "$line" "$C_RESET"
        else printf '\033[2K\n'; fi
        for ((i=start; i<start+limit && i<${#visible[@]}; i++)); do
            key=${visible[i]}; line=${rows[key]//[[:cntrl:]]/?}
            if (( repo_column > 0 )) && [[ "$line" == *'  |  '* ]]; then
                repo_name=${line%%  |  *}; repo_path=${line#*  |  }
                printf -v line '%-*.*s  |  %s' "$repo_column" "$repo_column" "$repo_name" "$repo_path"
            fi
            if [[ "$multiple" == true ]]; then
                if [[ ${marks[key]:-0} == 1 ]]; then line="[x] $line"; else line="[ ] $line"; fi
            fi
            if [[ "$title" == *' / Main menu' ]] && ((width>=76)); then
                desc=${descriptions[key]:-}; left_width=34
                printf -v line '%-*.*s %s' "$left_width" "$left_width" "$line" "$desc"
            fi
            printf '\033[2K'
            if (( i == selected )); then
                printf '  %s> %-*.*s%s\n' "$highlight" "$content_width" "$content_width" "$line" "$C_RESET"
            else
                printf '    %.*s\n' "$content_width" "$line"
            fi
        done
        if (( ${#visible[@]} == 0 )); then printf '\033[2K  No matching items.\n'; fi
        printf '\033[2K\n\033[2K%s%s%s\n' "$muted" "$bar" "$C_RESET"
        if (( ${#visible[@]} )); then
            line="  POSITION  $((selected+1)) / ${#visible[@]}"
            if [[ "$multiple" == true ]]; then
                marked=0; for key in "${!marks[@]}"; do marked=$((marked+marks[key])); done
                line+="    |    MARKED  $marked"
            fi
            printf '\033[2K%s%.*s%s\n' "$accent" "$width" "$line" "$C_RESET"
        else printf '\033[2K\n'; fi
        printf '\033[2K%s%.*s%s\n' "$muted" "$width" '  Up/Down  Navigate    Enter Select  Esc Back  Ctrl+C Exit' "$C_RESET"
        if [[ "$multiple" == true ]]; then
            printf '\033[2K%s%.*s%s\n' "$muted" "$width" '  Space Mark  A All visible  X Clear  / Search  Enter Confirm' "$C_RESET"
        else
            printf '\033[2K%s%.*s%s\n' "$muted" "$width" '  Type to filter    Backspace  Clear character' "$C_RESET"
        fi
        printf '\033[J'
        workspace_key
        case "$WORKSPACE_KEY" in
            esc) return 1;;
            up) if (( selected > 0 )); then selected=$((selected-1)); fi;;
            down) if (( selected+1 < ${#visible[@]} )); then selected=$((selected+1)); fi;;
            /) read -r -p 'Search (empty resets): ' query || return 1; selected=0;;
            ' ') if [[ "$multiple" == true ]]; then if (( ${#visible[@]} )); then key=${visible[selected]}; marks[key]=$((1-${marks[key]:-0})); fi; else query+=' '; selected=0; fi;;
            a|A) if [[ "$multiple" == true ]]; then for key in "${visible[@]}"; do marks[key]=1; done; else query+="$WORKSPACE_KEY"; selected=0; fi;;
            x|X) if [[ "$multiple" == true ]]; then marks=(); else query+="$WORKSPACE_KEY"; selected=0; fi;;
            enter) if [[ "$multiple" == true ]]; then
                for i in "${!rows[@]}"; do if [[ ${marks[i]:-0} == 1 ]]; then WORKSPACE_SELECTION+=("$i"); fi; done
            elif (( ${#visible[@]} )); then WORKSPACE_SELECTION=("${visible[selected]}"); fi
            if (( ${#WORKSPACE_SELECTION[@]} == 0 && ${#visible[@]} > 0 )); then WORKSPACE_SELECTION=("${visible[selected]}"); fi
            if (( ${#WORKSPACE_SELECTION[@]} )); then return 0; fi;;
            $'\177'|$'\b') query=${query%?}; selected=0;;
            *) if [[ "$multiple" != true && "$WORKSPACE_KEY" == [[:print:]] ]]; then query+="$WORKSPACE_KEY"; selected=0; fi;;
        esac
    done
}
workspace_view_lines() {
    local title="$1"; shift
    local -a content=("$@")
    local offset=0 height page i last
    while true; do
        height=$(tput lines 2>/dev/null || printf 24)
        [[ "$height" =~ ^[0-9]+$ ]] || height=24
        page=$((height>8?height-8:1)); last=$((offset+page))
        if (( last > ${#content[@]} )); then last=${#content[@]}; fi
        printf '\033[H\033[2J'; section "$title"
        for ((i=offset;i<last;i++)); do printf '%s%s\n' "${content[i]}" "$C_RESET"; done
        dim "Lines $((offset+1))-$last / ${#content[@]} | Up/Down: scroll | Esc: back"
        workspace_key
        case "$WORKSPACE_KEY" in
            esc) return 0;;
            up) if ((offset>0)); then offset=$((offset-1)); fi;;
            down) if ((offset+page<${#content[@]})); then offset=$((offset+1)); fi;;
        esac
    done
}
workspace_diff() (
    local path="$1" color=never file temp diff_text part rc flag name
    local -a files=() lines=() staged=() tracked=() untracked=() rows=()
    cd "$path" || return 1
    if [[ -n "$C_CYAN" ]]; then color=always; fi
    if [[ ! -t 0 || ! -t 1 ]]; then
        git --no-pager diff --no-ext-diff --no-textconv "--color=$color" --cached -- || return 1
        git --no-pager diff --no-ext-diff --no-textconv "--color=$color" -- || return 1
        git ls-files --others --exclude-standard
        return
    fi
    temp=$(mktemp) || return 1
    trap 'rm -f -- "$temp"' EXIT
    git diff --cached --no-renames --name-only -z -- > "$temp" || return 1
    mapfile -d '' -t staged < "$temp"
    git diff --no-renames --name-only -z -- > "$temp" || return 1
    mapfile -d '' -t tracked < "$temp"
    git ls-files --others --exclude-standard -z > "$temp" || return 1
    mapfile -d '' -t untracked < "$temp"
    if (( ${#staged[@]} + ${#tracked[@]} + ${#untracked[@]} == 0 )); then ok 'No changes.'; workspace_pause; return 0; fi
    mapfile -d '' -t files < <(printf '%s\0' "${staged[@]}" "${tracked[@]}" "${untracked[@]}" | sort -zu)
    for file in "${files[@]}"; do
        flag=''; for name in "${staged[@]}"; do if [[ "$file" == "$name" ]]; then flag=S; break; fi; done
        for name in "${tracked[@]}"; do if [[ "$file" == "$name" ]]; then flag+=M; break; fi; done
        for name in "${untracked[@]}"; do if [[ "$file" == "$name" ]]; then flag='?'; break; fi; done
        rows+=("[$flag] $file")
    done
    while workspace_pick "Diff / ${path##*/}" false "${rows[@]}"; do
        file=${files[WORKSPACE_SELECTION[0]]}; diff_text=''; flag=''
        for name in "${untracked[@]}"; do if [[ "$file" == "$name" ]]; then flag='?'; break; fi; done
        if [[ "$flag" == '?' ]]; then
            rc=0; diff_text=$(git --no-pager diff --no-index --no-ext-diff --no-textconv "--color=$color" -- /dev/null "./$file") || rc=$?
            if ((rc > 1)); then err 'Cannot read untracked file.'; workspace_pause; continue; fi
        else
            part=$(git --literal-pathspecs --no-pager diff --no-ext-diff --no-textconv "--color=$color" --cached -- "$file") || { err 'Cannot read staged diff.'; workspace_pause; continue; }
            if [[ -n "$part" ]]; then diff_text=$'--- Staged changes ---\n'"$part"$'\n'; fi
            part=$(git --literal-pathspecs --no-pager diff --no-ext-diff --no-textconv "--color=$color" -- "$file") || { err 'Cannot read working tree diff.'; workspace_pause; continue; }
            if [[ -n "$part" ]]; then diff_text+=$'--- Working tree changes ---\n'"$part"; fi
        fi
        mapfile -t lines <<< "${diff_text:-No changes remain in this file. Reopen the diff to refresh.}"
        workspace_view_lines "Diff / ${file//[[:cntrl:]]/?}" "${lines[@]}"
    done
)
workspace_commit() (
    local path="$1" message index file name marker marker_path index_before index_now temp allow=false
    local -a files=() chosen=() untracked=() new_files=() staged=() tracked=() rows=()
    local flag
    cd "$path" || return 1
    [[ -t 0 && -t 1 ]] || { err 'Interactive terminal required.'; return 2; }
    for marker in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD rebase-merge rebase-apply sequencer BISECT_START; do
        marker_path=$(git rev-parse --git-path "$marker") || return 1
        [[ ! -e "$marker_path" ]] || { err 'Git operation in progress.'; return 1; }
    done
    git symbolic-ref --quiet HEAD >/dev/null || return 1
    index_before=$(git write-tree) || return 1
    temp=$(mktemp) || return 1
    trap 'rm -f -- "$temp"' EXIT
    { git diff --no-renames --name-only -z && git diff --cached --no-renames --name-only -z && git ls-files --others --exclude-standard -z; } > "$temp" || return 1
    mapfile -d '' -t files < <(sort -zu "$temp")
    git ls-files --others --exclude-standard -z > "$temp" || return 1
    mapfile -d '' -t untracked < "$temp"
    git diff --cached --no-renames --name-only -z -- > "$temp" || return 1
    mapfile -d '' -t staged < "$temp"
    git diff --no-renames --name-only -z -- > "$temp" || return 1
    mapfile -d '' -t tracked < "$temp"
    (( ${#files[@]} > 0 )) || { ok 'No changes.'; return 0; }
    for file in "${files[@]}"; do
        flag=''; for name in "${staged[@]}"; do if [[ "$file" == "$name" ]]; then flag=S; break; fi; done
        for name in "${tracked[@]}"; do if [[ "$file" == "$name" ]]; then flag+=M; break; fi; done
        for name in "${untracked[@]}"; do if [[ "$file" == "$name" ]]; then flag='?'; break; fi; done
        rows+=("[$flag] $file")
    done
    workspace_pick "Commit manager / ${path##*/}" true "${rows[@]}" || return 0
    for index in "${WORKSPACE_SELECTION[@]}"; do chosen+=("${files[index]}"); done
    for file in "${chosen[@]}"; do
        name=${file##*/}; name=${name,,}
        case "$name" in .env.example|.env.sample|.env.template) ;; .env|.env.*|*.pem|*.key|*.pfx|*.p12|id_rsa|id_ed25519|id_ecdsa|id_dsa|secrets*|credentials*|service-account*.json) err "Risky file: $file"; return 1;; esac
        if [[ -f "$file" ]] && (( $(wc -c < "$file") >= LARGE_FILE_MB * 1048576 )); then err "Large file: $file"; return 1; fi
    done
    section "Selected files (${#chosen[@]})"
    for file in "${chosen[@]}"; do printf '  %s\n' "${file//[[:cntrl:]]/?}"; done
    read -r -p 'Commit message: ' message || return 0
    [[ -n "${message//[[:space:]]/}" ]] || return 0
    confirm 'Commit selected working-tree versions? Other staged files stay staged.' || return 0
    index_now=$(git write-tree) || return 1
    if [[ "$index_now" != "$index_before" ]]; then err 'Staging area changed. Restart commit manager.'; return 1; fi
    for file in "${chosen[@]}"; do
        for name in "${untracked[@]}"; do
            if [[ "$file" == "$name" ]]; then new_files+=("$file"); break; fi
        done
    done
    if (( ${#new_files[@]} )); then git --literal-pathspecs add -- "${new_files[@]}" || return 1; fi
    git --literal-pathspecs commit --only -m "$message" -- "${chosen[@]}" || return 1
    workspace_log commit "$path"
    if confirm 'Push committed changes now (leave other files untouched)?'; then
        if confirm 'Allow pushing to protected branches? (main/master/release)'; then allow=true; fi
        bulk_sync "$path" "$allow" '' true || return 1
        workspace_log push "$path"
    fi
)
workspace_branches() (
    local path="$1" action branch
    local -a branches=()
    while true; do
        section "Branches / ${path##*/}"
        git -C "$path" branch -vv || return 1
        [[ -t 0 && -t 1 ]] || return 0
        dim '[N] New  [S] Switch  [D] Delete merged  [G] Graph  [Q/Esc] Back'
        workspace_key; action=$WORKSPACE_KEY
        case "${action,,}" in
            n|s|d) if [[ "${action,,}" == n ]]; then read -r -p 'Branch name: ' branch || return 0; else
                mapfile -t branches < <(git -C "$path" for-each-ref --format='%(refname:short)' refs/heads)
                workspace_pick 'Select local branch' false "${branches[@]}" || continue
                branch=${branches[WORKSPACE_SELECTION[0]]}
                fi
                git check-ref-format --branch "$branch" >/dev/null 2>&1 || { err 'Invalid branch name.'; continue; }
                [[ "$branch" != -* ]] || continue
                case "${action,,}" in
                    n) if confirm "Create $branch?"; then git -C "$path" switch -c "$branch" && workspace_log branch-new "$path"; fi;;
                    s) if confirm "Switch to $branch?"; then git -C "$path" switch "$branch" && workspace_log branch-switch "$path"; fi;;
                    d) if protected_branch "$branch"; then warn 'Protected branch.'; elif confirm "Delete merged branch $branch?"; then git -C "$path" branch -d -- "$branch" && workspace_log branch-delete "$path"; fi;;
                esac;;
            g) git -C "$path" --no-pager log --graph --all --decorate --oneline -n 40; workspace_pause;;
            q|esc) return 0;;
        esac
    done
)
workspace_github() (
    cd "$1" || return 1
    command -v gh >/dev/null || { err 'Install GitHub CLI (gh) and run gh auth login.'; return 1; }
    gh repo view || return 1
    gh issue list --limit 5; gh pr list --limit 5; gh release list --limit 5; gh run list --limit 5
)
workspace_detail() {
    local path="$1" action
    while true; do
