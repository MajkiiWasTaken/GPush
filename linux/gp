            printf '\033[H\033[2J'; first_frame=false
            previous_width=$width
            previous_height=$height
        else printf '\033[H'; fi
        if [[ "$show_logo" == true ]]; then
            printf '\033[2K\n'
            while IFS= read -r line; do printf '\033[2K%s%s%s\n' "$accent" "$line" "$C_RESET"; done <<'GPUSH_LOGO'
  ###  ####            o
 #     #   #          / \
 #  ## ####      o---o   o
 #   # #          \   \ /
  ###  #           o---o---o
                            \
                             o---o
GPUSH_LOGO
        fi
        printf '\033[2K%s%.*s%s\n' "$accent" "$width" "  GPUSH  /  $SCRIPT_VERSION" "$C_RESET"
        printf '\033[2K%s%.*s%s\n' "$muted" "$width" "  Made by: $AUTHOR" "$C_RESET"
        printf '\033[2K%.*s\n' "$width" "  ${screen_title//[[:cntrl:]]/?}"
        printf '\033[2K%s%s%s\n' "$muted" "$bar" "$C_RESET"
        printf '\033[2K%s%.*s%s\n' "$muted" "$width" "  FILTER  ${query:-type to search}    |    ${#visible[@]} / ${#rows[@]}" "$C_RESET"
        if (( repo_column > 0 )); then
            if [[ "$title" == Settings ]]; then
                printf -v line '    %-*s  |  Value' "$repo_column" Setting
            else
                printf -v line '    %-*s  |  Path' "$repo_column" Repository
