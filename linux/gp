normalize_path() {
    if command -v realpath >/dev/null 2>&1; then
        realpath "$1"
        return
    fi

    (
        cd "$1" 2>/dev/null || exit 1
        pwd -P
    )
}

repo_name() {
    basename "$1"
}

is_ignored() {
    local entry

    for entry in "${IGNORED_DIRS[@]}"; do
        if [[ "$1" == "$entry" ]]; then
            return 0
        fi
    done

    return 1
}

scan_repos() {
    FOUND_REPOS=()
    declare -A seen=()

    local root
    local directory
    local base
    local normalized

    for root in "${SEARCH_ROOTS[@]}"; do
        if [[ ! -d "$root" ]]; then
            warn "Search root does not exist: $root"
            continue
        fi

        while IFS= read -r -d '' directory; do
            base="$(basename "$directory")"

            if is_ignored "$base"; then
                continue
            fi

            if [[ ! -e "$directory/.git" ]]; then
                continue
            fi

            normalized="$(normalize_path "$directory" 2>/dev/null || true)"

            if [[ -n "$normalized" && -z "${seen[$normalized]+x}" ]]; then
                seen[$normalized]=1
                FOUND_REPOS+=("$normalized")
            fi
        done < <(find "$root" -type d -print0 2>/dev/null)
    done

    if [[ ${#FOUND_REPOS[@]} -gt 0 ]]; then
        mapfile -t FOUND_REPOS < <(printf '%s\n' "${FOUND_REPOS[@]}" | sort -u)
    fi
}

save_cache() {
    ensure_dirs
    printf '%s\n' "$@" > "$CACHE_FILE"
}

load_cache() {
    CACHED_REPOS=()

    if [[ ! -f "$CACHE_FILE" ]]; then
        return 0
    fi

    local repository

    while IFS= read -r repository || [[ -n "$repository" ]]; do
        if [[ -d "$repository" && -e "$repository/.git" ]]; then
            CACHED_REPOS+=("$repository")
        fi
    done < "$CACHE_FILE"
}

add_cache() {
    local repository_path="${1/#\~/$HOME}"

    if [[ ! -d "$repository_path" ]]; then
        err "Path does not exist: $repository_path"
        return 1
    fi

    repository_path="$(normalize_path "$repository_path")" || return 1

    if [[ ! -e "$repository_path/.git" ]]; then
        err "Not a Git repository: $repository_path"
        return 1
    fi

    load_cache
    CACHED_REPOS+=("$repository_path")
    mapfile -t CACHED_REPOS < <(printf '%s\n' "${CACHED_REPOS[@]}" | sort -u)
    save_cache "${CACHED_REPOS[@]}"
    ok "Repository added to cache."
}

alias_resolve() {
    local query="$1"

    if [[ ! -f "$ALIASES_FILE" ]]; then
        printf '%s' "$query"
        return
    fi

    local alias_name
    local alias_path

    while IFS='|' read -r alias_name alias_path; do
        if [[ "${alias_name,,}" == "${query,,}" ]]; then
            printf '%s' "$alias_path"
            return
        fi
    done < "$ALIASES_FILE"

    printf '%s' "$query"
}

get_repos() {
    REPOS=()
    load_cache

    if [[ ${#CACHED_REPOS[@]} -gt 0 ]]; then
        REPOS=("${CACHED_REPOS[@]}")
        return
    fi

    scan_repos
    REPOS=("${FOUND_REPOS[@]}")

    if [[ ${#REPOS[@]} -gt 0 ]]; then
        save_cache "${REPOS[@]}"
    fi
}

select_repo() {
    local query
    query="$(alias_resolve "$1")"

    get_repos

    if [[ ${#REPOS[@]} -eq 0 ]]; then
        err "No Git repositories found."
        return 1
    fi

    if [[ -z "$query" ]]; then
        local current_repository
        current_repository="$(git rev-parse --show-toplevel 2>/dev/null || true)"

        if [[ -n "$current_repository" ]]; then
            SELECTED="$current_repository"
            return 0
        fi

        read -r -p "Project: " query
    fi

    local -a exact_matches=()
    local -a prefix_matches=()
    local -a contains_matches=()
    local -a repository_matches=()
    local repository
    local name

    for repository in "${REPOS[@]}"; do
        name="$(repo_name "$repository")"
        if [[ "${name,,}" == "${query,,}" || "${repository,,}" == "${query,,}" ]]; then
            exact_matches+=("$repository")
        fi
    done

    if [[ ${#exact_matches[@]} -eq 1 ]]; then
        SELECTED="${exact_matches[0]}"
        return 0
    fi

    for repository in "${REPOS[@]}"; do
        name="$(repo_name "$repository")"
        if [[ "${name,,}" == "${query,,}"* ]]; then
            prefix_matches+=("$repository")
        fi
    done

    repository_matches=("${prefix_matches[@]}")

    if [[ ${#repository_matches[@]} -eq 0 ]]; then
        for repository in "${REPOS[@]}"; do
            name="$(repo_name "$repository")"
            if [[ "${name,,}" == *"${query,,}"* || "${repository,,}" == *"${query,,}"* ]]; then
                contains_matches+=("$repository")
            fi
        done

        repository_matches=("${contains_matches[@]}")
    fi

    if [[ ${#repository_matches[@]} -eq 1 ]]; then
        SELECTED="${repository_matches[0]}"
        return 0
    fi

    if [[ ${#repository_matches[@]} -eq 0 ]]; then
        err "Repository '$query' not found."
        return 1
    fi

    warn "Multiple repositories found:"

    local index
    for ((index = 0; index < ${#repository_matches[@]}; index++)); do
        printf '  [%d] %s  %s%s%s\n' \
            "$((index + 1))" \
            "$(repo_name "${repository_matches[$index]}")" \
            "$C_GRAY" \
            "${repository_matches[$index]}" \
            "$C_RESET"
    done

    local selection
    while true; do
        read -r -p "Select repository: " selection

        if [[ "$selection" =~ ^[0-9]+$ ]] && \
            ((selection >= 1 && selection <= ${#repository_matches[@]})); then
            SELECTED="${repository_matches[$((selection - 1))]}"
            return 0
        fi
    done
}

remember_recent() {
    ensure_dirs

    local repository_path="$1"
    local temp_file="$RECENT_FILE.tmp"

    {
        printf '%s|%s\n' "$(date -Iseconds)" "$repository_path"

        if [[ -f "$RECENT_FILE" ]]; then
            grep -Fv "|$repository_path" "$RECENT_FILE" | head -n 14 || true
        fi
    } > "$temp_file"

    mv "$temp_file" "$RECENT_FILE"
}

protected_branch() {
    local branch="$1"
    local pattern

    for pattern in "${PROTECTED_BRANCHES[@]}"; do
        case "$branch" in
            $pattern)
                return 0
                ;;
        esac
    done

    return 1
}

current_remote() {
    local -a remote_names=()
    mapfile -t remote_names < <(git remote 2>/dev/null)

    if [[ ${#remote_names[@]} -eq 0 ]]; then
        return 1
    fi

    local remote_name
    for remote_name in "${remote_names[@]}"; do
        if [[ "$remote_name" == "$DEFAULT_REMOTE" ]]; then
            printf '%s' "$remote_name"
            return
        fi
    done

    printf '%s' "${remote_names[0]}"
}

repo_status() {
    local repository_path="$1"

    cd "$repository_path" || return 1

    section "Repository"
    kv Name "$(repo_name "$repository_path")"
    kv Path "$repository_path" "$C_GRAY"

    local branch
    local remote_name
    local upstream
    local counts
    local ahead=0
    local behind=0
    local dirty_count
    local sync_state="Not checked"
    local changes_color="$C_GREEN"

    branch="$(git branch --show-current 2>/dev/null)"
    if [[ -z "$branch" ]]; then
        branch="(detached)"
    fi

    remote_name="$(current_remote 2>/dev/null || true)"
    upstream="$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)"
    dirty_count="$(git status --porcelain | wc -l | tr -d ' ')"

    if [[ -n "$upstream" ]]; then
        counts="$(git rev-list --left-right --count "HEAD...$upstream" 2>/dev/null || true)"
        read -r ahead behind <<< "$counts"

        if [[ "${ahead:-0}" == "0" && "${behind:-0}" == "0" ]]; then
            sync_state="Up to date"
        else
            sync_state="${ahead:-0} ahead / ${behind:-0} behind"
        fi
    fi

    if [[ "$dirty_count" != "0" ]]; then
        changes_color="$C_YELLOW"
    fi

    section "Git"
    kv Branch "$branch" "$C_MAGENTA"
    kv Remote "${remote_name:--}"
    kv Upstream "${upstream:--}"
    kv Sync "$sync_state"
    kv Changes "$dirty_count" "$changes_color"
}

safe_sync() {
    local repository_path="$1"
    local allow_protected="${2:-false}"

    cd "$repository_path" || return 1

    if [[ -n "$(git status --porcelain)" ]]; then
        warn "SKIP dirty: $(repo_name "$repository_path")"
        return 2
    fi

    local branch
    local remote_name
    local upstream
    local counts
    local ahead
    local behind

    branch="$(git branch --show-current)"
    if [[ -z "$branch" ]]; then
        warn "SKIP detached: $(repo_name "$repository_path")"
        return 2
    fi

    remote_name="$(current_remote 2>/dev/null || true)"
    if [[ -z "$remote_name" ]]; then
        warn "SKIP no remote: $(repo_name "$repository_path")"
        return 2
    fi

    git fetch --prune "$remote_name" || return 1
    upstream="$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)"

    if [[ -z "$upstream" ]]; then
        if protected_branch "$branch" && [[ "$allow_protected" != "true" ]]; then
            warn "PROTECTED skip: $(repo_name "$repository_path")/$branch"
            return 2
        fi

        if git push -u "$remote_name" "$branch"; then
            ok "PUSHED $(repo_name "$repository_path")/$branch"
            return 0
        fi

        return 1
    fi

    counts="$(git rev-list --left-right --count "HEAD...$upstream")"
    read -r ahead behind <<< "$counts"

    if ((ahead > 0 && behind > 0)); then
        warn "MANUAL diverged: $(repo_name "$repository_path")"
        return 2
    fi

    if ((behind > 0)); then
        if git merge --ff-only "$upstream"; then
            ok "SYNCED $(repo_name "$repository_path")"
            return 0
        fi

        return 1
    fi

    if ((ahead > 0)); then
        if protected_branch "$branch" && [[ "$allow_protected" != "true" ]]; then
            warn "PROTECTED skip: $(repo_name "$repository_path")/$branch"
            return 2
        fi

        if git push; then
            ok "PUSHED $(repo_name "$repository_path")"
            return 0
        fi

        return 1
    fi

    ok "OK $(repo_name "$repository_path")"
    return 0
}

classic_commit() {
    local repository_path="$1"
    local commit_message="$2"
    local dry_run="${3:-false}"
    local no_push="${4:-false}"

    cd "$repository_path" || return 1

    banner
    repo_status "$repository_path"

    if [[ -z "$(git status --porcelain)" ]]; then
        ok "Nothing to commit."
        return 0
    fi

    if [[ -z "$commit_message" ]]; then
        read -r -p "Commit message: " commit_message
    fi

    if [[ -z "$commit_message" ]]; then
        err "Commit message cannot be empty."
        return 2
    fi

    if [[ "$dry_run" == "true" ]]; then
        section "Dry run"
        info "[ADD] git add -A"
        info "[COMMIT] git commit -m '$commit_message'"

        if [[ "$no_push" == "false" ]]; then
            info "[PUSH] git push"
        fi

        return 0
    fi

    git add -A || return 1
    git commit -m "$commit_message" || return 1

    if [[ "$no_push" == "true" ]]; then
        ok "Done."
        return 0
    fi

    local branch
    local remote_name
    local upstream

    branch="$(git branch --show-current)"
    remote_name="$(current_remote 2>/dev/null || true)"

    if [[ -z "$remote_name" ]]; then
        err "No remote configured."
        return 1
    fi

    git fetch --prune "$remote_name" || return 1
    upstream="$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)"

    if [[ -z "$upstream" ]]; then
        git push -u "$remote_name" "$branch" || return 1
    else
        git pull --rebase || return 1
        git push || return 1
    fi

    ok "Done."
}

translate_legacy() {
