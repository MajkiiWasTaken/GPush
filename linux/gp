    cat > "$target" <<'EOF_COMPLETION'
# GPush Bash completion
# Generated by: gp completion install

_gpush_completion_repo_names() {
    local cache="${XDG_CACHE_HOME:-$HOME/.cache}/gpush/repos"
    local aliases="${XDG_CONFIG_HOME:-$HOME/.config}/gpush/aliases"
    local path name alias_name alias_path
    local -A seen=()

    if [[ -f "$cache" ]]; then
        while IFS= read -r path || [[ -n "$path" ]]; do
            [[ -n "$path" ]] || continue
            name="${path##*/}"
            if [[ -n "$name" && -z "${seen[$name]+x}" ]]; then
                seen[$name]=1
                printf '%s\n' "$name"
            fi
        done < "$cache"
    fi

    if [[ -f "$aliases" ]]; then
        while IFS='|' read -r alias_name alias_path; do
            [[ -n "$alias_name" ]] || continue
            if [[ -z "${seen[$alias_name]+x}" ]]; then
                seen[$alias_name]=1
                printf '%s\n' "$alias_name"
            fi
        done < "$aliases"
    fi
}

_gpush_completion_add_matches() {
    local cur="$1"
    shift || true
    local value
    for value in "$@"; do
        if [[ "${value,,}" == "${cur,,}"* ]]; then
            COMPREPLY+=("$value")
        fi
    done
}

_gpush_complete() {
    COMPREPLY=()
    local cur="${COMP_WORDS[COMP_CWORD]}"
    local command="${COMP_WORDS[1]:-}"
    local action="${COMP_WORDS[2]:-}"
    local -a repos=()
    mapfile -t repos < <(_gpush_completion_repo_names)

    local -a top=(repo branch tag remote stash cache config alias favorite fav favorites all overview health stats history watch changes detail commit diff branches github menu settings activity project clone recent update completion help version add remove set reset)
    local -a config_all=(search-root protected-branch ignored-directory default-remote large-file-threshold)
    local -a config_lists=(search-root protected-branch ignored-directory)
    local -a config_scalars=(default-remote large-file-threshold)

    if (( COMP_CWORD == 1 )); then
        _gpush_completion_add_matches "$cur" "${top[@]}" "${repos[@]}"
        return 0
    fi

    case "$command" in
        project)
            if (( COMP_CWORD == 2 )); then _gpush_completion_add_matches "$cur" info build test run open shell
            elif (( COMP_CWORD == 3 )); then _gpush_completion_add_matches "$cur" "${repos[@]}"; fi
            ;;
        repo)
            if (( COMP_CWORD == 2 )); then _gpush_completion_add_matches "$cur" status diff log open fetch pull sync
            elif (( COMP_CWORD == 3 )); then _gpush_completion_add_matches "$cur" "${repos[@]}"; fi
            ;;
        branch)
            if (( COMP_CWORD == 2 )); then _gpush_completion_add_matches "$cur" list new switch delete prune graph
            elif (( COMP_CWORD >= 3 )); then _gpush_completion_add_matches "$cur" "${repos[@]}"; fi
            ;;
        tag)
            if (( COMP_CWORD == 2 )); then _gpush_completion_add_matches "$cur" list create push delete release
            elif (( COMP_CWORD >= 3 )); then _gpush_completion_add_matches "$cur" "${repos[@]}"; fi
            ;;
        remote)
            if (( COMP_CWORD == 2 )); then _gpush_completion_add_matches "$cur" list add set-url remove
            elif (( COMP_CWORD >= 3 )); then _gpush_completion_add_matches "$cur" "${repos[@]}"; fi
            ;;
        stash)
            if (( COMP_CWORD == 2 )); then _gpush_completion_add_matches "$cur" push list pop
            elif (( COMP_CWORD >= 3 )); then _gpush_completion_add_matches "$cur" "${repos[@]}"; fi
            ;;
        cache)
            if (( COMP_CWORD == 2 )); then _gpush_completion_add_matches "$cur" list refresh add
            elif [[ "$action" == add && $COMP_CWORD -eq 3 ]]; then mapfile -t COMPREPLY < <(compgen -d -- "$cur"); fi
            ;;
        config)
            if (( COMP_CWORD == 2 )); then _gpush_completion_add_matches "$cur" show path doctor add remove set reset
            elif (( COMP_CWORD == 3 )); then
                case "$action" in
                    add) _gpush_completion_add_matches "$cur" "${config_all[@]}" ;;
                    remove) _gpush_completion_add_matches "$cur" "${config_lists[@]}" ;;
                    set) _gpush_completion_add_matches "$cur" "${config_scalars[@]}" ;;
                    reset) _gpush_completion_add_matches "$cur" "${config_all[@]}" ;;
                esac
            fi
            ;;
        add) (( COMP_CWORD == 2 )) && _gpush_completion_add_matches "$cur" "${config_all[@]}" ;;
        remove) (( COMP_CWORD == 2 )) && _gpush_completion_add_matches "$cur" "${config_lists[@]}" ;;
        set) (( COMP_CWORD == 2 )) && _gpush_completion_add_matches "$cur" "${config_scalars[@]}" ;;
        reset) (( COMP_CWORD == 2 )) && _gpush_completion_add_matches "$cur" "${config_all[@]}" ;;
        alias)
            if (( COMP_CWORD == 2 )); then _gpush_completion_add_matches "$cur" list set remove
            elif (( COMP_CWORD >= 3 )); then _gpush_completion_add_matches "$cur" "${repos[@]}"; fi
            ;;
        favorite|fav)
            if (( COMP_CWORD == 2 )); then _gpush_completion_add_matches "$cur" list add remove
            elif (( COMP_CWORD == 3 )); then _gpush_completion_add_matches "$cur" "${repos[@]}"; fi
            ;;
        all) if (( COMP_CWORD == 2 )); then _gpush_completion_add_matches "$cur" status fetch sync push dry-run; elif [[ "$action" == status ]]; then _gpush_completion_add_matches "$cur" --json --dirty --ahead --behind; fi ;;
        changes|detail|commit|diff|branches|github) _gpush_completion_add_matches "$cur" "${repos[@]}" ;;
        update) (( COMP_CWORD == 2 )) && _gpush_completion_add_matches "$cur" check install rollback ;;
        completion) (( COMP_CWORD == 2 )) && _gpush_completion_add_matches "$cur" install status uninstall ;;
        clone)
            if (( COMP_CWORD >= 3 )); then mapfile -t COMPREPLY < <(compgen -d -- "$cur"); fi
            ;;
    esac
}

complete -F _gpush_complete gp
EOF_COMPLETION
}

remove_completion_profile_block() {
    local profile="$1"
    [[ -f "$profile" ]] || return 0
    local tmp="$profile.gpush.tmp"
    awk '
        $0 == "# >>> GPush completion >>>" { skip=1; next }
        $0 == "# <<< GPush completion <<<" { skip=0; next }
        !skip { print }
    ' "$profile" > "$tmp" && mv "$tmp" "$profile"
}

handle_completion() {
    local action="${1:-status}"
    local file profile
    file="$(completion_file_path)"
    profile="$(completion_profile_path)"

    case "$action" in
        install)
            [[ $# -le 1 ]] || { err "Command 'gp completion install' does not accept additional arguments."; return 2; }
            write_completion_file || return 1
            touch "$profile" || return 1
            remove_completion_profile_block "$profile"
            {
                printf '\n# >>> GPush completion >>>\n'
                printf '[[ -f %q ]] && source %q\n' "$file" "$file"
                printf '# <<< GPush completion <<<\n'
            } >> "$profile"
            banner
            section 'Bash completion'
            ok 'GPush Bash completion installed.'
            kv Completion "$file" "$C_GRAY"
            kv Profile "$profile" "$C_GRAY"
            dim "Reload Bash or run: source '$file'"
            ;;
        status)
            [[ $# -le 1 ]] || { err "Command 'gp completion status' does not accept additional arguments."; return 2; }
            banner
            section 'Bash completion'
            if [[ -f "$file" ]] && [[ -f "$profile" ]] && grep -Fq '# >>> GPush completion >>>' "$profile"; then
                kv Health OK "$C_GREEN"
            else
                kv Health 'Needs attention' "$C_YELLOW"
            fi
            kv Completion "$file" "$C_GRAY"
            kv Profile "$profile" "$C_GRAY"
            kv Registered "$(if [[ -f "$profile" ]] && grep -Fq '# >>> GPush completion >>>' "$profile"; then printf Yes; else printf No; fi)"
            ;;
        uninstall)
            [[ $# -le 1 ]] || { err "Command 'gp completion uninstall' does not accept additional arguments."; return 2; }
            rm -f "$file"
            remove_completion_profile_block "$profile"
            banner
            section 'Bash completion'
            ok 'GPush Bash completion removed.'
            dim 'Open a new Bash session to clear the currently loaded completion function.'
            ;;
        *)
            local -a options=(install status uninstall)
            local best='' best_distance=999 candidate distance
            for candidate in "${options[@]}"; do
                distance="$(levenshtein "$action" "$candidate")"
                if (( distance < best_distance )); then best_distance=$distance; best="$candidate"; fi
            done
            err "Unknown completion command: $action"
            (( best_distance <= 2 )) && dim "Did you mean: gp completion $best"
            dim 'Use: gp completion install|status|uninstall'
            return 2
            ;;
    esac
}

# Visual commands use cached repositories and never modify Git history.
visual_snapshot() (
    local repository="$1" branch commit dirty counts ahead=- behind=- state=Unknown upstream remote
    cd "$repository" || return 1
    branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || printf detached)
    commit=$(git log -1 --format=%s 2>/dev/null || printf '-')
    dirty=$(git status --porcelain --untracked-files=all) || return 1
    upstream=$(git rev-parse --symbolic-full-name '@{u}' 2>/dev/null || true)
    if [[ -z "$upstream" ]]; then
        remote=$(git config --get "branch.$branch.remote" || current_remote || true)
        if [[ "$branch" == detached ]]; then state='Detached HEAD'
        elif [[ -z "$remote" ]]; then state='No remote'
        elif [[ "$remote" == . ]]; then state='Local upstream'
        elif git config --get "branch.$branch.merge" >/dev/null; then state='Missing upstream'
        elif git show-ref --verify --quiet "refs/remotes/$remote/$branch"; then upstream="refs/remotes/$remote/$branch"
        else state='New remote branch'; fi
    fi
    if [[ -n "$upstream" ]] && counts=$(git rev-list --left-right --count "HEAD...$upstream" 2>/dev/null); then
        read -r ahead behind <<< "$counts"
        if (( ahead && behind )); then state=Diverged; elif (( ahead )); then state=Ahead; elif (( behind )); then state=Behind; else state='Up to date'; fi
    fi
    printf '%s\0' "${repository##*/}" "$branch" "$commit" "$behind" "$ahead" "$(if [[ -n "$dirty" ]]; then printf '%s' "$(printf '%s\n' "$dirty" | wc -l)"; else printf 0; fi)" "$state" "$repository"
)
visual_rows() {
    local repository
    for repository in "${CACHED_REPOS[@]}"; do visual_snapshot "$repository" || return 1; done
}
visual_bar() {
    local done_count="$1" total="$2" width=20 filled
    filled=$((done_count * width / (total > 0 ? total : 1)))
    printf '%s[' "$C_CYAN"; printf '%*s' "$filled" '' | tr ' ' '#'; printf '%*s' "$((width-filled))" '' | tr ' ' '-'; printf ']%s %s/%s' "$C_RESET" "$done_count" "$total"
}
visual_status() {
    local filter="${1:-}" repository branch commit behind ahead dirty state path n=0 clean=0
    local -a fields=()
    local snapshot_file
    load_cache
    if [[ "$filter" == --json ]]; then
        command -v python3 >/dev/null || { err 'JSON output requires python3.'; return 1; }
        ( set -o pipefail; visual_rows | python3 -c 'import sys,json; a=sys.stdin.buffer.read().split(b"\0")[:-1]; keys=("repository","branch","lastCommit","behind","ahead","dirtyCount","sync","path"); rows=[]
for i in range(0,len(a),8):
 r=dict(zip(keys,[v.decode("utf-8",errors="replace") for v in a[i:i+8]]));
 for k in ("behind","ahead","dirtyCount"): r[k]=int(r[k]) if r[k].isdigit() else None
 rows.append(r)
print(json.dumps(rows,ensure_ascii=False,indent=2))' )
        return $?
    fi
    snapshot_file=$(mktemp) || return 1
    if ! visual_rows > "$snapshot_file"; then rm -f -- "$snapshot_file"; err 'Repository inspection failed.'; return 1; fi
    mapfile -d '' -t fields < "$snapshot_file"
    rm -f -- "$snapshot_file"
    local commit_width=30 repo_width=20 columns=100
    if [[ -t 1 ]]; then columns=$(tput cols 2>/dev/null || printf 100); fi
    [[ "$columns" =~ ^[0-9]+$ ]] || columns=100
    if (( columns < 90 )); then repo_width=14; commit_width=18; fi
    if (( columns < 65 )); then repo_width=10; commit_width=10; fi
    printf '%-*s %-14s %-*s %6s | %-5s %s\n' "$repo_width" Repository Branch "$commit_width" 'Last commit' Behind Ahead 'Worktree / Sync'
    for ((n=0;n+7<${#fields[@]};n+=8)); do
        repository=${fields[n]}; branch=${fields[n+1]}; commit=${fields[n+2]}; behind=${fields[n+3]}; ahead=${fields[n+4]}; dirty=${fields[n+5]}; state=${fields[n+6]}; path=${fields[n+7]}
        case "$filter" in --dirty) (( dirty > 0 )) || continue;; --ahead) if [[ "$ahead" == - ]] || (( ahead <= 0 )); then continue; fi;; --behind) if [[ "$behind" == - ]] || (( behind <= 0 )); then continue; fi;; esac
        printf '%-*.*s %-14.14s %-*.*s %6s | %-5s %s\n' "$repo_width" "$repo_width" "$repository" "$branch" "$commit_width" "$commit_width" "$commit" "$behind" "$ahead" "$dirty changed / $state"
        if [[ "$filter" == dry-run ]]; then
            if (( dirty )); then dim '  SKIP dirty'; elif [[ "$ahead" == - ]]; then dim '  CHECK upstream'; elif (( ahead && behind )); then dim '  SKIP diverged'; elif (( ahead )); then dim '  PUSH candidate (subject to protection)'; elif (( behind )); then dim '  FAST-FORWARD candidate'; else dim '  No action'; fi
        fi
        if [[ "$state" == 'Up to date' && "$dirty" == 0 ]]; then clean=$((clean+1)); fi
        : "$path"
    done
    if [[ "$filter" == overview || "$filter" == health ]]; then
        printf '\nClean and synchronized: '; visual_bar "$clean" "${#CACHED_REPOS[@]}"; printf '\n'
    fi
}
# Overview uses Bash's dynamically scoped local arrays owned by visual_command.
overview_fetch() {
    local path="$1" remote
    remote=$(git -C "$path" config --get "branch.$(git -C "$path" symbolic-ref --quiet --short HEAD 2>/dev/null).remote" 2>/dev/null || (cd "$path" && current_remote)) || { warn "No remote: $path"; return 1; }
    [[ -n "$remote" && "$remote" != . ]] || { warn "No supported remote: $path"; return 1; }
    git -C "$path" fetch --prune "$remote" >/dev/null || return 1
    if [[ "${2:-false}" != true ]]; then ok "Fetched ${path##*/}"; fi
}
overview_refresh_one() {
    local index="$1" path="${overview_paths[$1]}" i
    local -a row=()
    mapfile -d '' -t row < <(visual_snapshot "$path")
    if (( ${#row[@]} != 8 )); then row=("${path##*/}" - - - - - 'Inspection failed' "$path"); fi
    for ((i=0;i<8;i++)); do overview_fields[index*8+i]=${row[i]}; done
}
overview_load() {
    local fetch="$1" i total=${#overview_paths[@]} filled j bar label='Loading local status'
    [[ "$fetch" != true ]] || label='Fetching repositories'
    for ((i=0;i<total;i++)); do
        filled=$((i*24/total)); bar=''
        for ((j=0;j<24;j++)); do if ((j<filled)); then bar+='━'; else bar+='─'; fi; done
        printf '\r\033[2K%s %s%s%s %d/%d  %.30s' "$label" "$C_CYAN" "$bar" "$C_RESET" "$i" "$total" "${overview_paths[i]##*/}"
        local fetch_failed=false
        if [[ "$fetch" == true ]]; then overview_fetch "${overview_paths[i]}" true || fetch_failed=true; fi
        overview_refresh_one "$i"
        if [[ "$fetch_failed" == true ]]; then overview_fields[i*8+6]="Fetch failed"; fi
    done
    printf '\r\033[2K%s %s%s%s %d/%d\n' "$label" "$C_GREEN" '━━━━━━━━━━━━━━━━━━━━━━━━' "$C_RESET" "$total" "$total"
}
overview_frame() {
    local cols lines page first last i n marker rw bw cw clean=0
    cols=$(tput cols 2>/dev/null || printf 100); lines=$(tput lines 2>/dev/null || printf 25)
    [[ "$cols" =~ ^[0-9]+$ ]] || cols=100; [[ "$lines" =~ ^[0-9]+$ ]] || lines=25
    page=$((lines>12?lines-12:1)); first=$((selected-page/2)); ((first>=0)) || first=0
    if ((first+page>${#overview_paths[@]})); then first=$((${#overview_paths[@]}-page)); ((first>=0)) || first=0; fi
    last=$((first+page)); ((last<=${#overview_paths[@]})) || last=${#overview_paths[@]}
    rw=$((cols/4)); ((rw<=24)) || rw=24; ((rw>=8)) || rw=8
    bw=$((cols/6)); ((bw<=18)) || bw=18; ((bw>=8)) || bw=8
    cw=$((cols-rw-bw-32)); ((cw>=8)) || cw=8
    for ((i=0;i<${#overview_paths[@]};i++)); do n=$((i*8)); if [[ "${overview_fields[n+6]}" == 'Up to date' && "${overview_fields[n+5]}" == 0 ]]; then clean=$((clean+1)); fi; done
    printf '\033[H\033[2J'; banner
    printf 'Workspace overview | %d repositories | %d clean and synchronized\n' "${#overview_paths[@]}" "$clean"
    dim 'Local snapshot (F/A fetch remote references; R refresh local status)'
    printf '  %-*s %-*s %-*s %6s | %-5s %s\n' "$rw" Repository "$bw" Branch "$cw" 'Last commit' Behind Ahead Worktree
    for ((i=first;i<last;i++)); do
        n=$((i*8)); marker=' '
        if ((i==selected)); then marker='>'; if [[ -n "$C_CYAN" ]]; then printf '\033[7m'; fi; fi
        printf '%s %-*.*s %-*.*s %-*.*s %6s | %-5s %s changed%s\n' "$marker" "$rw" "$rw" "${overview_fields[n]}" "$bw" "$bw" "${overview_fields[n+1]}" "$cw" "$cw" "${overview_fields[n+2]}" "${overview_fields[n+3]}" "${overview_fields[n+4]}" "${overview_fields[n+5]}" "$C_RESET"
    done
    printf '%d/%d | %s\n' "$((selected+1))" "${#overview_paths[@]}" "${overview_fields[selected*8+6]}"
    dim '[Up/Down] Select  [Enter] Repository menu  [F] Fetch  [A] Fetch all'
    dim '[R] Refresh local  [S] Sync  [Q] Quit'
}

# Shared workspace screens. Read-only views do not fetch.
workspace_pause() {
    if [[ -t 0 && -t 1 ]]; then
        printf '\n'; dim 'Esc  Back    Ctrl+C  Exit'
        while true; do workspace_key; [[ "$WORKSPACE_KEY" != esc ]] || break; done
    fi
