#!/usr/bin/env bash
set -u

SCRIPT_VERSION="4.0.1"
AUTHOR="Michal Švrček"
GITHUB="https://github.com/MajkiiWasTaken"

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
CONFIG_DIR="$CONFIG_HOME/gpush"
CACHE_DIR="$CACHE_HOME/gpush"
CONFIG_FILE="$CONFIG_DIR/config"
ALIASES_FILE="$CONFIG_DIR/aliases"
FAVORITES_FILE="$CONFIG_DIR/favorites"
RECENT_FILE="$CONFIG_DIR/recent"
CACHE_FILE="$CACHE_DIR/repos"

DEFAULT_REMOTE="origin"
LARGE_FILE_MB=25
SEARCH_ROOTS=("$HOME/Projects" "$HOME/Documents")
PROTECTED_BRANCHES=("main" "master" "release/*")
IGNORED_DIRS=(node_modules bin obj .venv venv target packages .idea .vscode .vs)

if [[ -t 1 ]]; then
    C_RESET=$'\033[0m'
    C_CYAN=$'\033[36m'
    C_GREEN=$'\033[32m'
    C_YELLOW=$'\033[33m'
    C_RED=$'\033[31m'
    C_MAGENTA=$'\033[35m'
    C_GRAY=$'\033[90m'
    C_WHITE=$'\033[97m'
else
    C_RESET=""
    C_CYAN=""
    C_GREEN=""
    C_YELLOW=""
    C_RED=""
    C_MAGENTA=""
    C_GRAY=""
    C_WHITE=""
fi

info() {
    printf '%s%s%s\n' "$C_CYAN" "$*" "$C_RESET"
}

ok() {
    printf '%s%s%s\n' "$C_GREEN" "$*" "$C_RESET"
}

warn() {
    printf '%s%s%s\n' "$C_YELLOW" "$*" "$C_RESET"
}

err() {
    printf '%s%s%s\n' "$C_RED" "$*" "$C_RESET" >&2
}

dim() {
    printf '%s%s%s\n' "$C_GRAY" "$*" "$C_RESET"
}

section() {
    printf '\n%s%s%s\n' "$C_CYAN" "$1" "$C_RESET"
}

separator() {
    printf '\n%s----------------------------------------------------%s\n' "$C_GRAY" "$C_RESET"
}

kv() {
    printf '%s  %-12s%s%s%s%s\n' \
        "$C_GRAY" "$1" "$C_RESET" "${3:-$C_WHITE}" "$2" "$C_RESET"
}

banner() {
    printf '\n%sGPush %s%s%s\n' "$C_CYAN" "$C_GRAY" "$SCRIPT_VERSION" "$C_RESET"
    printf '%sMade by %s%s%s%s\n' "$C_GRAY" "$C_RESET" "$C_MAGENTA" "$AUTHOR" "$C_RESET"
    printf '%sGitHub  %s%s\n' "$C_GRAY" "$GITHUB" "$C_RESET"
}

confirm() {
    local answer
    read -r -p "$1 [y/N] " answer
    [[ "$answer" =~ ^([yY]|[yY][eE][sS])$ ]]
}

ensure_dirs() {
    mkdir -p "$CONFIG_DIR" "$CACHE_DIR"
}

load_config() {
    ensure_dirs

    if [[ ! -f "$CONFIG_FILE" ]]; then
        return 0
    fi

    SEARCH_ROOTS=()

    local key=""
    local value=""

    while IFS='=' read -r key value || [[ -n "${key:-}" ]]; do
        if [[ -z "${key:-}" || "$key" =~ ^[[:space:]]*# ]]; then
            continue
        fi

        case "$key" in
            search_root)
                value="${value/#\~/$HOME}"
                SEARCH_ROOTS+=("$value")
                ;;
            default_remote)
                if [[ -n "$value" ]]; then
                    DEFAULT_REMOTE="$value"
                fi
                ;;
            large_file_mb)
                if [[ "$value" =~ ^[0-9]+$ ]]; then
                    LARGE_FILE_MB="$value"
                fi
                ;;
        esac
    done < "$CONFIG_FILE"

    if [[ ${#SEARCH_ROOTS[@]} -eq 0 ]]; then
        SEARCH_ROOTS=("$HOME/Projects" "$HOME/Documents")
    fi
}

