#!/usr/bin/env bash
set -u

SCRIPT_VERSION="4.4.0"
AUTHOR="Michal Švrček"
GITHUB="https://github.com/MajkiiWasTaken"

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
CONFIG_DIR="$CONFIG_HOME/gpush"
CACHE_DIR="$CACHE_HOME/gpush"
CONFIG_FILE="$CONFIG_DIR/config"
ALIASES_FILE="$CONFIG_DIR/aliases"
FAVORITES_FILE="$CONFIG_DIR/favorites"
RECENT_FILE="$CONFIG_DIR/recent"
BACKUP_DIR="$CONFIG_DIR/backups"
CACHE_FILE="$CACHE_DIR/repos"

DEFAULT_REMOTE="origin"
DEFAULT_LARGE_FILE_MB=25
DEFAULT_SEARCH_ROOTS=("$HOME/Projects" "$HOME/Documents")
DEFAULT_PROTECTED_BRANCHES=("main" "master" "release/*")
DEFAULT_IGNORED_DIRS=(node_modules bin obj .venv venv target packages .idea .vscode .vs)

LARGE_FILE_MB="$DEFAULT_LARGE_FILE_MB"
SEARCH_ROOTS=("${DEFAULT_SEARCH_ROOTS[@]}")
PROTECTED_BRANCHES=("${DEFAULT_PROTECTED_BRANCHES[@]}")
IGNORED_DIRS=("${DEFAULT_IGNORED_DIRS[@]}")

if [[ -t 1 ]]; then
    C_RESET=$'\033[0m'
    C_CYAN=$'\033[36m'
    C_GREEN=$'\033[32m'
    C_YELLOW=$'\033[33m'
    C_RED=$'\033[31m'
    C_MAGENTA=$'\033[35m'
    C_GRAY=$'\033[90m'
    C_WHITE=$'\033[97m'
else
    C_RESET=""
    C_CYAN=""
    C_GREEN=""
    C_YELLOW=""
    C_RED=""
    C_MAGENTA=""
    C_GRAY=""
    C_WHITE=""
fi

info() {
    printf '%s%s%s\n' "$C_CYAN" "$*" "$C_RESET"
}

ok() {
    printf '%s%s%s\n' "$C_GREEN" "$*" "$C_RESET"
}

warn() {
    printf '%s%s%s\n' "$C_YELLOW" "$*" "$C_RESET"
}

err() {
    printf '%s%s%s\n' "$C_RED" "$*" "$C_RESET" >&2
}

dim() {
    printf '%s%s%s\n' "$C_GRAY" "$*" "$C_RESET"
}

section() {
    printf '\n%s%s%s\n' "$C_CYAN" "$1" "$C_RESET"
}

separator() {
    printf '\n%s----------------------------------------------------%s\n' "$C_GRAY" "$C_RESET"
}

kv() {
    printf '%s  %-18s%s%s%s%s\n' \
        "$C_GRAY" "$1" "$C_RESET" "${3:-$C_WHITE}" "$2" "$C_RESET"
}

banner() {
    printf '\n%sGPush %s%s%s\n' "$C_CYAN" "$C_GRAY" "$SCRIPT_VERSION" "$C_RESET"
    printf '%sMade by %s%s%s%s\n' "$C_GRAY" "$C_RESET" "$C_MAGENTA" "$AUTHOR" "$C_RESET"
    printf '%sGitHub  %s%s\n' "$C_GRAY" "$GITHUB" "$C_RESET"
}

confirm() {
    local answer
    read -r -p "$1 [y/N] " answer
    [[ "$answer" =~ ^([yY]|[yY][eE][sS])$ ]]
}

confirm_default_yes() {
    local answer
    read -r -p "$1 [Y/n] " answer
    [[ -z "$answer" || "$answer" =~ ^([yY]|[yY][eE][sS])$ ]]
}

ensure_dirs() {
    mkdir -p "$CONFIG_DIR" "$CACHE_DIR"
}

load_config() {
    ensure_dirs

    DEFAULT_REMOTE="origin"
    LARGE_FILE_MB="$DEFAULT_LARGE_FILE_MB"
    SEARCH_ROOTS=()
    PROTECTED_BRANCHES=()
    IGNORED_DIRS=()

    if [[ -f "$CONFIG_FILE" ]]; then
        local key=""
        local value=""

        while IFS='=' read -r key value || [[ -n "${key:-}" ]]; do
            if [[ -z "${key:-}" || "$key" =~ ^[[:space:]]*# ]]; then
                continue
            fi

            case "$key" in
                search_root)
                    value="${value/#\~/$HOME}"
                    SEARCH_ROOTS+=("$value")
                    ;;
                protected_branch)
                    [[ -n "$value" ]] && PROTECTED_BRANCHES+=("$value")
                    ;;
                ignored_directory)
                    [[ -n "$value" ]] && IGNORED_DIRS+=("$value")
                    ;;
                default_remote)
                    [[ -n "$value" ]] && DEFAULT_REMOTE="$value"
                    ;;
                large_file_mb)
                    if [[ "$value" =~ ^[0-9]+$ ]] && (( value > 0 )); then
                        LARGE_FILE_MB="$value"
                    fi
                    ;;
            esac
        done < "$CONFIG_FILE"
    fi

    if [[ ${#SEARCH_ROOTS[@]} -eq 0 ]]; then
        SEARCH_ROOTS=("${DEFAULT_SEARCH_ROOTS[@]}")
    fi

    if [[ ${#PROTECTED_BRANCHES[@]} -eq 0 ]]; then
        PROTECTED_BRANCHES=("${DEFAULT_PROTECTED_BRANCHES[@]}")
    fi

    if [[ ${#IGNORED_DIRS[@]} -eq 0 ]]; then
        IGNORED_DIRS=("${DEFAULT_IGNORED_DIRS[@]}")
    fi
}


