            else
                err '[UPDATE] No matching SHA-256 value; update cancelled.'; rm -rf "$tmp"; return 1
            fi
        else
            err '[UPDATE] Checksum download failed; update cancelled.'; rm -rf "$tmp"; return 1
        fi
    else
