                fi
            ) > "$tmp/$j" 2>/dev/null &
            jobs+=("$!")
        done
        for j in "${!jobs[@]}"; do
            rc=0; wait "${jobs[j]}" || rc=$?
            [[ "$interrupted" != true ]] || break
            row=()
            mapfile -d '' -t row < "$tmp/$((i+j))"
            if ((rc!=0 || ${#row[@]}!=8)); then
                row=("${overview_paths[i+j]##*/}" - - - - - 'Inspection failed' "${overview_paths[i+j]}")
            fi
            fresh+=("${row[@]}")
            completed=$((completed+1))
            if [[ -t 1 ]]; then
                printf '\r\033[2K%s%s%s  ' "$C_CYAN" "$label" "$C_RESET"
                workspace_block_bar "$((completed*24/total))" 24
                printf '  %3d%%' "$((completed*100/total))"
            fi
        done
        [[ "$interrupted" != true ]] || break
    done
    if [[ -n "$previous_trap" ]]; then
        eval "$previous_trap"
    else
        trap - INT
    fi
    rm -rf -- "$tmp"
    if [[ -t 1 ]]; then printf '\r\033[2K'; fi
    if [[ "$interrupted" == true ]]; then
        warn 'Operation cancelled by user.'
        return 130
    fi
    overview_fields=("${fresh[@]}")
