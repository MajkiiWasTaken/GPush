workspace_menu() {
    local -a labels=('Workspace overview' 'Repositories / commit and push' 'Bulk operations' 'Repository cache' 'Development statistics' 'Workspace health' 'Activity history' 'Settings' 'Software update' 'Help / CLI commands' 'Exit')
    if [[ ! -t 0 || ! -t 1 ]]; then show_help; return 0; fi
    while workspace_pick "GPush $SCRIPT_VERSION / Main menu" false "${labels[@]}"; do
        case "${WORKSPACE_SELECTION[0]}" in
            0) visual_command overview;;
            1) if workspace_choose_repo; then workspace_menu_repo "$MENU_REPO"; fi;;
            2) workspace_menu_bulk;;
            3) workspace_menu_cache;;
            4) visual_command stats; workspace_pause;;
            5) visual_command health; workspace_pause;;
            6) workspace_activity; workspace_pause;;
            7) workspace_settings;;
            8) workspace_menu_update;;
            9) show_help; workspace_pause;;
            10) return 0;;
        esac
    done
    return 0
}

visual_command() {
    local action="$1"; shift
    local repository total max=1 count day i date_key stamp added=0 removed=0 a d
    case "$action" in
        overview)
            if [[ ! -t 0 || ! -t 1 ]]; then visual_status overview; return $?; fi
            local key selected=0 path
            local -a overview_fields=() overview_paths=()
            load_cache; overview_paths=("${CACHED_REPOS[@]}")
            if (( ${#overview_paths[@]} == 0 )); then warn 'Run gp cache refresh first.'; return 1; fi
            printf '\033[H\033[2J'; banner
            overview_load false
            while true; do
                overview_frame
                path=${overview_paths[selected]}
                workspace_key; key=$WORKSPACE_KEY
                case "$key" in
                    q|Q|esc) return 0;;
                    up) selected=$(( (selected+${#overview_paths[@]}-1)%${#overview_paths[@]} ));;
                    down) selected=$(( (selected+1)%${#overview_paths[@]} ));;
                    enter) workspace_menu_repo "$path"; overview_refresh_one "$selected";;
                    r|R) overview_load false;;
                    a|A) if confirm 'Fetch all cached repositories?'; then overview_load true; fi;;
                    f|F) if overview_fetch "$path"; then overview_refresh_one "$selected"; else overview_refresh_one "$selected"; overview_fields[selected*8+6]="Fetch failed"; fi;;
                    s|S) if confirm 'Synchronize selected repository (no commit)?'; then
                        local sync_allow=false
                        if confirm 'Allow pushing to protected branches as well?'; then sync_allow=true; fi
                        bulk_sync "$path" "$sync_allow" ''; overview_refresh_one "$selected"; workspace_pause
                    fi;;
                esac
            done ;;
        detail|commit|diff|branches|github) select_repo "${1:-}" || return 1; "workspace_$action" "$SELECTED" ;;
        menu) workspace_menu ;;
        settings) workspace_settings ;;
        activity) workspace_activity ;;
        health) visual_status health ;;
        watch) local interval="${1:-10}"; [[ "$interval" =~ ^[1-9][0-9]*$ ]] || return 2; [[ -t 1 ]] || { visual_status overview; return; }; while true; do printf '\033[H\033[2J'; visual_status overview; sleep "$interval"; done ;;
        history) if [[ -f "$CONFIG_DIR/history.log" ]]; then tail -n 30 "$CONFIG_DIR/history.log"; else dim "No bulk operations recorded yet."; fi ;;
        graph|changes) select_repo "${1:-}" || return 1
            if [[ "$action" == graph ]]; then git -C "$SELECTED" log --graph --all --decorate --oneline -n 40 "--color=$(if [[ -n "$C_CYAN" ]]; then printf auto; else printf never; fi)"
            else git -C "$SELECTED" status --short; git -C "$SELECTED" diff --stat HEAD; fi ;;
        stats)
            load_cache; local -a counts=(); local -A days=(); total=0
            for repository in "${CACHED_REPOS[@]}"; do
                count=$(git -C "$repository" rev-list --count --since='30 days ago' HEAD 2>/dev/null || printf 0); counts+=("$count"); total=$((total+count)); (( count <= max )) || max=$count
                while IFS=$'\t' read -r a d _; do
                    if [[ "$a" =~ ^[0-9]+$ && "$d" =~ ^[0-9]+$ ]]; then added=$((added+a)); removed=$((removed+d)); fi
                done < <(git -C "$repository" log --since='30 days ago' --format= --numstat HEAD 2>/dev/null)
                while IFS= read -r day; do [[ -n "$day" ]] || continue; days[$day]=$(( ${days[$day]:-0}+1 )); done < <(git -C "$repository" log --since='30 days ago' --format=%as HEAD 2>/dev/null)
            done
            section 'Development activity / 30 days'; kv Commits "$total"; kv 'Lines added' "$added"; kv 'Lines removed' "$removed"
            for i in "${!CACHED_REPOS[@]}"; do repository=${CACHED_REPOS[i]}; printf '%-22.22s ' "${repository##*/}"; visual_bar "${counts[i]}" "$max"; printf '\n'; done
            printf '\nDaily activity (oldest first):\n'
            for ((i=29;i>=0;i--)); do date_key=$(date -d "$i days ago" +%F); stamp=${days[$date_key]:-0}; if (( stamp == 0 )); then printf '.'; elif (( stamp < 3 )); then printf 'o'; elif (( stamp < 6 )); then printf 'O'; else printf '#'; fi; done; printf '\n. 0  o 1-2  O 3-5  # 6+ commits\n' ;;
    esac
}

main() {
    load_config
    if [[ "${1:-}" == --no-color ]]; then
        shift; C_RESET='' C_CYAN='' C_GREEN='' C_YELLOW='' C_RED='' C_MAGENTA='' C_GRAY='' C_WHITE=''
    fi
    case "${1:-}" in
        overview|health|watch|stats|history|changes|detail|commit|diff|branches|github|menu|settings|activity) local visual="$1"; shift; visual_command "$visual" "$@"; return $? ;;
        branch) if [[ "${2:-}" == graph ]]; then shift 2; visual_command graph "$@"; return $?; fi ;;
        all) if [[ "${2:-}" == dry-run && $# == 2 ]]; then visual_status dry-run; return $?; fi
             if [[ "${2:-}" == status && "${3:-}" =~ ^--(json|dirty|ahead|behind)$ && $# == 3 ]]; then visual_status "$3"; return $?; fi ;;
    esac

    if [[ $# -eq 0 ]]; then
        workspace_menu
        return $?
    fi

    if [[ "$1" == -* ]]; then
        translate_legacy "$@"
        set -- "${TRANSLATED[@]}"
    fi

    local command_name="$1"
    shift || true

    case "$command_name" in
        help)
            show_help
            ;;
        version)
            printf 'GPush %s\n' "$SCRIPT_VERSION"
            ;;
        config)
            handle_config "$@"
            ;;
        cache)
            handle_cache "$@"
            ;;
        recent)
            handle_recent
            ;;
        project)
            handle_project "$@"
            ;;
        update)
            handle_update "$@"
            ;;
        completion)
            handle_completion "$@"
            ;;
        add|remove|set)
            [[ $# -eq 2 ]] || { err "Command 'gp $command_name' requires a configuration key and a value."; config_edit_usage; return 2; }
            handle_config_edit "$command_name" "$1" "$2"
            ;;
        reset)
            [[ $# -eq 1 ]] || { err "Command 'gp reset' requires exactly one configuration key."; config_edit_usage; return 2; }
            handle_config_edit reset "$1"
            ;;
        clone)
            handle_clone "$@"
            ;;
        alias)
            handle_alias "$@"
            ;;
        favorite|fav)
            handle_favorite "$@"
            ;;
        favorites)
            handle_favorite list
            ;;
        all)
            handle_all "$@"
            ;;
        repo)
            handle_repo "$@"
            ;;
        branch)
            handle_branch "$@"
            ;;
        remote)
            handle_remote "$@"
            ;;
        stash)
            handle_stash "$@"
            ;;
        tag)
            handle_tag "$@"
            ;;
        *)
            # Keep the classic shortcut: gp Project "message".
            # If the first token is not a known repository and looks like a
            # command typo, fail early with a useful suggestion.
            if ! known_repository_token "$command_name"; then
                local suggestion
                suggestion="$(command_suggestion "$command_name" 2>/dev/null || true)"
                if [[ -n "$suggestion" ]]; then
                    err "Unknown command: $command_name"
                    dim "Did you mean: $suggestion"
                    return 2
                fi
            fi

            select_repo "$command_name" || return 1
            remember_recent "$SELECTED"

            local classic_message="$*"
            classic_commit \
                "$SELECTED" \
                "$classic_message" \
                "${LEGACY_DRY:-false}" \
                "${LEGACY_NOPUSH:-false}"
            ;;
    esac
}

main "$@"
