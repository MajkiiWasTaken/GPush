        fi
        printf '\033[2K%s%s%s\n' "$muted" "$bar" "$C_RESET"
        if [[ "$multiple" == true ]]; then
            marked=0
            for key in "${!marks[@]}"; do
                marked=$((marked+marks[key]))
            done
            printf '\033[2K%s%.*s%s\n' "$accent" "$width" "  MARKED  $marked" "$C_RESET"
            printf '\033[2K%s%.*s%s\n' "$muted" "$width" '  Up/Down Navigate  Enter Confirm  Esc Back' "$C_RESET"
            printf '\033[2K%s%.*s%s\n' "$muted" "$width" '  Space Mark  A All  X Clear  / Search' "$C_RESET"
        else
            printf '\033[2K%s%.*s%s\n' "$muted" "$width" '  Up/Down Navigate  Enter Select  Esc Back  Ctrl+C Exit' "$C_RESET"
            printf '\033[2K%s%.*s%s\n' "$muted" "$width" '  Type to filter    Backspace Clear' "$C_RESET"
        fi
        printf '\033[J'
        while true; do
            workspace_key resize
            [[ "$WORKSPACE_KEY" == ignored ]] || break
            # A timeout only triggers a redraw when dimensions actually changed.
            local current_size
            current_size=$(stty size 2>/dev/null || printf '%s %s' "$height" "$((width+1))")
            if [[ "$current_size" != "$height "* ]]; then
                break
            fi
            local current_cols=${current_size##* }
            if [[ "$current_cols" =~ ^[0-9]+$ ]] && (( (current_cols>110?110:current_cols-1) != width )); then
                break
