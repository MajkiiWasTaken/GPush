normalize_config_key() {
    case "${1,,}" in
        search-root|search-roots) printf '%s' 'search-root' ;;
        protected-branch|protected-branches) printf '%s' 'protected-branch' ;;
        ignored-directory|ignored-directories|ignore-directory|ignore) printf '%s' 'ignored-directory' ;;
        default-remote|remote) printf '%s' 'default-remote' ;;
        large-file-threshold|large-file-mb|large-file) printf '%s' 'large-file-threshold' ;;
        *) return 1 ;;
    esac
}

config_edit_usage() {
    dim 'Use:'
    dim '  gp add <key> <value>'
    dim '  gp remove <search-root|protected-branch|ignored-directory> <value>'
    dim '  gp set <default-remote|large-file-threshold> <value>'
    dim '  gp reset <key>'
    dim '  Keys: search-root, protected-branch, ignored-directory, default-remote, large-file-threshold'
    dim '  Full form: gp config add|remove|set|reset ...'
}

config_path_equal() {
    local left="${1/#\~/$HOME}"
    local right="${2/#\~/$HOME}"
    left="${left%/}"
    right="${right%/}"
    [[ "${left,,}" == "${right,,}" ]]
}

array_contains_ci() {
    local wanted="${1,,}"
    shift || true
    local item
    for item in "$@"; do
        [[ "${item,,}" == "$wanted" ]] && return 0
    done
    return 1
}

save_config_settings() {
    ensure_dirs
    local tmp="$CONFIG_FILE.tmp"
    : > "$tmp" || return 1

    printf '# GPush 4.x Linux configuration\n' >> "$tmp"
    printf '# This file is managed by gp config add/remove/set/reset.\n\n' >> "$tmp"

    local item
    for item in "${SEARCH_ROOTS[@]}"; do
        printf 'search_root=%s\n' "$item" >> "$tmp"
    done
    for item in "${PROTECTED_BRANCHES[@]}"; do
        printf 'protected_branch=%s\n' "$item" >> "$tmp"
    done
    for item in "${IGNORED_DIRS[@]}"; do
        printf 'ignored_directory=%s\n' "$item" >> "$tmp"
    done

    printf 'default_remote=%s\n' "$DEFAULT_REMOTE" >> "$tmp"
    printf 'large_file_mb=%s\n' "$LARGE_FILE_MB" >> "$tmp"
    mv "$tmp" "$CONFIG_FILE"
}

handle_config_edit() {
    local action="${1,,}"
    local raw_key="${2:-}"
    local value="${3:-}"
    local key

    key="$(normalize_config_key "$raw_key" 2>/dev/null || true)"
    if [[ -z "$key" ]]; then
        err "Unknown configuration key: $raw_key"
        config_edit_usage
        return 2
    fi

    case "$action" in
        add)
            [[ -n "$value" ]] || { err "Configuration 'add' requires a value."; return 2; }
            if [[ "$key" == default-remote || "$key" == large-file-threshold ]]; then
                action=set
            fi
            ;;
        remove)
            case "$key" in search-root|protected-branch|ignored-directory) ;; *) err "Configuration key '$key' cannot remove an individual value."; dim "Use: gp reset $key"; return 2;; esac
            [[ -n "$value" ]] || { err "Configuration 'remove' requires a value."; return 2; }
            ;;
        set)
            case "$key" in default-remote|large-file-threshold) ;; *) err "Configuration key '$key' does not support 'set'."; dim "Use add/remove for list settings."; return 2;; esac
            [[ -n "$value" ]] || { err "Configuration 'set' requires a value."; return 2; }
            ;;
        reset) ;;
        *) err "Unknown config action: $action"; config_edit_usage; return 2 ;;
    esac

    local -a next=()
    local item found=false

    case "$key" in
        search-root)
            case "$action" in
                add)
                    for item in "${SEARCH_ROOTS[@]}"; do config_path_equal "$item" "$value" && { warn "Search root is already configured: $value"; return 0; }; done
                    SEARCH_ROOTS+=("${value/#\~/$HOME}")
                    ;;
                remove)
                    for item in "${SEARCH_ROOTS[@]}"; do
                        if config_path_equal "$item" "$value"; then found=true; else next+=("$item"); fi
                    done
                    [[ "$found" == true ]] || { err "Search root was not found: $value"; return 1; }
                    (( ${#next[@]} > 0 )) || { err 'Cannot remove the last search root.'; dim 'Add another search root first.'; return 2; }
                    SEARCH_ROOTS=("${next[@]}")
                    ;;
                reset) SEARCH_ROOTS=("${DEFAULT_SEARCH_ROOTS[@]}") ;;
            esac
            ;;
        protected-branch)
            case "$action" in
                add)
                    array_contains_ci "$value" "${PROTECTED_BRANCHES[@]}" && { warn "Protected branch is already configured: $value"; return 0; }
                    PROTECTED_BRANCHES+=("$value")
                    ;;
                remove)
                    next=(); found=false
                    for item in "${PROTECTED_BRANCHES[@]}"; do if [[ "${item,,}" == "${value,,}" ]]; then found=true; else next+=("$item"); fi; done
                    [[ "$found" == true ]] || { err "Protected branch was not found: $value"; return 1; }
                    PROTECTED_BRANCHES=("${next[@]}")
                    ;;
                reset) PROTECTED_BRANCHES=("${DEFAULT_PROTECTED_BRANCHES[@]}") ;;
            esac
            ;;
        ignored-directory)
            case "$action" in
                add)
                    array_contains_ci "$value" "${IGNORED_DIRS[@]}" && { warn "Ignored directory is already configured: $value"; return 0; }
                    IGNORED_DIRS+=("$value")
                    ;;
                remove)
                    next=(); found=false
                    for item in "${IGNORED_DIRS[@]}"; do if [[ "${item,,}" == "${value,,}" ]]; then found=true; else next+=("$item"); fi; done
                    [[ "$found" == true ]] || { err "Ignored directory was not found: $value"; return 1; }
                    IGNORED_DIRS=("${next[@]}")
                    ;;
                reset) IGNORED_DIRS=("${DEFAULT_IGNORED_DIRS[@]}") ;;
            esac
            ;;
        default-remote)
            if [[ "$action" == set ]]; then
                [[ "$value" != *[[:space:]]* ]] || { err 'Remote name cannot contain whitespace.'; return 2; }
                DEFAULT_REMOTE="$value"
            else
                DEFAULT_REMOTE='origin'
            fi
            ;;
        large-file-threshold)
            if [[ "$action" == set ]]; then
                [[ "$value" =~ ^[0-9]+$ ]] && (( value > 0 )) || { err 'Large-file threshold must be a positive integer in MB.'; return 2; }
                LARGE_FILE_MB="$value"
            else
                LARGE_FILE_MB="$DEFAULT_LARGE_FILE_MB"
            fi
            ;;
    esac

    save_config_settings || return 1
    load_config

    banner
    section 'Configuration updated'
    kv Action "$action"
    kv Key "$key"
    [[ -n "$value" && "$action" != reset ]] && kv Value "$value"
    kv Config "$CONFIG_FILE" "$C_GRAY"
}

show_config() {
    banner
    section "Configuration"
    kv Path "$CONFIG_FILE" "$C_GRAY"
    kv Remote "$DEFAULT_REMOTE"
    kv "Large files" "$LARGE_FILE_MB MB"
    section "Search roots"
    printf '  %s\n' "${SEARCH_ROOTS[@]}"
    section "Protected branches"
    printf '  %s\n' "${PROTECTED_BRANCHES[@]}"
    section "Ignored directories"
    printf '  %s\n' "${IGNORED_DIRS[@]}"
}

run_doctor() {
    banner
    section "Doctor"

    if command -v git >/dev/null 2>&1; then
        ok "  [OK] Git"
    else
        err "  [FAIL] Git"
    fi

    if [[ -d "$CONFIG_DIR" ]]; then
        ok "  [OK] Config directory"
    else
        warn "  [WARN] Config directory"
    fi

    local existing_roots=0
    local root

    for root in "${SEARCH_ROOTS[@]}"; do
        if [[ -d "$root" ]]; then
            ((existing_roots += 1))
        fi
    done

    if [[ $existing_roots -gt 0 ]]; then
        ok "  [OK] Search roots: $existing_roots"
    else
        err "  [FAIL] No search roots exist"
    fi
}

handle_config() {
    local action="${1:-show}"
    shift || true

    case "$action" in
        show)
            [[ $# -eq 0 ]] || { err "Command 'gp config show' does not accept arguments."; return 2; }
            show_config
            ;;
        path)
            [[ $# -eq 0 ]] || { err "Command 'gp config path' does not accept arguments."; return 2; }
            printf '%s\n' "$CONFIG_FILE"
            ;;
        doctor)
            [[ $# -eq 0 ]] || { err "Command 'gp config doctor' does not accept arguments."; return 2; }
            run_doctor
            ;;
        add|remove|set)
            [[ $# -eq 2 ]] || { err "Command 'gp config $action' requires a key and a value."; config_edit_usage; return 2; }
            handle_config_edit "$action" "$1" "$2"
            ;;
        reset)
            [[ $# -eq 1 ]] || { err "Command 'gp config reset' requires exactly one key."; config_edit_usage; return 2; }
            handle_config_edit reset "$1"
            ;;
        *)
            err "Unknown config command: $action"
            dim 'Use: gp config show|path|doctor|add|remove|set|reset ...'
            return 2
            ;;
    esac
}


handle_cache() {
    local action="${1:-list}"
    shift || true

    case "$action" in
        list)
            get_repos
            banner
            section "Repositories"

            local repository
            for repository in "${REPOS[@]}"; do
                printf '  %-28s %s%s%s\n' \
                    "$(repo_name "$repository")" \
                    "$C_GRAY" "$repository" "$C_RESET"
            done
            ;;
        refresh)
            scan_repos
            save_cache "${FOUND_REPOS[@]}"
            ok "Found ${#FOUND_REPOS[@]} repositories."
            ;;
        add)
            add_cache "${1:-.}"
            ;;
        *)
            err "Unknown cache command: $action"
            return 2
            ;;
    esac
}

handle_recent() {
    banner
    section "Recent repositories"

    if [[ -f "$RECENT_FILE" ]]; then
        cut -d'|' -f2- "$RECENT_FILE"
    else
        dim "  No recent repositories yet."
    fi
}

handle_clone() {
    local clone_url="${1:-}"
    local destination="${2:-}"

    if [[ -z "$clone_url" ]]; then
        err "Clone requires URL."
        return 2
    fi

    if [[ -z "$destination" ]]; then
        destination="${SEARCH_ROOTS[0]}/$(basename "${clone_url%.git}")"
    fi

    destination="${destination/#\~/$HOME}"

    git clone "$clone_url" "$destination" || return 1
    add_cache "$destination" || return 1
    remember_recent "$destination"
}

handle_alias() {
    local action="${1:-list}"
    shift || true
    ensure_dirs

    case "$action" in
        list)
            banner
            section "Aliases"

            if [[ -s "$ALIASES_FILE" ]]; then
                if command -v column >/dev/null 2>&1; then
                    column -t -s'|' "$ALIASES_FILE"
                else
                    cat "$ALIASES_FILE"
                fi
            else
                dim "  No aliases configured."
            fi
            ;;
        set)
            local alias_name="${1:-}"
            local project="${2:-}"

            if [[ -z "$alias_name" || -z "$project" ]]; then
                err "Use: gp alias set <alias> <project>"
                return 2
            fi

            select_repo "$project" || return 1

            if [[ -f "$ALIASES_FILE" ]]; then
                awk -F'|' -v alias_name="$alias_name" \
                    'tolower($1) != tolower(alias_name)' "$ALIASES_FILE" > "$ALIASES_FILE.tmp"
            else
                : > "$ALIASES_FILE.tmp"
            fi

            printf '%s|%s\n' "$alias_name" "$SELECTED" >> "$ALIASES_FILE.tmp"
            mv "$ALIASES_FILE.tmp" "$ALIASES_FILE"
            ok "Alias '$alias_name' set."
            ;;
        remove)
            local alias_name="${1:-}"

            if [[ ! -f "$ALIASES_FILE" ]]; then
                return 0
            fi

            awk -F'|' -v alias_name="$alias_name" \
                'tolower($1) != tolower(alias_name)' "$ALIASES_FILE" > "$ALIASES_FILE.tmp"
            mv "$ALIASES_FILE.tmp" "$ALIASES_FILE"
            ;;
        *)
            err "Unknown alias command: $action"
            return 2
            ;;
    esac
}

handle_favorite() {
    local action="${1:-list}"
    shift || true
    ensure_dirs

    case "$action" in
        list)
            banner
            section "Favorite repositories"

            if [[ -s "$FAVORITES_FILE" ]]; then
                local favorite_path
                while IFS= read -r favorite_path; do
                    [[ -n "$favorite_path" ]] || continue
                    printf '  %-28s%s%s%s\n' \
                        "$(repo_name "$favorite_path")" \
                        "$C_GRAY" "$favorite_path" "$C_RESET"
                done < "$FAVORITES_FILE"
            else
                dim "  No favorite repositories."
                dim "  Add one with: gp favorite add <project>"
            fi

            printf '\n'
            dim "  Add:     gp favorite add <project>"
            dim "  Remove:  gp favorite remove <project>"
            dim "  Shortcut: gp fav ..."
            ;;
        add)
            select_repo "${1:-}" || return 1

            {
                if [[ -f "$FAVORITES_FILE" ]]; then
                    cat "$FAVORITES_FILE"
                fi
                printf '%s\n' "$SELECTED"
            } | sort -u > "$FAVORITES_FILE.tmp"

            mv "$FAVORITES_FILE.tmp" "$FAVORITES_FILE"
            ok "Added to favorites."
            ;;
        remove)
            select_repo "${1:-}" || return 1

            if [[ -f "$FAVORITES_FILE" ]]; then
                grep -Fvx "$SELECTED" "$FAVORITES_FILE" > "$FAVORITES_FILE.tmp" || true
                mv "$FAVORITES_FILE.tmp" "$FAVORITES_FILE"
            fi
            ;;
        *)
            err "Unknown favorite command: $action"
            return 2
            ;;
    esac
}

handle_all() {
    local action="${1:-status}"
    local allow_protected=false

    if [[ "${2:-}" == "--allow-protected" ]]; then
        allow_protected=true
    fi

    get_repos
    banner
    section "All repositories"

    local repository
    local remote_name

    for repository in "${REPOS[@]}"; do
        case "$action" in
            status)
                printf '\n%s%s%s\n' "$C_WHITE" "$(repo_name "$repository")" "$C_RESET"
                repo_status "$repository"
                ;;
            fetch)
                if ! cd "$repository"; then
                    warn "Fetch failed $(repo_name "$repository")"
                    continue
                fi

                remote_name="$(current_remote 2>/dev/null || true)"

                if [[ -n "$remote_name" ]] && git fetch --prune "$remote_name"; then
                    ok "Fetched $(repo_name "$repository")"
                else
                    warn "Fetch skipped/failed $(repo_name "$repository")"
                fi
                ;;
            sync)
                safe_sync "$repository" "$allow_protected" || true
                ;;
            *)
                err "Unknown all command: $action"
                return 2
                ;;
        esac
    done
}

handle_repo() {
    local action="${1:-status}"
    shift || true

    select_repo "${1:-}" || return 1
    remember_recent "$SELECTED"

    local remote_name

    case "$action" in
        status)
            banner
            repo_status "$SELECTED"
            ;;
        diff)
            cd "$SELECTED" || return 1
            banner
            section "Diff summary"
            git diff --stat
            git diff --cached --stat
            ;;
        log)
            cd "$SELECTED" || return 1
            banner
            section "Recent commits"
            git log --graph --decorate --oneline --all -20
            ;;
        open)
            if command -v xdg-open >/dev/null 2>&1; then
                xdg-open "$SELECTED" >/dev/null 2>&1 &
                disown || true
            else
                err "xdg-open was not found."
                return 1
            fi
            ;;
        fetch)
            cd "$SELECTED" || return 1
            remote_name="$(current_remote)" || return 1
            git fetch --prune "$remote_name"
            ;;
        pull)
            cd "$SELECTED" || return 1

            if [[ -n "$(git status --porcelain)" ]]; then
                err "Working tree must be clean."
                return 1
            fi

            git pull --rebase
            ;;
        sync)
            safe_sync "$SELECTED" false
            ;;
        *)
            err "Unknown repo command: $action"
            return 2
            ;;
    esac
}

handle_branch() {
    local action="${1:-list}"
    shift || true

    local project="${1:-}"
    local branch_name="${2:-}"

    select_repo "$project" || return 1
    cd "$SELECTED" || return 1

    case "$action" in
        list)
            git branch -vv
            git branch -r
            ;;
        new)
            [[ -n "$branch_name" ]] || return 2
            git switch -c "$branch_name"
            ;;
        switch)
            [[ -n "$branch_name" ]] || return 2
            git switch "$branch_name"
            ;;
        delete)
            [[ -n "$branch_name" ]] || return 2

            if protected_branch "$branch_name"; then
                err "Protected branch."
                return 1
            fi

            git branch -d "$branch_name"
            ;;
        prune)
            prune_local_branches
            ;;
        *)
            err "Unknown branch command: $action"
            return 2
            ;;
    esac
}

prune_local_branches() {
    local remote_name
    remote_name="$(current_remote 2>/dev/null || true)"

    if [[ -n "$remote_name" ]]; then
        git fetch --prune "$remote_name" || return 1
    fi

    local current_branch
    current_branch="$(git branch --show-current)"

    local -a gone_branches=()
    local -a safe_branches=()

    mapfile -t gone_branches < <(
        git for-each-ref \
            --format='%(refname:short)|%(upstream:track)' \
            refs/heads |
            awk -F'|' '$2 ~ /\[gone\]/{print $1}'
    )

    local branch_name
    for branch_name in "${gone_branches[@]}"; do
        if [[ "$branch_name" == "$current_branch" ]]; then
            continue
        fi

        if protected_branch "$branch_name"; then
            continue
        fi

        if git merge-base --is-ancestor "$branch_name" HEAD >/dev/null 2>&1; then
            safe_branches+=("$branch_name")
        fi
    done

    if [[ ${#safe_branches[@]} -eq 0 ]]; then
        ok "No safe stale branches."
        return 0
    fi

    printf '  %s\n' "${safe_branches[@]}"

    if ! confirm "Delete these ${#safe_branches[@]} branch(es)?"; then
        return 0
    fi

    for branch_name in "${safe_branches[@]}"; do
        git branch -d "$branch_name"
    done
}

handle_remote() {
    local action="${1:-list}"
    shift || true

    local project="${1:-}"
    local remote_name="${2:-}"
    local remote_url="${3:-}"

    select_repo "$project" || return 1
    cd "$SELECTED" || return 1

    case "$action" in
        list)
            git remote -v
            ;;
        add)
            [[ -n "$remote_name" && -n "$remote_url" ]] || return 2
            git remote add "$remote_name" "$remote_url"
            ;;
        set-url)
            [[ -n "$remote_name" && -n "$remote_url" ]] || return 2

            if confirm "Change remote '$remote_name' URL?"; then
                git remote set-url "$remote_name" "$remote_url"
            fi
            ;;
        remove)
            [[ -n "$remote_name" ]] || return 2

            if confirm "Remove remote '$remote_name'?"; then
                git remote remove "$remote_name"
            fi
            ;;
        *)
            err "Unknown remote command: $action"
            return 2
            ;;
    esac
}

handle_stash() {
    local action="${1:-list}"
    shift || true

    select_repo "${1:-}" || return 1
    cd "$SELECTED" || return 1

    case "$action" in
        push)
            git stash push --include-untracked
            ;;
        list)
            git stash list
            ;;
        pop)
            git stash pop
            ;;
        *)
            err "Unknown stash command: $action"
            return 2
            ;;
    esac
}

handle_tag() {
    local action="${1:-list}"
    shift || true

    local project="${1:-}"
    local tag_name="${2:-}"

    if [[ $# -ge 2 ]]; then
        shift 2
    else
        set --
    fi

    local tag_message="$*"

    select_repo "$project" || return 1
    cd "$SELECTED" || return 1

    local remote_name
    local upstream
    local ahead
    local behind

    case "$action" in
        list)
            git for-each-ref \
                --sort=-creatordate \
                --format='%(refname:short)  %(creatordate:short)  %(subject)' \
                refs/tags
            ;;
        create)
            [[ -n "$tag_name" ]] || return 2

            if [[ -z "$tag_message" ]]; then
                tag_message="Release $tag_name"
            fi

            git tag -a "$tag_name" -m "$tag_message"
            ;;
        push)
            [[ -n "$tag_name" ]] || return 2
            remote_name="$(current_remote)" || return 1
            git push "$remote_name" "refs/tags/$tag_name"
            ;;
        delete)
            [[ -n "$tag_name" ]] || return 2
            git tag -d "$tag_name"
            ;;
        release)
            [[ -n "$tag_name" ]] || return 2

            if [[ -n "$(git status --porcelain)" ]]; then
                err "Release requires clean working tree."
                return 1
            fi

            remote_name="$(current_remote)" || return 1
            git fetch --prune "$remote_name" || return 1

            upstream="$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)"
            if [[ -z "$upstream" ]]; then
                err "Release requires upstream."
                return 1
            fi

            read -r ahead behind <<< "$(git rev-list --left-right --count "HEAD...$upstream")"
            if [[ "$ahead" != "0" || "$behind" != "0" ]]; then
                err "Branch is not exactly synchronized."
                return 1
            fi

            if git show-ref --tags --verify --quiet "refs/tags/$tag_name"; then
                err "Tag already exists."
                return 1
            fi

            if [[ -z "$tag_message" ]]; then
                tag_message="Release $tag_name"
            fi

            if ! confirm "Create and push release tag '$tag_name'?"; then
                return 0
            fi

            if ! git tag -a "$tag_name" -m "$tag_message"; then
                return 1
            fi

            if ! git push "$remote_name" "refs/tags/$tag_name"; then
                git tag -d "$tag_name" >/dev/null 2>&1 || true
                return 1
            fi
            ;;
        *)
            err "Unknown tag command: $action"
            return 2
            ;;
    esac
}


