version_numeric() { local v="${1#v}"; printf '%s' "${v%%-*}"; }
version_gt() { local a b; a="$(version_numeric "$1")"; b="$(version_numeric "$2")"; [[ "$a" == "$b" ]] && return 1; [[ "$(printf '%s\n%s\n' "$a" "$b" | sort -V | tail -n1)" == "$a" ]]; }
latest_release_json() { command -v curl >/dev/null 2>&1 || { err 'curl is required for GPush update.'; return 1; }; curl -fsSL -H "User-Agent: GPush/$SCRIPT_VERSION" -H 'Accept: application/vnd.github+json' 'https://api.github.com/repos/MajkiiWasTaken/GPush/releases/latest'; }
release_field() {
    local json_file="$1" key="$2" extra="${3:-}"
    command -v python3 >/dev/null 2>&1 || { err 'python3 is required to parse GitHub release metadata.'; return 1; }
    python3 - "$json_file" "$key" "$extra" <<'PY_RELEASE'
import json,sys
with open(sys.argv[1],encoding='utf-8') as f: d=json.load(f)
if sys.argv[2]=='tag': print(d.get('tag_name',''))
elif sys.argv[2]=='linux_asset':
    assets=d.get('assets',[])
    cand=[a for a in assets if 'linux' in a.get('name','').lower() and a.get('name','').lower().endswith(('.tar.gz','.zip'))]
    if not cand: cand=[a for a in assets if a.get('name','').lower().endswith(('.tar.gz','.zip')) and 'source' not in a.get('name','').lower()]
    if cand: print(cand[0].get('name','')+'|'+cand[0].get('browser_download_url',''))
elif sys.argv[2]=='checksum':
    assets=d.get('assets',[])
    package=sys.argv[3] if len(sys.argv) > 3 else ''
    wanted=[package+'.sha256', package+'.sha256.txt', 'SHA256SUMS', 'SHA256SUMS.txt', 'sha256sums.txt']
    for wanted_name in wanted:
        for a in assets:
            if a.get('name','').lower()==wanted_name.lower():
                print(a.get('name','')+'|'+a.get('browser_download_url',''))
                raise SystemExit(0)
PY_RELEASE
}
backup_current_gp() {
    mkdir -p "$BACKUP_DIR"
    local current_path backup_path; current_path="$(command -v gp 2>/dev/null || true)"; [[ -n "$current_path" ]] || current_path="${BASH_SOURCE[0]}"
    backup_path="$BACKUP_DIR/v$SCRIPT_VERSION-$(date +%Y%m%d-%H%M%S)"; mkdir -p "$backup_path"; cp "$current_path" "$backup_path/gp"; chmod +x "$backup_path/gp"; printf '%s' "$backup_path"
}
